/* Feinschliff fuer den veroeffentlichten Skin Vereinsheft: Regeln aus dem Bildschirm-Rundgang (30.10.2026).
   Letztes Blatt, gewinnt also jeden Gleichstand. Jeder Selektor nur einmal.
   blatt-05a2930d.png, tisch-c63509b0.png ... setzt heft_test.py --release auf die versionierten Bilder. */

/* Tintenkern für alle Texte: FM malt Vereins- und Spielernamen per Code weiss (<color> im Text, keine USS-Eigenschaft),
   und zwar in fast jedem Textelement. Deshalb trägt jeder Text eine Tintenkontur der Breite 1 (Unity deckelt bei 1).
   Die Figtree-Schnitte sind dafür gedünnt (heft_test.thin_font): ihre Striche liegen ganz in der Kontur, weisse Namen
   drucken in Tinte, und die Kontur gibt das Gewicht. Ausnahmen unten: Heft-Überschriften (Barlow) ohne Kontur, helle
   Schrift auf Farbe mit weisser Kontur, farbige Texte im ungedünnten Schnitt. */
SIText, NavigableLink Label {
}
.body-md, .body-sm, .label-md, .body-large-16px-regular, .body-small-12px-regular, .body-regular-14px-regular,
.body-md-regular, .body-sm-regular, .text-regular, .label-regular, .cell-primary-text, .cell-secondary-text,
.body-regular-12px-regular, .label-small, .tifo-p, .tifo-ph, .tifo-pb, .tifo-ph-m, .tifo-ph-alt, #newsBodyText {
    -unity-font-definition: var(--schrift-heft-dunkel-400);
    -unity-font-style: normal;
}
.body-sm-strong, .body-md-strong, .body-xs-strong, .body-large-16px-bold, .body-regular-14px-bold, .body-small-12px-bold,
.body-regular-12px-bold, .heading-md, .heading-xsmall-14px, .heading-sm, .heading-small-16px, .heading-small-14px,
.tifo-h, .tifo-hp, .portal-messages-header-text {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    -unity-font-style: normal;
}
/* Grosse Überschriften: dickere Striche, die Kante muss breiter sein, sonst bleibt bei Namen ein weisser Kern. */
.heading-lg, .heading-xl, .heading-xxl, .heading-large-22px, .heading-regular-18px, #newsHeadlineText {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    -unity-font-style: normal;
}
/* Kleine Schlagzeilen (News-Seite und Nachrichtenkacheln): kräftiger Schnitt und eine Stufe größer, die Fußzeile darunter
   deutlich zurückgenommen. Sonst lief alles zu einem Brei zusammen (Jonas 05.11.2026). */
#newsHeadlineText.news-tile-header {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    font-size: 16px;
}
.news-item-footer, .news-item-footer SIText {
    font-size: 12px;
}
/* Grosser Name im Seitenkopf (20 px): die Kante muss die ganze Strichstärke decken, sonst bleibt der weisse Kern
   als hohle Schrift sichtbar. Ebenso der Spielerkopf der Transferkarte (Spieler › Transfer, Jonas 03.11.2026). */
.entity-background-header .fm-universe-20px {
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
#PlayerNameAndInfo #Name SIText.fm-universe-20px {
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
/* Graue Texte: Kontur in ihrem Grau. Gelesene Nachrichten deckend grau (SIs Grau ist durchscheinend). */
.global-text-secondary, .secondary-text-colour {
}
/* Gelesene Betreffzeilen im Posteingang: zurückgenommen, aber lesbar (Jonas 04.11.2026: #776F5D war zu blass, auf dem
   abgedunkelten Papier nur noch 2,5:1). SIs Regeln für Gelesenes haben zwei Klassen und setzen Figtree: mit einer
   Klasse verlor der Skin, gelesene Zeilen standen in einer anderen Schrift als ungelesene. Die zuletzt geöffnete
   Nachricht malt SI weiß und sah aus wie ungelesen; sie wird grau wie alle gelesenen (Jonas 04.11.2026). */
.message-last-selected .portal-messages-item-message-text-read,
.message-not-last-selected .portal-messages-item-message-text-read {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    -unity-font-style: normal;
}
/* Kein künstliches Fett: Unity verdickt die gedünnte Schrift sonst rechnerisch, mit Kontur wird sie klobig. Die
   Liste sind SIs Regeln mit -unity-font-style: bold (aus den Stilblättern des Spiels, 31.10.2026), ohne
   Lizenz-/Fernsehgrafiken und ohne Selektoren, die der Skin schon anderswo führt. */
.sitile__text-bold, .sitile__title-tiny, .sitile__button:hover, .match-momentum-chart-y-axis-label,
.match-ratings-chart-y-axis-labels, .league-history-block-x-axis-labels, .league-history-block-y-axis-labels,
.recruitment-budget-charts-x-axis-labels, .recruitment-budget-charts-y-axis-labels, .sitextmedium, .sitextsmall,
.buttongroup.Default .buttongroup__button, .tabgroup.Default .tabgroup__tabs .tabgroup__tab--active .heading-md,
.buttongroup.Default .buttongroup__button--active .heading-md, .heading-xlarge-30px, .heading-small-12px,
.body-xsmall-10px-bold, .tactics-phases-visualiser, .match-simulation-player-10px-bold,
.match-simulation-player-15px-bold, .heading-md .cell-primary-text, .fm-title-text, .kit-name, .kit-number,
.best-xi-position-phone-text, .best-xi-position-text, .default-match-ui-title-micro, .finances-projections-emphasis,
.finances-sponsorships-emphasis, .overview-header-title-micro, .small-player-pin-text, .squad-rewards-row-emphasis,
.var-popup-default-emphasis, .navigation-tab-default-default--active-true .navigation-tab-default-default-text,
.virtualised-list__item--selected .navigation-tab-default-default-text,
.navigation-tab-default-default--active-true.navigation-tab-default-default--active-false .sitext,
.navigation-tab-small-default--active-false .navigation-tab-small-default-text,
.navigation-tab-small-default--active-true .navigation-tab-small-default-text,
.portal-messages-item-message-text-unread, .prematch-lineup-tactics-position-player-name, .progress-timeline-selected,
.startnewcareer-bold-description #description, .stats-header, .tactical-tweak-player-row__shirt-number,
.player-status, .player-status-preview {
    -unity-font-style: normal;
}
/* Dieselben fetten SI-Klassen, die der Skin schon anderswo als Selektor führt: über SIText erreicht. */
SIText.silabel, .silabel SIText, SIText.sitile, .sitile SIText, SIText.grid-element__info-name,
.grid-element__info-name SIText, SIText.grid-element__info-button, .grid-element__info-button SIText,
SIText.siscreentitle, .siscreentitle SIText, SIText.list-popup__item, .list-popup__item SIText, SIText.si-foldout,
.si-foldout SIText, SIText.close-button, .close-button SIText, SIText.sicontainer_vertical_align,
.sicontainer_vertical_align SIText, SIText.si-combobox__preview-element, .si-combobox__preview-element SIText,
SIText.si-combobox__input-field, .si-combobox__input-field SIText, SIText.si-combobox__button, .si-combobox__button
SIText, SIText.sitexttitle, .sitexttitle SIText, SIText.notification-title, .notification-title SIText,
SIText.dialog-card-title, .dialog-card-title SIText, SIText.sicontainer_two_columns_align,
.sicontainer_two_columns_align SIText, SIText.grid-element__controls-button, .grid-element__controls-button SIText,
SIText.active-tactcial-tweak__notification, .active-tactcial-tweak__notification SIText,
SIText.progress-timeline-base, .progress-timeline-base SIText, SIText.radio_group_horizontal_align,
.radio_group_horizontal_align SIText, SIText.tactical-tweak-player-row__active-count,
.tactical-tweak-player-row__active-count SIText {
    -unity-font-style: normal;
}
/* Diagramme zeichnen ihre Beschriftung selbst, ohne Kontur: ungedünnter Schnitt. Punkte in Tinte statt SIs Lila. */
* .silinechart {
    /* SIs Schrift auf dem Diagramm selbst: mit einer Skin-Schriftdatei misst FM die Achsenlabels als leer und blendet
       überlappende nicht aus (Jahreszahlen übereinander, Jonas 10.11.2026). Die Labels tragen Barlow (charts_uss). */
    -unity-font-definition: var(--typography-family-international);
    --datapoint-fill-colour: #E3E1DB;
    --datapoint-stroke-colour: #FDF8ED66;
}
/* Reiter in Kacheln (Feedback, Ziele, Kultur) eine Stufe kleiner als die Rubrikköpfe darüber. */
.buttongroup.Default .buttongroup__button .heading-md, .buttongroup.Default .buttongroup__button .body-md {
    font-size: 15px;
}
/* Aktiver Taktik-Umschalter: FM schreibt hell auf Farbe, Kontur in Weiss. Aktive Segmente (Mit Ball, Dieser Monat):
   ihr Grund kommt mal vom Knopf, mal von einem Kindelement, mal hell, mal dunkel. Schrift deshalb in Tinte, aktiv
   markiert ein Tintenstrich unten wie im Heft (den Rand zeichnet der Knopf selbst, kein Kind deckt ihn). */
.buttons-button-tactics-toggle-default--toggle-true SIText {
}
.buttongroup.SegmentedButtonRow .buttongroup__button--active SIText {
}
.buttongroup.SegmentedButtonRow .buttongroup__button--active {
    border-bottom-width: 2px;
    border-bottom-color: #E3E1DB;
}
/* Ausnahme: Reiter der Taktik (Formationen, Teamanweisungen) sind auch eine Segmentgruppe, liegen aber als Reiter auf
   Papier; aktiv in Tinte. */
.tactical-tweaks-tabs .tactical-tweaks-tab--active-true.buttongroup__button--active SIText {
}
/* Ohne Kontur: alles in der Heftschrift Barlow (SIs Klassen mit --typography-family-thematic/-condensed, aus den
   Stilblättern des Spiels gelesen 31.10.2026; mit Kontur wirkten Tabellenköpfe und Kachelüberschriften klobig),
   dazu Etiketten und Rückennummern. */
.thematic-xs, .thematic-sm, .thematic-md, .thematic-lg, .thematic-xl, .thematic-xxl, .thematic-modal,
.thematic-accent-green, .thematic-accent-grey, .thematic-shirt-number, .condensed-xs-regular, .condensed-sm-regular,
.condensed-sm-strong, .condensed-md-regular, .condensed-md-strong, .condensed-lg-regular, .table-header-xs,
.layout-heading, .player-event-sm, .set-piece-picker, .tactics-picker, .tactics-picker-small,
.tactics-pitch-header-title, .tactics-pitch-rating, .tactics-pitch-role-abbreviation, .match-simulation-team-20px,
.fm-universe-20px, .fm-universe-40px, .fm-universe-56px, .fm-universe-64px, .fm-universe-132px, .fm-universe-240px,
.fm-universe-center-24px, .fm-universe-center-32px, .fm-universe-large-22px, .fm-universe-large-24px,
.fm-universe-large-26px, .fm-universe-regular-18px, .fm-universe-small-14px, .fm-universe-small-center-10px,
.fm-universe-small-center-12px, .fm-universe-small-center-14px, .fm-universe-xlarge-30px,
.fm-universe-extra-small-13px, .ribbon-button-selected-with-text .ribbon-button-content__selected .sitext,
.message-tag-text, .fm-tactics-shirt-number {
}
/* Verlinkte Namen, die SI in der Heftschrift setzt (Wettbewerbstitel im Kopf, Spielernamen der Elf der Woche, Name in der Hoverkarte): FM
   schreibt sie weiss, ohne Kontur blieben sie weiss auf Papier. Dieselbe gedünnte Figtree wie alle Namen. Im Spiel auch
   der Verein über dem Formationsfenster und in der Statistik (fussballromantiker, 01.11.2026). */
.ios-fm-universe-title, .ios-graph-label-font, #PlayerReportHeaderTooltip .fm-universe-regular-18px,
.frame-panel-squad .thematic-md, SIText#FormationView.tile-title-color, SIText#FormationViewPastMatch.tile-title-color,
SIText.cell-primary-text.thematic-md,
SIText.player-event-sm, #NameContainer SIText.thematic-md, VisualElement#Frame.padding-left-global-padding-regular > SIText.thematic-md {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Farbige Texte und Texte auf Plaketten: ohne Kontur, deshalb im ungedünnten Figtree-Schnitt (die Kontur kennt
   ihre Farbe nicht). Attributwerte (#badge-text) setzen darüber die Heftschrift. */
.data_display-string-thematic-accent SIText, .tifo-text-red-20, .tifo-text-communication-feedback-positive, .tifo-text-communication-feedback-negative,
.tifo-text-brand-horizon, .tifo-text-brand-highlight-pink, .tifo-text-women-primary, .tifo-text-men-primary {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Helle Schrift auf Farbe und Tinte: Kontur in Weiss statt aus. Die gedünnte Figtree braucht die Kontur für ihr
   Gewicht; die Heftschrift (Barlow) bleibt über ihre Klassen ohne Kontur. */
.nav-on-dark SIText, .buttons-button-primary-default SIText, .buttons-button-primary-tactics SIText,
.buttons-quick-action-primary SIText, .actions-button-primary SIText,
.startnewcareer_custom_bg_tile SIText, .player-status SIText,
.me-team-sheet-licensed-default > #upper-frame SIText {
}
/* Leiste in Vereinsfarbe: Reiter und Texte hell (bei hellen Vereinsfarben setzt FM .nav-on-light, dort bleibt Tinte);
   das Datum steht auf einem Papieretikett und bleibt Tinte. */
.nav-on-dark SIText.sitext {
}
.nav-on-dark .navigation-primary-nav-calendar-wiget-calendar SIText.sitext {
}
.nav-on-dark .navigation-primary-nav-calendar-wiget-calendar .calendar-widget-time-container SIText.sitext {
}

/* Die Uhr in der Leiste trägt die Link-Klasse, steht aber hell auf Tinte: ohne Tintenkern. */
.calendar-widget-time-container SIText {
    -unity-font-definition: var(--typography-family-thematic);
}

/* Dialoge (Beenden, Hinweise, Einstellungen): SI legt ein Milchglas-Bild mit weisser Tönung darunter, gespiegelt wurde
   daraus ein grauer Schleier. Stattdessen ein Blatt Papier wie die Kacheln. */
.notifications--notifications-modal-dialog-default-default, .notifications-modal-dialog-default-default,
.notifications-modal-large-default-default, .notifications--notifications-modal-large-default-default,
.notifications-modal-dialog-online-default,
.figma-base-card-modal-surface.figma-base-card-template-inner-frame {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
}
:root {
    /* SIs Grundschrift (alle Texte ohne eigene Heftklasse: Knöpfe, Auswahlfelder, Reiter) ebenfalls gedünnte Figtree;
       in SIs eigener Schrift mit Tintenkontur wirkten sie fett. Barlow-Klassen hängen an eigenen Variablen. */
    --typography-family-primary: url("heft-dunkel-400-5295830c.ttf");
    /* Rollenfarben der Taktik eine Stufe dunkler, damit weiße Kürzel überall lesbar sind (Jonas 31.10.2026) */
    --colours-tactics-defender-foreground: #027A70;
    --colours-tactics-defensive-midfield-foreground: #0E8046;
    --colours-tactics-midfield-foreground: #4A82C6;
    --colours-tactics-attacking-midfield-foreground: #9A5EBB;
    --colours-tactics-striker-foreground: #C04A95;
    --colours-tactics-goalkeeper-foreground: #77778F;
    --layout-surfaces-modal-surface: #201E19;
    --layout-surfaces-modules-modal: #201E19;
    --modal-text-primary: #E3E1DB;
}

/* Hinter Dialogen (Einstellungen, Speichern, Laden …): SIs Abdunkelung war Nachtblau, die Karte hatte einen zweiten
   blauen Rahmen. Tinte statt Blau, kräftig genug, dass der Dialog vorn liegt (Jonas 31.10.2026). Weichzeichnen kann
   USS nicht (kein Filter auf das, was hinter einem Element liegt). Hell wie dunkel gleich. */
.sipopup-container {
    background-color: #0E0D0BA6; /* fest */
}
.sicard-container-large {
    background-color: #0E0D0BA6; /* fest */
    border-width: 0;
}

/* Seitenköpfe von Spieler, Verein, Wettbewerb: SI malt per Code einen Verlauf in Vereinsfarben. Vereinsfarbe gehört
   nur in die Leiste (Heftregel); darüber liegt der Tisch, eine Tintenlinie trennt den Kopf vom Blatt. */
.entity-background-header > .sigradient > * {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
    border-bottom-width: 1px;
    border-bottom-color: #FDF8ED26;
}

/* Spielerkopf in Transfer- und Leihangeboten (Posteingang): derselbe Kopf liegt dort im Nachrichtenblatt, das Holz
   schien als Streifen durch (Jonas 01.11.2026). Dort ein heller Kasten mit Haarlinie. */
#FramePlayerHeader {
    background-color: #1C1A160A; /* fest */
    border-width: 1px;
    border-color: #FDF8ED26;
}
#FramePlayerHeader > .sigradient > * {
    background-image: var(--bild-leer);
    border-bottom-width: 0;
}

/* Kopf des Datencenters (TeamReportHeader, laut FM-UI-Atlas die einzige Vorlage mit #LogoFrame und #ContentFrame im
   Seitenkopf): Wappen, Name und Kennzahlen auf einem Blatt. Vorher je eine Karte für Wappen und Inhalt; die
   Wappenkarte war durch SIs feste Höhe länger als der Kopf, und in den Rändern schien SIs Vereinsverlauf durch (Jonas
   03.11.2026). Jetzt trägt der Verlauf selbst das Blatt, seine Farben sind durchsichtig, die beiden Rahmen leer. */
.align-self-stretch-class.base-template-grow.entity-background-header > .sigradient {
    --start-colour: #00000000;
    --end-colour: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin: 10px 16px 6px 16px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.align-self-stretch-class.base-template-grow.entity-background-header > .sigradient > * {
    background-image: var(--bild-leer);
    border-bottom-width: 0;
    margin: 0;
}
.align-self-stretch-class.base-template-grow.entity-background-header > .sigradient > #ContentFrame {
    padding: 4px 10px 10px 4px;
}
.align-self-stretch-class.base-template-grow.entity-background-header {
    background-color: #00000000;
    border-bottom-width: 0;
}
/* Spielerkopf in Nachrichten (z. B. „Scouting abgeschlossen“, Rückmeldung 03.11.2026): der Seitenkopf trug dort den
   Tisch, Name und Kennzahlen standen grau auf Holz, am Rand schien der Vereinsverlauf durch. Wie bei Transferangeboten
   ein heller Kasten mit Haarlinie im Nachrichtenblatt. */
.dynamic-portal-message-grid .entity-background-header > .sigradient {
    --start-colour: #00000000;
    --end-colour: #00000000;
}
.dynamic-portal-message-grid .entity-background-header > .sigradient > * {
    background-image: var(--bild-leer);
    background-color: #1C1A160A; /* fest */
    border-width: 1px;
    border-color: #FDF8ED26;
}
.dynamic-portal-message-grid .report-player-full-header-max-type-player {
    background-image: var(--bild-leer);
    translate: 0 0;
    margin: 0;
}
/* Spielerkopf über dem Scoutbericht in der Kartenansicht (Kaderplanung › Scouting › Karten, Jonas 04.11.2026): er lag
   über die Seitenkopf-Regel auf einem Holzstreifen, links SIs Vereinsverlauf. Eine eigene Karte wie im Scoutbericht,
   der Verlauf unsichtbar. */
TemplateContainer#PlayerInfo > BindingExpect.entity-background-header {
    background-color: rgba(0, 0, 0, 0);
}
TemplateContainer#PlayerInfo > .entity-background-header > SIGradient.sigradient {
    visibility: hidden;
}
TemplateContainer#PlayerInfo > .entity-background-header > SIGradient.sigradient > * {
    visibility: visible;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-bottom-width: 0;
}
/* Fußleiste der Transferverhandlung (Rückgängig, Zurücksetzen, Kosten; Jonas 04.11.2026): sie trägt die Klasse des
   Seitenkopfs und bekam darüber den Tisch, dazu SIs Verlauf als lila Rand; die Texte standen dunkel auf Holz. Flach
   auf dem Blatt mit Haarlinie oben, der Verlauf unsichtbar (FM setzt seine Farben per Code). */
VisualElement#ContainerActions.entity-background-header {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-top-width: 1px;
    border-color: #FDF8ED26;
}
VisualElement#ContainerActions.entity-background-header > SIGradient.sigradient {
    visibility: hidden;
}
VisualElement#ContainerActions.entity-background-header > SIGradient.sigradient > * {
    visibility: visible;
    background-image: var(--bild-leer);
    border-bottom-width: 0;
}
/* Scoutbericht (Spieler › Berichte): der Kopf hat kein #ContentFrame, Name und Kennzahlen lagen frei auf dem Tisch,
   ebenso die Empfehlungszeile darunter (Bericht „scheint durch“, 03.11.2026). Je eine Karte. */
#PlayerInfoBlock .entity-background-header > .sigradient > *,
#OverallRecommendation #overall-recommendation {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-bottom-width: 0;
}

/* Vereinsinfo und Spieler-Hoverkarte: SI legt den Kopf (Name, Liga, Ansehen) auf einen Vereinsverlauf (.club-info-header, per Code
   gefärbt, trägt den Inhalt und lässt sich nicht ausblenden). Papier darüber, eine Haarlinie darunter; der Name
   ist ein weisser Link und druckt dann in Tinte. */
.club-info-header > VisualElement, #PlayerReportHeaderTooltip .sigradient > VisualElement {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-bottom-width: 1px;
    border-bottom-color: #FDF8ED26;
}

/* Datum und Uhr in der Leiste: ein Papieretikett auf der Vereinsleiste, die Uhr als Tintenfeld darin. SI setzt
   die Uhrschrift fest auf Schwarz; seine Regeln hängen an .nav-on-dark, deshalb hier dieselbe Tiefe. */
.nav-on-dark .navigation-primary-nav-calendar-wiget-calendar {
    background-color: #1C1A16F2;
}
.nav-on-dark .navigation-primary-nav-calendar-wiget-calendar:hover {
    background-color: #1D1B17;
}
.nav-on-dark .calendar-widget-time-container {
    background-color: #E3E1DB;
}
.nav-on-dark .calendar-widget-time-container .global-text-primary {
}

/* Aufklappmenüs (Zahnrad, Reiter, Dropdowns): Papier statt grauer Fläche. Das Blatt mit Schattenrand ließ in seinem
   durchsichtigen Rand eine helle Fläche durchscheinen, eine blasse Platte links und unten (Jonas 02.11.2026). Daher
   Papier ohne Rand, eine feine Tintenkante statt Schatten; SIs Rahmen (1,3 px Weiß mit 20 %) wird zu dieser Kante. Mit Typ
   davor, damit die Regel sicher vor gleich starken älteren Blättern liegt. */
FocusContentContainer.floating-element, .floating-element {
    background-color: #00000000;
    border-color: #1C1A1640; /* fest */
    border-width: 1px;
    border-radius: 0;
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
}
/* Aufklappmenüs als Papierstück (Jonas 02.11.2026): das Blatt liegt auf der Liste darin, nicht auf dem Behälter. Auf
   dem Behälter (Blatt, auch ohne Innenabstand) öffneten die Klappfelder „Zurufe“ und „Anpassungen“ im Spiel oberhalb
   des Bildschirms; sie tragen ihr eigenes Blatt (.tactical-tweaks-panel). */
.floating-element BindingRoot.si-dropdown__binding-root {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Hinter dem Blatt stand der flache Behälter als Kasten (Jonas 02.11.2026). Das Blatt ragt um seinen Rand über den
   Behälter hinaus (Innenabstand gleicht aus) und deckt ihn; der Behälter schneidet es dafür nicht mehr ab. */
FocusContentContainer.floating-element > BindingRoot.si-dropdown__binding-root {
    margin: -10px;
    padding: 10px;
}
FocusContentContainer.floating-element {
    overflow: visible;
}
/* Kontextmenüs mit Untermenüs (z. B. Rechtsklick auf einen Spaltenkopf, Jonas 04.11.2026): eckiger Kasten statt Blatt,
   die Einträge sind Labels (keine SITexts) im gedünnten Schnitt ohne Tintenkern und standen dünn und grau, die Pfeile
   weiß. Jede Menüebene ein Blatt wie die Aufklappmenüs, Einträge mit Tintenkern, Pfeile und Haken in Tinte. */
FocusContentContainer.floating-element FolderView.cascading-menu__folder {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    margin: -10px;
    padding: 10px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.cascading-menu__folder__entry Label.sitext {
}
.cascading-menu__folder__entry VisualElement#RightIndicatorSection,
.cascading-menu__folder__entry VisualElement#LeftIndicatorSection {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}
.unity-base-dropdown__separator {
    background-color: #1C1A1626; /* fest */
}

/* Gut/schlecht-Farben: die Spiegelung machte Gelb und Hellgrün beide fast schwarz. Stattdessen die Heftfarben
   (theme/app-theme.css hell: elite, good, weak, poor). */
.very-positive-text-colour {
}
.positive-text-colour {
}
.negative-text-colour {
}
.very-negative-text-colour {
}
.siscatterchart {
    --positive-text-colour: #2CBF5B;
    --neutral-text-colour: #E38B00;
    --negative-text-colour: #E69489;
}
/* Ampelkreise (taktische Effektivität und andere Wertkreise): FM wählt je Wert eine von sieben Farbklassen. Gespiegelt
   wurden Gelbgrün, Gelb und Grün fast gleich dunkel, alle Kreise sahen grün aus (Community, 31.10.2026). Feste,
   klar getrennte Ampelfarben, hell wie dunkel. */
.siradialgauge-siradialgauge-red {
    --current-colour: #C8372D; /* fest */
}
.siradialgauge-siradialgauge-red_orange {
    --current-colour: #D45A2A; /* fest */
}
.siradialgauge-siradialgauge-orange {
    --current-colour: #E07F2C; /* fest */
}
.siradialgauge-siradialgauge-yellow_orange {
    --current-colour: #E3A12F; /* fest */
}
.siradialgauge-siradialgauge-yellow {
    --current-colour: #D8BD2C; /* fest */
}
.siradialgauge-siradialgauge-yellow_green {
    --current-colour: #9CB83A; /* fest */
}
.siradialgauge-siradialgauge-green {
    --current-colour: #4E9E3F; /* fest */
}
.siradialgauge-siradialgauge-dark_green {
    --current-colour: #1F7A42; /* fest */
}

/* SIs Grundverlauf (.sigradient, z. B. hinter Trainingseinheiten) war Hellgrau auf dunklem Grund; gespiegelt wurde er
   dunkelgrau und schluckte die Tintenschrift. Auf Papier nur ein Hauch Tinte. */
.sigradient {
    --start-colour: #FDF8ED14;
    --end-colour: #1C1A1600;
}


/* Hinweise beim ersten Besuch einer Seite (Tutorial-Popup): SIs Verlauf in Nachtblau, darauf dunkle Schrift.
   Papierverlauf wie ein Notizzettel. */
.sigradient.base-component-tutorial-background {
    --start-colour: #201E19;
    --end-colour: #2F2612;
    border-width: 1px;
    border-color: #FDF8ED26;
}
/* ... und darüber SIs gemustertes Nachtbild: unsichtbar getönt. */
.tutorial-background {
    --unity-image-tint-color: #00000000;
}


/* Kopf eines Nachrichtenartikels: SI legt Vereinsbild, Vereinsverlauf und 60 % Schwarz übereinander, darauf stand
   die Tintenüberschrift unlesbar. Stattdessen Papier mit Tintenlinie, das Wappen bleibt. */
.news-story-header {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-bottom-width: 2px;
    border-bottom-color: #E3E1DB;
}
.news-story-header .sigradient, .news-story-header .overlay-black-60 {
    display: none;
}
.news-story-header #DynamicBackgroundImage_Club, .news-story-header #DynamicBackgroundImage_Comp,
.news-story-header #DynamicBackgroundImage_Nation, .news-story-header #DynamicBackgroundImage,
.news-story-header #DynamicBackgroundImage_NONE, .news-story-header #DynamicBackgroundImage_None {
    --unity-image-tint-color: #00000000;
}

/* Zweite Leiste: unter dem Papierstreifen lag noch SIs Vereinsverlauf (#Club) und schien durch den Schattenrand als
   hellblaue Kante; die Titelleiste dahinter war hellgrau. Beides weg, unter dem Streifen liegt der Tisch. FMs
   Umschalter setzt display per Code, deshalb opacity statt display (per Werkstatt gesehen). Nur unter #EntityGradient:
   Der Umschalter links (Wappen, Vereinsname, Blätterpfeile) heißt ebenfalls #Club und verschwand mit (Discord
   10.11.2026, Pfeile unter dem Wappen). */
#SecondaryNavigationBar #EntityGradient #Club {
    opacity: 0;
}
.main-navigation-overview-container {
    background-color: #00000000;
}
/* Absenderzeile einer Nachricht: ebenfalls ein Vereinsverlauf (#Club) unter 20 % Schwarz, wirkte kalt graublau. */
#SenderArea > #Club {
    display: none;
}
#SenderArea.entity-background-header {
    background-color: #FDF8ED0A;
    border-bottom-width: 1px;
    border-bottom-color: #FDF8ED26;
}

/* SIs Standardtextur fm27_skin_default (Nachtblau mit Muster) liegt hinter kleinen Flächen: aktive Kachel in
   Gesprächen und Pressekonferenzen, Fragenzähler. Papier statt Nacht; die aktive Kachel bekommt eine Tintenkante. */
.meeting-tiles--background-active, .modal-sheet-background {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #FFFFFF;
}
.meeting-tiles-base.meeting-tiles--background-active {
    border-width: 2px;
    border-color: #E3E1DB;
}

/* Spielkacheln (Vorschau, nächstes Spiel): SI stapelt drei Ebenen in Wettbewerbsfarbe (Bundesliga dunkelrot) und
   einen Vereinsverlauf hinter die Kachel; darauf stand Tinte unlesbar. Die Ebenen gehen, die Kachel wird ein Blatt
   wie alle anderen (Wappen und Wettbewerbslogo bleiben). */
.fixture-background-border, #Licensed > .fixture-background-border.calendar-comp-event-background-middlelayer,
.calendar-comp-event-background-bundesliga-bottomlayer,
.calendar-comp-event-background-bundesliga-toplayer,
.calendar-comp-event-background-carabao-cup-bottomlayer,
.calendar-comp-event-background-carabao-cup-toplayer,
.calendar-comp-event-background-champions-league-bottomlayer,
.calendar-comp-event-background-champions-league-toplayer,
.calendar-comp-event-background-championship-bottomlayer,
.calendar-comp-event-background-championship-toplayer,
.calendar-comp-event-background-europa-conference-league-bottomlayer,
.calendar-comp-event-background-europa-conference-league-toplayer,
.calendar-comp-event-background-europa-league-bottomlayer,
.calendar-comp-event-background-europa-league-toplayer,
.calendar-comp-event-background-league-one-bottomlayer,
.calendar-comp-event-background-league-one-toplayer,
.calendar-comp-event-background-league-two-bottomlayer,
.calendar-comp-event-background-league-two-toplayer,
.calendar-comp-event-background-premier-league-bottomlayer,
.calendar-comp-event-background-premier-league-toplayer,
.calendar-comp-event-background-super-cup-bottomlayer,
.calendar-comp-event-background-super-cup-toplayer,
.calendar-comp-event-background-womens-champs-league-bottomlayer,
.calendar-comp-event-background-womens-champs-league-toplayer {
    display: none;
}
/* Die mittlere Ebene (Wettbewerbsbild, Champions League blau) blendet FM per Code wieder ein, display greift dort
   nicht: sie schien als blauer Rand um das Blatt der Kachel „Nächstes Spiel“ (Jonas 03.11.2026, Dark). */
SIImage.fixture-background-border.calendar-comp-event-background-middlelayer {
    visibility: hidden;
}
/* Spiele im Kalender: dieselben Wettbewerbsebenen; statt dunkelroter Fläche ein Zettel mit Tintenstrich links. */
.calendar-event-content {
    background-color: #FDF8ED12;
    border-left-width: 3px;
    border-left-color: #E3E1DB;
}
#background-gradient > .layout-tile-interaction-button {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Kabine vor dem Spiel (Team-News, Mannschaftsblatt, Ratschläge): SI malt die Seitenpanels per Inline-Stil
   Mitternachtsblau und das Mannschaftsblatt weiss mit fester schwarzer Schrift; die Spiegelung drehte das Blatt
   auf Tinte. Alles wird Papier: die Panels über ein Blatt auf dem Kind (Bild schlägt Inline-Farbe), das
   Mannschaftsblatt hell mit Tintenschrift, sein Kopf als Tintenband. */
#TeamNews.padding-horizontal-global-padding-large, #StaffAdvice.padding-horizontal-global-padding-large {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    margin: -2px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.me-team-sheet-body-licensed {
    background-color: #201E19;
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
}
.me-team-sheet-body-licensed .text-neutral-black {
}
.me-team-sheet-licensed-default > #upper-frame {
    background-color: #1C1A16; /* fest */
}

/* Anzeigetafel im Spiel: Fernsehgrafik auf dunklem Grund, die Spiegelung drehte ihre Schrift auf Tinte. Die Tafel
   bleibt Fernsehen, ihre Schrift hell (Teamkürzel färbt FM selbst). */
.fm-scoreboard SIText {
}

/* Startbildschirm (#intro-panel): SIs Kacheln sind dort durchsichtig über der Kabine, die Tintenschrift darauf war
   unlesbar. Jede Kachel ohne eigenes Bild wird ein Blatt; Kacheln mit Bild (Shuffle-Draft, Nationalmannschaft)
   behalten ihr Bild und helle Schrift. Die Knöpfe oben werden Papieretiketten. */
#intro-panel .layout-tile-interaction-button-background, #intro-panel .layout-tile-interaction-button.startscreenVar {
    background-color: #00000000;
    background-image: var(--bild-flachblatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Die Kacheln liegen als Papier auf der Menükarte, aber nur mit leisem Auflageschatten (Jonas 01.11.2026). */
#intro-panel .startnewcareer_custom_bg_tile .layout-tile-interaction-button,
#GameCreationStartJourneyScreen .startnewcareer_custom_bg_tile .layout-tile-interaction-button {
    background-image: var(--bild-leer);
}
#intro-panel .startnewcareer_custom_bg_tile SIText, #GameCreationStartJourneyScreen .startnewcareer_custom_bg_tile SIText {
}
/* Karriere beginnen (Schnellstart, Erweitert, Shuffle-Draft): dieselben Bildkacheln; SIs Bilder sind halbdurchsichtig
   und brauchen dunklen Grund, sonst stand die helle Schrift auf Papier. */
#GameCreationStartJourneyScreen .startnewcareer_custom_bg_tile #BGAndFooter {
    background-color: #D9D6CF;
}
/* Nationalmannschaft: SIs eigene Titelregel für diese Kachel (#tile-wide-4x2-wc-start) setzt die Textfarbe, im Skin
   Tinte, und schlug die Regel darüber; der Titel stand schwarz auf Rot. */
#intro-panel .startnewcareer_custom_bg_tile #tile-wide-4x2-wc-start .tile-title-color {
}
#intro-panel .layout-tile-base-container.startscreenVar {
    background-color: #00000000;
}
#intro-panel .buttons-button-base-default, #intro-panel .si-dropdown__selection-field {
    background-color: #1C1A16E6;
    border-width: 1px;
    border-color: #FDF8ED40;
}
/* Grund dafür: Kacheln und Knöpfe schwebten frei vor der Kabinenszene. Die linke Spalte liegt jetzt auf einer großen
   Heftseite, die links, oben und unten über den Bildschirm hinausläuft und rechts eine Risskante hat; der Trainer
   rechts bleibt frei. Die Seite ist eine Spur dunkler als die Blätter darauf (Heft: Seite #26241E, Papier #201E19). */
#intro-panel #main_container {
    align-self: flex-start;
    background-image: var(--bild-heftkarte);
    -unity-slice-left: 0;
    -unity-slice-right: 48;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #EBEBEB;
    margin-left: -12px;
    margin-top: -12px;
    margin-bottom: -12px;
    padding-left: 52px;
    padding-right: 60px;
    padding-top: 42px;
    padding-bottom: 42px;
}
/* Benutzername der Plattform (Game Pass, Xbox): SI setzt ihn rechts an den Rand von #main_container; seit die Spalte
   nur noch so breit wie ihre Kacheln ist, lag er über „Mehr“ und „Beenden“ (Discord 10.11.2026). Ohne ihn, er sagt im
   Heft nichts. */
#intro-panel #main_container > TemplateContainer#GamerTag {
    display: none;
}
/* Startbildschirm als Ganzes (Jonas 01.11.2026): statt der Kabinenszene der Tisch, rechts neben der Menükarte Zettel
   mit QR-Codes zu Patreon, YouTube und Twitch und ein Titelzettel (heft_test.build_start_page). Ein Bild deckt die
   3D-Szene; FM skaliert es auf den Schirm und schneidet bei anderen Seitenverhältnissen die Ränder. */
#intro-panel {
    background-image: var(--bild-startseite);
    -unity-background-scale-mode: scale-and-crop;
}
#intro-panel #Version {
}
/* Unter „Aktuelle Karriere fortsetzen“ liegt SIs Bild in Vereinsfarben; auf der hellen Seite schimmerte es blau durch
   den Schattenrand des Blatts. Unsichtbar statt display: none, es gibt der Kachel ihre Höhe. */
#intro-panel .startscreen-load-most-recent-opacity {
    opacity: 0;
}

/* Ladebildschirm (Spielstand laden): der Schreibtisch des Trainers am Spieltagabend (Ladebild, Jonas 02.11.2026),
   der Fortschritt steht auf einem Blatt darüber. */
#Background.modal-sheet-background {
    background-image: var(--bild-ladebild);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: #FFFFFF;
}
#Background.modal-sheet-background .menu-tile-background {
    display: none;
}
.panel-load-game-style-bar {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Warnung vor Lichtempfindlichkeit beim Spielstart: Tintenschrift direkt auf SIs Neonbild war unlesbar. Die Warnung
   steht jetzt auf einem Blatt. */
.photosensitivity-warning-message {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 36px 44px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Sternbewertungen (Fähigkeit, Potenzial, Rollen, Trainer): FM malt volle Sterne gold, Potenzial und leere Sterne
   hell-lila, auf Papier unsichtbar. Jede Sternart hat eine Klasse; die Tönung macht Gold satter (Druckfarbe) und
   Potenzial/leer zu grauer Tinte (gefüllt bzw. Umriss). */
.ability-max-potential-level-fullfilled-youth-false, .ability-max-potential-level-fullfilled-youth-true {
    -unity-background-image-tint-color: #E8C488;
}
.ability-half-potential-level-half-youth-false, .ability-half-potential-level-half-youth-true,
.ability-half-potential-level-none-youth-false, .ability-half-potential-level-none-youth-true {
    -unity-background-image-tint-color: #C9B48C;
}
.ability-minimum-potential-level-full-youth-false, .ability-minimum-potential-level-full-youth-true,
.ability-minimum-potential-level-half-youth-false, .ability-minimum-potential-level-half-youth-true {
    -unity-background-image-tint-color: #7A7366;
}
.ability-minimum-potential-level-none-youth-false, .ability-minimum-potential-level-none-youth-true {
    -unity-background-image-tint-color: #D4D1C8;
}

/* Symbole auf dunklem oder farbigem Grund bleiben weiss (heft-symbole.uss färbt alle anderen in Tinte): Vereinsleiste,
   blaue Hauptknöpfe, Anzeigetafel, Bildkacheln im Startbildschirm. Weiss ist für farbige Bilder neutral. */
#MainNav *, .buttons-button-primary-default *, .buttons-button-primary-tactics *, .buttons-quick-action-primary *,
.actions-button-primary *, .fm-scoreboard *, .startnewcareer_custom_bg_tile * {
    -unity-background-image-tint-color: #FFFFFF;
    --unity-image-tint-color: #FFFFFF;
}

/* Spielerkopf in Vertrag, Transfer, Entwicklung: SI zeichnet einen Verlauf in Vereinsfarbe (bläulich bei HSV). Darüber
   eine Papierfläche, eine Tintenlinie trennt den Kopf. */
#player-info-frame.sigradient {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #ECE6D8;
    --start-colour: #00000000;
    --end-colour: #00000000;
    border-bottom-width: 1px;
    border-bottom-color: #FDF8ED26;
}

/* Symbolfarben für gut/schlecht (Daumen, Scouting-Treffer, Vorstand): Neongrün und Hellrot verschwanden auf Papier.
   Heftfarben wie bei den Texten. */
.very-positive-background-image-tint-colour, .thumbs-up-background-image-tint-colour, .scout-match-background-image-tint-colour,
.ui-concepts-thumbs-up_small, .ui-concepts-thumbs-up_medium {
    -unity-background-image-tint-color: #0B7334;
}
.very-negative-background-image-tint-colour, .thumbs-down-background-image-tint-colour, .ui-concepts-thumbs-down_small,
.ui-concepts-thumbs-down_medium {
    -unity-background-image-tint-color: #8A2A1D;
}

/* Spielergesichter auf der Taktiktafel (nur mit dem Zusatz gesichter.py, der FMs Taktik-Vorlage patcht): ein rundes
   Passfoto auf Papier mit Tintenrand deckt das Trikot ab. */
.heft-gesicht {
    position: absolute;
    left: 50%;
    top: -10px;
    width: 40px;
    height: 40px;
    translate: -50% 0;
    align-items: center;
    justify-content: center;
    background-color: #201E19;
    border-width: 1.5px;
    border-color: #E3E1DB;
    border-radius: 50%;
    overflow: hidden;
}
.heft-gesicht-bild {
    width: 100%;
    height: 100%;
    margin-top: 3px;
}
/* Das Trikot selbst (Bild und Nummer, im Code erzeugt) weicht dem Passfoto, nur wo der Patch eins eingesetzt hat
   (Klasse heft-mit-gesicht). Ohne Patch, etwa nach einem FM-Update, bleiben die Trikots. */
.heft-mit-gesicht > Image, .heft-mit-gesicht > SIText {
    display: none;
}

/* Spielerkarten der Spielleiste im Spiel (Bank, Aufstellung): SI legt 40 % Nachtblau über das Spielfeld, darauf
   weisse Schrift; gespiegelt grau mit Tinte. Hier ein Blatt Papier je Karte mit Tintenschrift. */
.player-info-property-1-overview-mode {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #FFFFFF;
    border-right-width: 1px;
    border-right-color: #FDF8ED26;
}
.player-info-property-1-overview-mode SIText {
}
/* Namen dort sind Links in Weiss in der schmalen Heftschrift; mit Kante wirkte die hohl, deshalb Textschrift mit
   Tintenkern. */
.player-info-property-1-overview-mode .condensed-sm-strong, .player-info-block-small-title .condensed-sm-strong {
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
/* Namen in Interviews und Spielerkarten in Universe 16 px: breitere Kante gegen den weissen Kern. */
.fm-universe-small-16px-no-wrap, .fm-universe-small-16px {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}

/* Spielerprofil, Kopf: Name, Verein, Nation, Wert und Sterne standen lose auf dem Tisch. Jetzt eine Karteikarte aus
   Papier mit Tintenlinien zwischen den Spalten. Jede Spalte gleich gebaut: erste Zeile Tinte, darunter Grau. */
.report-player-full-header-max-type-player {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    /* Abstand oben per translate statt margin-top: ein höherer Kopf nahm dem Raster darunter Platz, das Mausrad
       verschob dann die Attribute um 14 px (David Fernández, 01.11.2026). -4 px unten gleichen den Rest aus. */
    translate: 0 10px;
    margin-bottom: -4px;
    margin-left: 16px;
    margin-right: 16px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Kopf der Vereins-, Nachrichten- und Nationenseiten: Wappen, Name und Kennzahlen lagen frei auf dem Tisch; jetzt
   eine Karte wie im Spielerprofil. Der Kopf selbst (#Header) trägt den Tisch, die Karte liegt auf seinem Inhalt
   (dem Element unter dem Kopfverlauf: .ios-site-header bei Vereinen, #ForYouHeader auf der News-Startseite). */
.site-header-container .sigradient > VisualElement, .comp-site-header > BindingRemapper > .sigradient > #NonPhoneLayout {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-top: 6px;
    margin-left: 16px;
    margin-right: 16px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.report-player-full-header-max-type-player .layout-layout-divider-solid-vertical {
    background-color: #FDF8ED59;
    width: 1px;
}
.report-player-banner-max-human-mockup .body-md, .report-player-banner-max-human-mockup .cell-secondary-text {
}
/* Transferwert: Etikett und Wert stehen frei, ohne SIs Kasten (Tabellen, Scoutbericht, Jonas 04.11.2026). Der Kasten
   kostete in schmalen Spalten zudem 18 px Text. */
.data-display-data_display-cell-icon-string-transfer-value {
    background-color: #00000000;
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
}
/* Aktionen: umrandeter Tintenknopf wie "Vergleichen" statt blauem Block mitten im Kopf. */
.report-player-banner-max-human-mockup .buttons-button-primary-default {
    background-color: #00000000;
    border-width: 1px;
    border-color: #FDF8ED66;
    border-radius: 3px;
    height: 28px;
}
.report-player-banner-max-human-mockup .buttons-button-primary-default > SIGradient {
    display: none;
}
.report-player-banner-max-human-mockup .buttons-button-primary-default * {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}
/* Alle Spalten beginnen auf der Höhe des Namens (SI zentriert den Verein senkrecht, die anderen stehen oben). */
.report-player-banner-max-human-mockup #Frame, .report-player-banner-max-human-mockup #SingleClub {
    align-items: flex-start;
}
/* Grösse: SIs Kopf (14 px) wirkte auf der Karteikarte verloren, 30/19/16 px dann klobig (Jonas 01.11.2026). Nah am
   Rest der Seite: Name 24 px, erste Zeile je Spalte 16 px, darunter 14 px, Sterne 1,2-fach. Logische Pixel, sie
   wachsen mit FMs Oberflächenskalierung. */
.report-player-banner-max-human-mockup SIText {
    font-size: 14px;
    height: auto;
    min-height: 0;
}
.report-player-banner-max-human-mockup .fm-universe-20px {
    font-size: 24px;
    margin-bottom: 2px;
    overflow: visible;
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
.report-player-banner-max-human-mockup .cell-medium, .report-player-banner-max-human-mockup NavigableLink {
    height: auto;
    min-height: 0;
    overflow: visible;
}
.report-player-banner-max-human-mockup .body-md-strong, .report-player-banner-max-human-mockup .body-regular-14px-bold {
    font-size: 16px;
}
.report-player-banner-max-human-mockup #AbilityStarRange {
    scale: 1.2 1.2;
    transform-origin: left top;
}
/* Beschriftung der Sterne: fett in Tinte wie die Abschnittstitel, bündig mit dem ersten Stern (das Sternbild hat
   links Luft). Die Gruppe ist 1,2-fach skaliert, daher 11 px. */
.report-player-banner-max-human-mockup #CurrentAbilityText, .report-player-banner-max-human-mockup #PotentialAbilityText {
    font-size: 11px;
    -unity-font-definition: var(--typography-family-thematic);
    letter-spacing: 0.3px;
    margin-left: 5px;
}
/* Abschnittstitel der Attributtabelle (Technisch, Mental, Athletik, Standards, Torhüter): SI setzt sie klein und grau,
   auf Papier gingen sie unter. Heft-Überschrift in Tinte. */
.secondary-text-colour.condensed-xs-regular.align-self-start, #InfoTitleText {
    -unity-font-definition: var(--typography-family-thematic);
    font-size: 15px;
    letter-spacing: 0.5px;
}
/* Knopf "Analyse: Attribute" in der Info-Spalte: SIs Symbol ist weiss mit bunten Punkten, auf Papier unsichtbar.
   In Tinte; gedrückt (blauer Grund) wieder weiss. */
.buttons-button-single-toggle-default--toggle-false .game-concepts-attributes-medium {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}
.buttons-button-single-toggle-default--toggle-true .game-concepts-attributes-medium {
    -unity-background-image-tint-color: #FFFFFF;
}
/* Spielerfoto im Kopf: die Bilder tragen oben eine helle Kante, auf Papier als Strich sichtbar. Drei Pixel höher
   gesetzt und oben abgeschnitten. */
.thumbnails-alt-person-picture-player-report {
    overflow: hidden;
}
.thumbnails-alt-person-picture-player-report #PersonImage {
    translate: 0 -3px;
}
/* Attributwerte: fett in der Heft-Zahlenschrift (Barlow Semi Condensed 700) wie die Wertfelder im Heft. Die Farben
   der Felder kommen aus FMs Einstellungen (Benutzerdefinierte Farben), siehe README. */
.data_display-string-thematic-accent #badge-text {
    -unity-font-definition: var(--typography-family-thematic);
    font-size: 17px;
}
/* Positionskarte im Profil: Platz neutral wie im Heft (Papiergrau, Linien in Tinte) statt dunklem Rasen; die
   Punktfarben kommen aus FMs Einstellungen. SIs Rasenbild liegt auf zwei Ebenen, beide bekommen die Skizze. */
.pitch-small, .pitch-small-bg {
    background-image: var(--bild-platz);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #FFFFFF;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}
/* Positionskarte im Spielerprofil: FM setzt das Rasenbild per Code (Stilregeln greifen dort nicht). Es wird
   unsichtbar, die Platzskizze liegt auf seinem Rahmen; die Punkte darüber bleiben. */
.data_display-positions-suitability-default-type-thematic-orientation-landscape-200px {
    opacity: 0;
}
.data_display-positions-suitability-default-type-thematic-orientation-landscape-200px_container {
    background-image: var(--bild-platz);
    -unity-background-scale-mode: stretch-to-fill;
}

/* Hauptbereiche: unter den Blättern liegt je Bereich ein eigenes Material statt des Schreibtischs (Portal und alle
   Unterseiten behalten den Nussbaum). FM legt jeden Bildschirm als Panel mit eigenem Namen an; den Hintergrund
   tragen #Content (.base-layer-content) oder bei Seiten mit #Card-frame dessen #Header und #GridSafeArea. */
#TeamSquadReport #Card-frame > #Header, #TeamSquadReport #Card-frame > #GridSafeArea {
    background-image: var(--bild-tisch);
}
#TacticalPlannerTool #Card-frame > #Header, #TacticalPlannerTool #Card-frame > #GridSafeArea {
    background-image: var(--bild-tisch);
}
#RecruitmentScreen .base-layer-content {
    background-image: var(--bild-tisch);
}
#TrainingScreen .base-layer-content {
    background-image: var(--bild-tisch);
}
#ClubScreen .base-layer-content {
    background-image: var(--bild-tisch);
}
/* Große Listen ohne eigene Kachel (Kader, Taktik-Spielerliste): SI legt sie auf .frames-general-view mit der
   halbdurchsichtigen Auflage. Auf Pappe fiel das nicht auf, auf Fliesen, Tafel und Holz schien der Grund durch
   (Jonas 31.10.2026). Ein ganzes Blatt wie die Kacheln. */
.frames-general-view {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Rollenkürzel auf den farbigen Positionsbalken der Taktik (VFV, DM, BBSm …): weiß wie im Original, ohne
   Tintenkern (Jonas 31.10.2026). Die Tooltips darunter (#RoleNameTooltipText) bleiben Tinte auf Papier. */
#PositionColour #text {
}

/* Klickbare Kacheln heben sich beim Drüberfahren ein wenig vom Tisch: 2 px nach oben, der Schatten wird länger und
   weicher (eigenes Blatt mit angehobenem Schatten). Nur Kacheln, keine großen Listen. */
.layout-tile-interaction-button.layout-tile-interaction-button-background, .control_bar_button {
    transition-property: translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.layout-tile-interaction-button.layout-tile-interaction-button-background:hover, .control_bar_button:hover {
    background-color: #00000000;
    translate: 0 -2px;
    background-image: var(--bild-hochblatt);
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* SI färbt die Karte beim Hover und Klicken ein; die Farbe füllte auch den Schattenrand unter der Papierkante
   (weisser Streifen, Jonas 31.10.2026). */
.control_bar_button:active:enabled {
    background-color: #00000000;
}
/* In den Kartenleisten steckt in jeder Karte noch ein Kachelknopf; er hob sich mit eigenem Blatt und Schatten
   mit und zeichnete beim Hover einen Kasten unter die Karte (Jonas 31.10.2026). Nur die Karte hebt sich. */
.control_bar_button .layout-tile-interaction-button.layout-tile-interaction-button-background:hover {
    translate: 0 0;
    background-image: var(--bild-leer);
}

/* Kürzel auf Rollenfeldern der Spielerliste (Position, mB-/oB-Rolle) ebenso weiß wie auf der Tafel. */
.tactics-visualiser-player-position-type-gk-colour SIText, .tactics-visualiser-player-position-type-defenders-colour SIText, .tactics-visualiser-player-position-type-defensive-midfield-colour SIText, .tactics-visualiser-player-position-type-midfield-colour SIText, .tactics-visualiser-player-position-type-attacking-midfield-colour SIText, .tactics-visualiser-player-position-type-striker-colour SIText {
}

/* Moral, Fitness und Spielpraxis: SIs bunte Symbole sind für dunklen Grund hell (Limette, Pastell) und gingen auf
   Papier unter (Jonas 31.10.2026). Getönt statt umgefärbt: Farbe bleibt, gut ein Viertel dunkler. FM setzt die
   Stufenklassen per Code, daher alle Stufen und Größen. */
.scaling-icons-form-morale-0-size-x-small-12px, .scaling-icons-form-morale-0-size-small-16px, .scaling-icons-form-morale-0-size-medium-24px, .scaling-icons-form-morale-0-size-large-32px,
.scaling-icons-form-morale-1-size-x-small-12px, .scaling-icons-form-morale-1-size-small-16px, .scaling-icons-form-morale-1-size-medium-24px, .scaling-icons-form-morale-1-size-large-32px,
.scaling-icons-form-morale-2-size-x-small-12px, .scaling-icons-form-morale-2-size-small-16px, .scaling-icons-form-morale-2-size-medium-24px, .scaling-icons-form-morale-2-size-large-32px,
.scaling-icons-form-morale-3-size-x-small-12px, .scaling-icons-form-morale-3-size-small-16px, .scaling-icons-form-morale-3-size-medium-24px, .scaling-icons-form-morale-3-size-large-32px,
.scaling-icons-form-morale-4-size-x-small-12px, .scaling-icons-form-morale-4-size-small-16px, .scaling-icons-form-morale-4-size-medium-24px, .scaling-icons-form-morale-4-size-large-32px,
.scaling-icons-form-morale-5-size-x-small-12px, .scaling-icons-form-morale-5-size-small-16px, .scaling-icons-form-morale-5-size-medium-24px, .scaling-icons-form-morale-5-size-large-32px,
.scaling-icons-form-morale-6-size-x-small-12px, .scaling-icons-form-morale-6-size-small-16px, .scaling-icons-form-morale-6-size-medium-24px, .scaling-icons-form-morale-6-size-large-32px,
.scaling-icons-form-morale-7-size-x-small-12px, .scaling-icons-form-morale-7-size-small-16px, .scaling-icons-form-morale-7-size-medium-24px, .scaling-icons-form-morale-7-size-large-32px,
.scaling-icons-form-morale-8-size-x-small-12px, .scaling-icons-form-morale-8-size-small-16px, .scaling-icons-form-morale-8-size-medium-24px, .scaling-icons-form-morale-8-size-large-32px,
.scaling-icons-form-morale-9-size-x-small-12px, .scaling-icons-form-morale-9-size-small-16px, .scaling-icons-form-morale-9-size-medium-24px, .scaling-icons-form-morale-9-size-large-32px,
.scaling-icons-form-morale-10-size-x-small-12px, .scaling-icons-form-morale-10-size-small-16px, .scaling-icons-form-morale-10-size-medium-24px, .scaling-icons-form-morale-10-size-large-32px,
.scaling-icons-form-morale-11-size-x-small-12px, .scaling-icons-form-morale-11-size-small-16px, .scaling-icons-form-morale-11-size-medium-24px, .scaling-icons-form-morale-11-size-large-32px,
.scaling-icons-form-morale-12-size-x-small-12px, .scaling-icons-form-morale-12-size-small-16px, .scaling-icons-form-morale-12-size-medium-24px, .scaling-icons-form-morale-12-size-large-32px,
.scaling-icons-form-morale-13-size-x-small-12px, .scaling-icons-form-morale-13-size-small-16px, .scaling-icons-form-morale-13-size-medium-24px, .scaling-icons-form-morale-13-size-large-32px,
.scaling-icons-form-morale-14-size-x-small-12px, .scaling-icons-form-morale-14-size-small-16px, .scaling-icons-form-morale-14-size-medium-24px, .scaling-icons-form-morale-14-size-large-32px,
.scaling-icons-form-morale-15-size-x-small-12px, .scaling-icons-form-morale-15-size-small-16px, .scaling-icons-form-morale-15-size-medium-24px, .scaling-icons-form-morale-15-size-large-32px,
.scaling-icons-form-morale-16-size-x-small-12px, .scaling-icons-form-morale-16-size-small-16px, .scaling-icons-form-morale-16-size-medium-24px, .scaling-icons-form-morale-16-size-large-32px,
.scaling-icons-form-morale-17-size-x-small-12px, .scaling-icons-form-morale-17-size-small-16px, .scaling-icons-form-morale-17-size-medium-24px, .scaling-icons-form-morale-17-size-large-32px,
.scaling-icons-form-morale-18-size-x-small-12px, .scaling-icons-form-morale-18-size-small-16px, .scaling-icons-form-morale-18-size-medium-24px, .scaling-icons-form-morale-18-size-large-32px,
.scaling-icons-form-morale-19-size-x-small-12px, .scaling-icons-form-morale-19-size-small-16px, .scaling-icons-form-morale-19-size-medium-24px, .scaling-icons-form-morale-19-size-large-32px,
.scaling-icons-form-morale-20-size-x-small-12px, .scaling-icons-form-morale-20-size-small-16px, .scaling-icons-form-morale-20-size-medium-24px, .scaling-icons-form-morale-20-size-large-32px,
.scaling-icons-condition-level-0-size-x-small-12px, .scaling-icons-condition-level-0-size-small-16px, .scaling-icons-condition-level-0-size-medium-24px, .scaling-icons-condition-level-0-size-large-32px,
.scaling-icons-condition-level-1-size-x-small-12px, .scaling-icons-condition-level-1-size-small-16px, .scaling-icons-condition-level-1-size-medium-24px, .scaling-icons-condition-level-1-size-large-32px,
.scaling-icons-condition-level-2-size-x-small-12px, .scaling-icons-condition-level-2-size-small-16px, .scaling-icons-condition-level-2-size-medium-24px, .scaling-icons-condition-level-2-size-large-32px,
.scaling-icons-condition-level-3-size-x-small-12px, .scaling-icons-condition-level-3-size-small-16px, .scaling-icons-condition-level-3-size-medium-24px, .scaling-icons-condition-level-3-size-large-32px,
.scaling-icons-condition-level-4-size-x-small-12px, .scaling-icons-condition-level-4-size-small-16px, .scaling-icons-condition-level-4-size-medium-24px, .scaling-icons-condition-level-4-size-large-32px,
.scaling-icons-condition-level-5-size-x-small-12px, .scaling-icons-condition-level-5-size-small-16px, .scaling-icons-condition-level-5-size-medium-24px, .scaling-icons-condition-level-5-size-large-32px,
.scaling-icons-condition-level-6-size-x-small-12px, .scaling-icons-condition-level-6-size-small-16px, .scaling-icons-condition-level-6-size-medium-24px, .scaling-icons-condition-level-6-size-large-32px,
