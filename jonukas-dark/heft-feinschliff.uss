/* Ein Grün für „positiv“ (Jonas 10.11.2026, Tannengrün): Daumen hoch, auch wenn FM beiden Daumen-Klassen setzt (die
   Daumen-runter-Regel stand später und färbte ihn rot), und die Siegpunkte (SIs farbiges Symbol, Tönung multipliziert). */
.ui-concepts-thumbs-up_small, .ui-concepts-thumbs-up_medium,
.ui-concepts-thumbs-up_small.ui-concepts-thumbs-down_small, .ui-concepts-thumbs-up_medium.ui-concepts-thumbs-down_medium {
    -unity-background-image-tint-color: #1F7A42;
}
.game-concepts-win_small, .game-concepts-win_medium, .game-concepts-win_large {
    -unity-background-image-tint-color: #5084BB;
    --unity-image-tint-color: #5084BB;
}
/* Fortschrittsbalken und Zeitleisten eckig in Heftblau (Jonas 10.11.2026, Option B): SIs runde Balken mit Rahmen und
   die rote Zeitleiste mit rundem Knopf. Balken mit eigener Bedeutung (Fitness, Verletzung, Geduld, Transferfenster)
   behalten ihre Farbe über SIs spitzere Regeln; die Zeitleiste färbt FM per Code, darüber liegt eine getönte Fläche. */
.progress-bar-track, .progress-bar-track-no-radius {
    border-radius: 0;
    background-color: #F2EBDA24;
}
.progress-bar-value {
    background-color: #7CCBF5;
}
.progress-bar-value, .progress-bar-value-green, .progress-bar-value-green-right-radius {
    border-radius: 0;
    border-width: 0;
}
.progress-timeline-track {
    border-radius: 0;
    background-color: #F2EBDA24;
}
.progress-timeline-value, .progress-timeline-handle, .data_display-graph-progress_timeline-progress_indicator {
    background-image: var(--bild-fuellweiss);
    -unity-background-image-tint-color: #7CCBF5;
    border-radius: 0;
    border-width: 0;
}
.progress-timeline-handle, .data_display-graph-progress_timeline-progress_indicator {
    border-radius: 2px;
}
/* Diagramme in SIs Schrift (sonst misst FM die Achsen falsch), Beschriftungen in Barlow 500, SIs Größen. */
FMLineChart, FMScatterChart, FMXGMatchStoryChart, FMMatchMomentumChart, FMStackedBarChart, FMSpiderChart {
    --typography-size-6: 6px;
    --typography-size-7: 7px;
    --typography-size-8: 8px;
    --typography-size-9: 9px;
    --typography-size-10: 10px;
    --typography-size-11: 11px;
    --typography-size-12: 12px;
    --typography-size-13: 13px;
    --typography-size-14: 14px;
    --typography-size-15: 15px;
    --typography-size-16: 16px;
    --typography-size-18: 18px;
    --typography-size-19: 19px;
    --typography-size-20: 20px;
    --typography-size-22: 22px;
    --typography-size-24: 24px;
    --typography-size-26: 26px;
    --typography-size-30: 30px;
    --typography-size-32: 32px;
    --typography-size-36: 36px;
    -unity-font-definition: var(--typography-family-international);
}
FMLineChart Label.unity-label, FMScatterChart Label.unity-label, FMXGMatchStoryChart Label.unity-label, FMMatchMomentumChart Label.unity-label, FMStackedBarChart Label.unity-label, FMSpiderChart Label.unity-label, .data_display-graphs-tile_elements-x_axis_label, .data_display-graphs-tile_elements-y_axis_label, .finances-total-report-charts-y-axis-labels, .financial-history-chart-x-axis-labels, .financial-history-chart-x-axis-name, .financial-history-chart-y-axis-labels, .financial-history-chart-y-axis-name, .league-history-block-x-axis-labels, .league-history-block-y-axis-labels, .league-history-x-axis-labels, .league-history-y-axis-labels, .match-momentum-chart-y-axis-label, .match-ratings-chart-x-axis-labels, .match-ratings-chart-x-axis-name, .match-ratings-chart-y-axis-labels, .match-ratings-chart-y-axis-name, .polar-chart-angle-axis-labels, .polar-chart-radius-axis-labels, .recruitment-budget-charts-x-axis-labels, .recruitment-budget-charts-y-axis-labels, .xg-match-story-x-axis-labels, .xg-match-story-x-axis-name, .xg-match-story-y-axis-labels, .xg-match-story-y-axis-name {
    --typography-size-6: 6px;
