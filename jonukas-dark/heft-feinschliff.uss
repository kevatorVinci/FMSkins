#InfoFrame SIText.heading-regular-18px, VisualElement#InfoFrame SIText.heading-xl, VisualElement#InfoFrame SIText.heading-large-22px, VisualElement#InfoFrame SIText.heading-xxl {
    -unity-font-style: bold;
}

/* Dark Mode: keine grauen Ebenen auf dem Blatt, kein heller Rahmen um die Blätter auf dem Holz. */
.messages-header-texture-club, .messages-header-gradient {
    opacity: 0;
}
.greyed-out-background {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}
.tool-messages-list {
    border-width: 0;
}
/* Blätterpfeile neben dem Bereichsnamen (von Verein zu Verein): ohne eigene Tönung dunkelgrau auf dem dunklen Streifen,
   kaum zu sehen (Discord 10.11.2026, 27.0.1). FM setzt die Knöpfe zudem auf 75 % Deckkraft. */
.quick-flick-button-extra-small {
    opacity: 1;
}
.quick-flick-button-extra-small > .ui-concepts-chevron-top_small, .quick-flick-button-extra-small > .ui-concepts-chevron-down_small {
    -unity-background-image-tint-color: #F2EBDA;
}

/* Tonpapier: Tutorial als Zettel, kein heller Rahmen um Blätter. */
.base-component-tutorial-background {
    --start-colour: #00000000;
    --end-colour: #00000000;
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #DCDCDC;
    border-width: 0;
    border-radius: 0;
}
.surfaces-card-block-border {
    border-width: 0;
}
/* Ergebniskästen kommender Spiele (Wettbewerb, Spielplan): SIs Kachelgrund #1E2129 stand als nachtblauer Kasten auf
   dem Papier (Jonas 04.11.2026). Ein Hauch Papier mit Haarlinie. */
.accent-non-cell-stages-upcoming {
    background-color: #F2EBDA14;
    border-width: 1px;
    border-color: #F2EBDA24;
}
/* Betreffzeilen im Posteingang in der Heftschrift: in der ungedünnten Figtree sahen sie aus wie SIs Schrift (Jonas
   04.11.2026). */
.portal-messages-header-text,
.message-last-selected .portal-messages-item-message-text-read,
.message-not-last-selected .portal-messages-item-message-text-read {
    -unity-font-definition: var(--schrift-heft-eng-600);
}
/* Die zuletzt geöffnete Nachricht ist gelesen: grau wie die anderen, SIs Weiß sah nach ungelesen aus. */
.message-last-selected .portal-messages-item-message-text-read {
    color: var(--global-lift-surface-strong);
}
/* News: Schlagzeilen in der Heftschrift, die Fußzeile (Alter, Rubrik) grau; dort stand sonst dieselbe helle Farbe wie im Titel. */
#newsHeadlineText, #newsHeadlineText.news-tile-header {
    -unity-font-definition: var(--schrift-heft-eng-600);
}
.news-item-footer, .news-item-footer SIText {
    color: var(--global-text-secondary);
}
/* Die Rubrik ist ein Link, FM schreibt sie per Code weiß; zurücknehmen geht nur über die Deckkraft. */
#SIText_headlinesubtitle {
    opacity: 0.68;
}
/* Tabellen wie im Heft in Barlow Semi Condensed 500 statt Figtree 400 (Jonas 05.11.2026: dünn, nicht wie das Vereinsheft;
   600 mit 14 px war zu fett und zu groß). Nur in den dunklen Fassungen: Die hellen brauchen die gedünnte Figtree für die
   weißen Namen. Barlow ist schmaler und wirkt kleiner, deshalb body-sm eine halbe Stufe größer. */
.streamed-table__cell SIText {
    -unity-font-definition: var(--schrift-heft-tabelle-500);
}
.streamed-table__cell SIText.body-sm {
    font-size: 13.5px;
}
/* Schrifthierarchie (Jonas 06.11.2026): Barlow für Inhalte, Figtree für Bedienung und Sätze. Schlagzeilen Barlow 600 (oben),
   Daten Barlow 500, Bedienung Figtree 500 und nie größer als die Daten. */
SIButton SIText#text, SIButton SIText.body-md, SIButton SIText.primary-text,
SIButton SIText.navigation-tab-small-default-text, SIFloatingPopupWidget > SIText {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    font-size: 14px;
}
.streamed-table__cell SIButton SIText, .streamed-table__cell SIButton SIText#text,
.streamed-table__cell SIButton SIText.body-md, .tactics-subs-block SIText.body-sm {
    -unity-font-definition: var(--schrift-heft-tabelle-500);
}
.tactics-subs-block SIText.body-sm {
    font-size: 14.5px;
}
/* Ausnahmen: Hauptnavigation und Weiter-Knopf bleiben Heftschrift, Noten fett (Jonas: sonst zu dünn). */
#MainNav SIButton SIText.portal-text, #continue-button SIText#text {
    -unity-font-definition: var(--typography-family-thematic);
}
#MainNav SIButton SIText.portal-text {
    font-size: var(--typography-size-16);
}
#continue-button SIText#text {
    font-size: 16px;
}
#ValidRating SIText, #ValidRating SIText#text, .streamed-table__cell #ValidRating SIText {
    -unity-font-definition: var(--typography-family-thematic);
}
/* Helle Vereinsfarben (England, VfB, FM setzt .nav-on-light): die Tinte der hellen Fassungen fällt hier mit allen
   Textfarben weg, helle Schrift stand auf weißer Leiste (Jonas 05.11.2026). Tinte nur auf der Vereinsfarbe; rechts der
   dunkle Papierstreifen (#NonDiageticMenu) und die Uhr behalten ihre Farben. */
#MainNav.nav-on-light SIText {
    color: #1C1A16;
}
#MainNav.nav-on-light #NonDiageticMenu SIText, #MainNav.nav-on-light .navigation-primary-nav-calendar-wiget-calendar SIText {
    color: var(--global-text-primary);
}
#MainNav.nav-on-light .navigation-tab-portal-default-active-true .portal-image,
#MainNav.nav-on-light .navigation-tab-portal-default-active-false .portal-image,
#MainNav.nav-on-light #NavTabDropdownIndicator,
#MainNav.nav-on-light .ui-concepts-chevron-left_small,
#MainNav.nav-on-light .ui-concepts-chevron-right_small {
    -unity-background-image-tint-color: #1C1A16;
    --unity-image-tint-color: #1C1A16;
}
/* Taktiktafel: Woods Schatten für die weißen Namen trifft über dieselbe Klasse auch die Rollenkürzel auf den farbigen
   Chips (SpIV, IV …); dort ohne Schatten (Jonas 03.11.2026). Dieselbe Regel setzt sie in Figtree 400, ohne Schatten
   zu dünn: der kräftige Schnitt der übrigen fetten Texte. */
FMTacticsPanel.tactics-collapsable-pitch-grass-colour .position--filled #RoleButton SIText.body-xs-strong {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}
/* Aufstellungsblatt vor dem Spiel (Team-News, Champions League): SI schreibt dort schwarz (.text-neutral-black) auf
   Weiß, bei uns liegt dunkles Papier darunter (Jonas 03.11.2026). */
.me-team-sheet-body-licensed SIText.text-neutral-black {
    color: var(--global-text-primary);
}
/* Weiter-Knopf oben rechts: in Wood Tinte auf gelbem Marker; hier weiße Schrift (Jonas 03.11.2026), der Marker
   bleibt, auf 55 % abgedunkelt: Ocker auf dunklem Papier, Weiß darauf 6:1. */
#continue-button SIText#text {
    color: #FFFFFF;
    -unity-background-image-tint-color: #8C8C8C;
}
#continue-button:hover Sliding#continue-button-gradient,
SIButton#continue-button.continue-button---must-respond Sliding#continue-button-gradient {
    -unity-background-image-tint-color: #8C8C8C;
}
/* Posteingang: der Punkt für ungelesene Nachrichten trägt in Wood die Papierfläche in Füllertinte über SIs weißer
   Codefarbe; hier ohne Bild, SIs Weiß (Jonas 03.11.2026). */
MessagesStreamedObjectList SIVisible > VisualElement#icon {
    background-image: var(--bild-leer);
}
/* Ausgeklappte Bank im Spiel: die Spielerspalten tragen .shortcut-fake-button (durchsichtig) und .squad-overview-item
   (SIs Nachtblau); in Wood gewinnt Woods spätere Farbregel für die erste, hier fehlt sie (Jonas 03.11.2026). */
.squad-overview-block SIButton.squad-overview-item {
    background-color: rgba(0, 0, 0, 0);
    border-right-color: #F2EBDA24;
}
.squad-overview-block VisualElement#SquadInfoSidebar.squad-overview-item,
#Squad_Collapsed .squad-overview-block TemplateContainer.streamed-list-view-item {
    border-right-color: #F2EBDA24;
}
.squad-overview-block SIButton.squad-overview-item:hover {
    background-color: #F2EBDA14;
}
/* Texthierarchie wie in Wood und Paper (Jonas 10.11.2026, LIGHT_CHECKBOX_USS): Reiter der Seite und der zweiten Leiste
   Barlow Semi Condensed 500 (18/15 px), Bereichsname und aktiver Reiter Barlow 600, Spaltenköpfe Barlow 600 in SIs
   Zweitfarbe. Farben bleiben SIs (helle Schrift); die Knopfschrift-Regel oben (SIButton SIText.body-md) erreicht die
   Leistenreiter mit (0,1,2), daher der Leisten-Präfix. */
SIText#navigation-tab-title-text.navigation-tab-default-default-text,
.main-nav-secondary-bar SIText.secondary-navigation-tab-text {
    -unity-font-definition: var(--schrift-heft-tabelle-500);
}
SIText#navigation-tab-title-text.navigation-tab-default-default-text {
    font-size: 18px;
}
.main-nav-secondary-bar SIText.secondary-navigation-tab-text {
    font-size: 15px;
}
.navigation-type-competition #ViewedEntityTypeSwitch SIText.sitext.thematic-xs,
.navigation-secondary-text-portal-default-active-true SIText.secondary-navigation-tab-text,
SIText.table-header-xs {
    -unity-font-definition: var(--schrift-heft-eng-600);
}
.navigation-type-competition #ViewedEntityTypeSwitch SIText.sitext.thematic-xs {
    font-size: 15px;
}
/* Mitarbeiterwerte als Wort (Gut, Sehr gut …): der Feinschliff legt helle Plaketten für helles Papier. Hier die Farben
   des Presets „Jonukas – Dark“ aus dem Farbwerkzeug (heft-pluginarben, Jonas 10.11.2026): dunkler Grund, farbige
   Schrift, Elite mit grünem Rand – für alle ohne das Werkzeug. */
SIText.data_display-coaching_ratings-small.coaching-rating-elite {
    color: #1DC4A5;
    background-color: #171F1D;
    border-width: 1px;
    border-color: #348977;
}
SIText.data_display-coaching_ratings-small.coaching-rating-outstanding {
    color: #29B964;
    background-color: #171D17;
}
SIText.data_display-coaching_ratings-small.coaching-rating-very-good {
    color: #6FD99A;
    background-color: #131B16;
}
SIText.data_display-coaching_ratings-small.coaching-rating-good {
    color: #FFD920;
    background-color: #1F1C16;
}
SIText.data_display-coaching_ratings-small.coaching-rating-average {
    color: #EAE6DD;
    background-color: #20201F;
    border-width: 0;
}
SIText.data_display-coaching_ratings-small.coaching-rating-competent {
    color: #C4BDB0;
    background-color: #1A1A1A;
}
SIText.data_display-coaching_ratings-small.coaching-rating-reasonable {
    color: #A39C8F;
    background-color: #171717;
}
SIText.data_display-coaching_ratings-small.coaching-rating-unsuited {
    color: #D98A4E; /* leicht orange, eine eigene Stufe unter Schlecht und Sehr schlecht (Jonas 10.11.2026) */
    background-color: #1F1814;
}
/* Körpersprache und Stimmung (Spiel, Ansprache, Pressekonferenz): der Feinschliff legt kräftige Plaketten (Grün, Orange,
   Rot, Lila, Blau) mit weißer Schrift; die Schriftregel steht ohne eigene Fläche und fiel hier weg, SIs helles Grün und
   Orange stand auf der gleichfarbigen Plakette (Jonas 10.11.2026). Wie in Wood nach Kontrast: Weiß auf den dunklen,
   Tinte auf Grün, Hellgrün und Orange (feinschliff.uss); neutral bleibt SIs Schrift. */
.body-language-very-positive-background-colour SIText, .body-language-very-negative-background-colour SIText,
.body-language-angry-background-colour SIText, .body-language-complacent-background-colour SIText,
.body-language-sad-background-colour SIText {
    color: #FFFFFF;
}
.body-language-positive-background-colour SIText, .body-language-slightly-positive-background-colour SIText,
.body-language-slightly-negative-background-colour SIText, .body-language-negative-background-colour SIText {
    color: #1C1A16;
}
/* Suchfeld oben: das Blatt kommt aus dem Feinschliff, Haarlinie und Schreibmarke hier hell (Jonas 03.11.2026, live). */
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-edit-box TextInput#unity-text-input.unity-base-text-field__input.bindableeditbox,
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-card-close-button SIButton.buttons-controls-pc-default--active-true.sibutton.ios-header-button {
    border-color: #F2EBDA59;
    --unity-cursor-color: #F2EBDA;
    --unity-selection-color: rgba(232, 196, 136, 0.45);
}

/* Ideen aus fremden Skins (research/tools/heft_ideen.py, 03.11.2026): Paper, Wood und Dark. */

/* 1 Kreisdiagramme in Druckfarben (Finanzen, Budget, Training, Standards, Einstellung): SIs Farbton je Stück
   bleibt, damit die Legende, die FM selbst färbt, weiter passt; nur gedämpft wie gedruckt. */
.pie-chart-finances-expenditure-colours {
    --chart-colour-1: #C2C72F;
    --chart-colour-2: #249B5E;
    --chart-colour-3: #5FC196;
    --chart-colour-4: #C28B50;
    --chart-colour-5: #854ED6;
    --chart-colour-6: #79BE3D;
    --chart-colour-7: #44B2B2;
    --chart-colour-8: #67BC91;
    --chart-colour-9: #C28B50;
    --chart-colour-10: #60C4BE;
    --chart-colour-11: #9C982A;
    --chart-colour-12: #5184CC;
    --chart-colour-13: #D0A136;
    --chart-colour-14: #D03652;
    --chart-colour-15: #D24089;
    --chart-colour-16: #74B96D;
    --chart-colour-17: #B87559;
    --chart-colour-18: #CA522F;
    --chart-colour-19: #52B0B7;
    --chart-colour-20: #44B2B2;
    --chart-colour-21: #ADADAD;
}
.pie-chart-finances-income-colours {
    --chart-colour-1: #C2C72F;
    --chart-colour-2: #D0A136;
    --chart-colour-3: #748C37;
    --chart-colour-4: #5FC196;
    --chart-colour-5: #B65A3E;
    --chart-colour-6: #44B2B2;
    --chart-colour-7: #9C982A;
    --chart-colour-8: #5184CC;
    --chart-colour-9: #CA522F;
    --chart-colour-10: #5184CC;
    --chart-colour-11: #C28B50;
    --chart-colour-12: #888888;
    --chart-colour-13: #854ED6;
    --chart-colour-14: #ADADAD;
    --chart-colour-15: #B87559;
    --chart-colour-16: #79BE3D;
    --chart-colour-17: #C0BC5D;
}
.pie-chart-training-review-colours {
    --chart-colour-1: #965AB2;
    --chart-colour-2: #34B5AB;
    --chart-colour-3: #3FB478;
    --chart-colour-4: #C2C72F;
    --chart-colour-5: #CF3C3C;
    --chart-colour-6: #ADADAD;
}
.pie-chart-finances-report-colours {
    --chart-colour-1: #CF3C3C;
    --chart-colour-2: #C2C72F;
    --chart-colour-3: #34B5AB;
    --chart-colour-4: #C28B50;
    --chart-colour-5: #4BBF3F;
    --chart-colour-6: #BD4995;
    --chart-colour-7: #3678CE;
    --chart-colour-8: #9EBC3B;
    --chart-colour-9: #AA6AC8;
    --chart-colour-10: #3FB478;
    --chart-colour-11: #C0BC5D;
    --chart-colour-12: #5789CB;
    --chart-colour-13: #BD7A31;
}
.pie-chart-budget-colours {
    --chart-colour-1: #7A46B5;
    --chart-colour-2: #BD7A31;
    --chart-colour-3: #3678CE;
}
.pie-chart-mindset-colours {
    --chart-colour-1: #CE9930;
    --chart-colour-2: #7A46B5;
    --chart-colour-3: #C36198;
    --chart-colour-4: #B65A3E;
}
.pie-chart-set-piece-colours {
    --chart-colour-1: #74B96D;
    --chart-colour-2: #5789CB;
    --chart-colour-3: #60C4BE;
}

/* 2 Sterne als gezeichnete Bilder statt getönter SI-Sterne: Gold = Fähigkeit, Packpapier = Potenzial, Umriss
   = leer. Gilt überall, wo FM die Sternklassen setzt (Profil, Kader, Berichte, Trainer). Wood tönt dieselben
   Klassen; die Tönung muss hier weiß werden, sonst färbt sie das Bild mit. Dark: ohne Umriss, hellere
   Töne, leere Hälften deutlich heller als das Papier. */
.ability-max-potential-level-fullfilled-youth-false, .ability-max-potential-level-fullfilled-youth-true {
    background-image: var(--bild-stern-max-fullfilled);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}
.ability-half-potential-level-half-youth-false, .ability-half-potential-level-half-youth-true {
    background-image: var(--bild-stern-half-half);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}
.ability-half-potential-level-none-youth-false, .ability-half-potential-level-none-youth-true {
    background-image: var(--bild-stern-half-none);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}
.ability-minimum-potential-level-full-youth-false, .ability-minimum-potential-level-full-youth-true {
    background-image: var(--bild-stern-minimum-full);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}
.ability-minimum-potential-level-half-youth-false, .ability-minimum-potential-level-half-youth-true {
    background-image: var(--bild-stern-minimum-half);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}
.ability-minimum-potential-level-none-youth-false, .ability-minimum-potential-level-none-youth-true {
    background-image: var(--bild-stern-minimum-none);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;
}

/* 3 Lesegröße: SIs Schriftgrößen-Tokens im Verhältnis 15 zu 14 größer, Fließtext 15 px (große Ziffern ab 40 px
   bleiben). Trifft nur Texte, deren Größe über --typography-size-N läuft; feste font-size-Regeln bleiben. */
:root {
    --typography-size-6: 6.5px;
    --typography-size-7: 7.5px;
    --typography-size-8: 8.5px;
    --typography-size-9: 9.5px;
    --typography-size-10: 10.5px;
    --typography-size-11: 12px;
    --typography-size-12: 13px;
    --typography-size-13: 14px;
    --typography-size-14: 15px;
    --typography-size-15: 16px;
    --typography-size-16: 17px;
    --typography-size-18: 19.5px;
    --typography-size-19: 20.5px;
    --typography-size-20: 21.5px;
    --typography-size-22: 23.5px;
    --typography-size-24: 25.5px;
    --typography-size-26: 28px;
    --typography-size-30: 32px;
    --typography-size-32: 34.5px;
    --typography-size-36: 38.5px;
}
/* In Kacheln und der zweiten Leiste SIs Originalgrößen: feste Maße, sonst Überlauf. */
.layout-tile-base-container, .main-nav-secondary-bar,
.data_display-player-report-header-squad-number-type-standard {
    --typography-size-6: 6px;
    --typography-size-7: 7px;
    --typography-size-8: 8px;
    --typography-size-9: 9px;
    --typography-size-10: 10px;
    --typography-size-11: 11px;
    --typography-size-12: 12px;
    --typography-size-13: 13px;
    --typography-size-14: 14px;
    --typography-size-15: 15px;
    --typography-size-16: 16px;
    --typography-size-18: 18px;
    --typography-size-19: 19px;
    --typography-size-20: 20px;
    --typography-size-22: 22px;
    --typography-size-24: 24px;
    --typography-size-26: 26px;
    --typography-size-30: 30px;
    --typography-size-32: 32px;
    --typography-size-36: 36px;
}

/* 4 Fett über ein Token: SI setzt -unity-font-style fast überall über var(--typography-weight-bold). Auf unseren
   Schnitten ohne Fettschnitt verdickt Unity rechnerisch; normal lässt die Schrift ihr eigenes Gewicht. */
:root {
    --typography-weight-bold: normal;
}

/* 5 Attribute der Rolle als dezenter Textmarker statt SIs Fläche mit Strich: Schlüssel gelb, nützlich blau,
   ohne Ball rosa und lila. Legendenpunkte in derselben Farbe. */
.attributes-row-number-key, .attributes-row-number-key-no-border {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    background-image: var(--bild-marker-gelb);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
}
.attributes-key-key {
    -unity-background-image-tint-color: #E8C531;
}
.attributes-row-number-preference, .attributes-row-number-preference-no-border {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    background-image: var(--bild-marker-blau);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
}
.attributes-key-preferable {
    -unity-background-image-tint-color: #6E9FD3;
}
.attributes-row-number-key-oop {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    background-image: var(--bild-marker-rosa);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
}
.attributes-key-key-oop {
    -unity-background-image-tint-color: #D77FA6;
}
.attributes-row-number-preference-oop {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    background-image: var(--bild-marker-lila);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
}
.attributes-key-preferable-oop {
    -unity-background-image-tint-color: #9C84CC;
}

/* 6 Kacheltitel in einer Zeile (Minimal Dark: „MESAJLA / R“; im Deutschen etwa NACHRICHTEN). */
.sitile__title > #TitleText {
    white-space: nowrap;
    flex-shrink: 0;
}

/* 7 Vereinsfarbe unter den Reitern gedämpft statt ausgeblendet (Mendisala): ein Hauch Vereinsfarbe über dem
   Papierstreifen. Wood blendet den Verlauf dort sonst ganz aus. */
.navigation-type-competition BindableSwitchElement#EntityGradient {
    visibility: visible;
    opacity: 0.3;
}
/* Vor dem Spiel (Mannschaftsauswahl) liegt die Leiste nur links auf einem Blatt, der Hauch Vereinsfarbe blieb als
   Streifen darunter stehen (Jonas 04.11.2026): dort ausgeblendet. */
Panel#TeamSelectionTitleBar .navigation-type-competition BindableSwitchElement#EntityGradient {
    visibility: hidden;
}

/* 8 Verhandlungszeilen als Textmarker: einig grün, ungeduldig orange, geändert blau, abgelehnt rot durchgestrichen; Lücken
   zwischen den Zeilen, SIs farbiger Randstreifen entfällt. */
VisualElement.contract-negotiation-status-accepted {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-marker-verhandlung-gruen);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-bottom: 4px;
}
VisualElement.contract-negotiation-status-invalid, VisualElement.transfer-negotiation-status-colour-invalid {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-marker-verhandlung-orange);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-bottom: 4px;
}
VisualElement.contract-negotiation-status-changed, VisualElement.transfer-negotiation-status-changed {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-marker-blau);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-bottom: 4px;
}
VisualElement.contract-negotiation-status-rejected {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-strich-rot);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-bottom: 4px;
}
VisualElement.contract-term-fill-frame, VisualElement.negotiation-term-fill-frame {
    visibility: hidden;
}

/* 5 Tempo: SIs Übergänge kürzer (Knöpfe 0,1 → 0,05 s, Fenster ein/aus 0,33 → 0,12 s, Einblenden 0,5 → 0,15 s);
   die Übergänge mit Breite, Höhe und Abständen animieren nur noch Farben und Lage, nicht das Layout.
   `* ` vorn gewinnt gegen SIs gleich spezifische Regel im späteren Blatt. */
:root {
    --transition-01: 0.05s;
    --transition-015: 0.06s;
    --transition-018: 0.07s;
    --transition-02: 0.08s;
    --transition-025: 0.1s;
    --transition-03: 0.12s;
    --transition-props-continuous: color, background-color, border-color, border-top-color, border-right-color, border-bottom-color, border-left-color, border-radius, border-top-left-radius, border-top-right-radius, border-bottom-left-radius, border-bottom-right-radius, -unity-background-image-tint-color, -unity-text-outline-color, opacity, scale, rotate, translate;
}
* .panel--open .panel-fade,
* .panel--show .panel-fade,
* .panel--open .sipopup-container,
* .panel--show .sipopup-container,
* .panel--close .panel-fade,
* .panel--hide .panel-fade,
* .panel--close .sipopup-container,
* .panel--hide .sipopup-container,
* .panel--open .notification,
* .panel--show .notification,
* .panel--close .notification,
* .panel--hide .notification,
* .panel--show .shortcuts-panel,
* .highlighting,
* .element-collapsed,
* .element-collapsed-first,
* .element-expanded,
* .menu-element--selected .main-menu-navigation-default,
* .navigation-tab-portal-default-active-false .navigation-tab-dropdown,
* .navigation-tab-portal-default-active-true .navigation-tab-dropdown,
* .navigation-tab-portal-default-active-false .navigation-tab-dropdown:hover,
* .navigation-tab-portal-default-active-true .navigation-tab-dropdown:hover {
    transition-duration: 0.12s;
}
* .fadein,
* .fadeout,
* .scaleout,
* .expand-widget-viewport-animated,
* .expanded-list-background-collapsed,
* .expanded-list-background-transition,
* .navigation-focus-element-border,
* .overlay-ribbon .home-ribbon-root,
* .overlay-ribbon--hidden .home-ribbon-root,
* .ribbon-bottom-anim-out,
* .ribbon-top-anim-out,
* .shortcuts-panel-anim-out,
* .panel--hide .shortcuts-panel,
* .phone-interaction-header-contracted,
* .phone-interaction-header-expanded {
    transition-duration: 0.15s;
}
* .scalein {
    transition-duration: 0.2s;
}
/* Plaketten statt SIs Pastell-Badges (Jonas 10.11.2026): satte Heftfarbe, Schrift nach Kontrast, Barlow 600,
   Symbol in der Schriftfarbe. */
.badges-background-color-green-soft {
    background-color: #1F7A42; /* fest */
    border-width: 0;
}
.badges-background-color-green-soft SIText, .badges-background-color-green-soft SIText.badges-text-color-green-soft {
    color: #FFFFFF; /* fest */
    -unity-font-definition: var(--schrift-heft-eng-600);
    -unity-text-outline-width: 0;
}
.badges-background-color-green-soft SIImage, .badges-background-color-green-soft SIImage.badges-text-color-green-soft, .badges-background-color-green-soft VisualElement.badges-text-color-green-soft {
    -unity-background-image-tint-color: #FFFFFF; /* fest */
    --unity-image-tint-color: #FFFFFF;
}
