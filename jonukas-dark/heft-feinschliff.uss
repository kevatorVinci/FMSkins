.scaling-icons-condition-level-8-size-x-small-12px, .scaling-icons-condition-level-8-size-small-16px, .scaling-icons-condition-level-8-size-medium-24px, .scaling-icons-condition-level-8-size-large-32px,
.scaling-icons-condition-level-9-size-x-small-12px, .scaling-icons-condition-level-9-size-small-16px, .scaling-icons-condition-level-9-size-medium-24px, .scaling-icons-condition-level-9-size-large-32px,
.scaling-icons-condition-level-10-size-x-small-12px, .scaling-icons-condition-level-10-size-small-16px, .scaling-icons-condition-level-10-size-medium-24px, .scaling-icons-condition-level-10-size-large-32px,
.scaling-icons-condition-level-injured-size-x-small-12px, .scaling-icons-condition-level-injured-size-small-16px, .scaling-icons-condition-level-injured-size-medium-24px, .scaling-icons-condition-level-injured-size-large-32px,
.scaling-icons-sharpness-sharpness-0-size-x-small-12px, .scaling-icons-sharpness-sharpness-0-size-small-16px, .scaling-icons-sharpness-sharpness-0-size-medium-24px, .scaling-icons-sharpness-sharpness-0-size-large-32px,
.scaling-icons-sharpness-sharpness-1-size-x-small-12px, .scaling-icons-sharpness-sharpness-1-size-small-16px, .scaling-icons-sharpness-sharpness-1-size-medium-24px, .scaling-icons-sharpness-sharpness-1-size-large-32px,
.scaling-icons-sharpness-sharpness-2-size-x-small-12px, .scaling-icons-sharpness-sharpness-2-size-small-16px, .scaling-icons-sharpness-sharpness-2-size-medium-24px, .scaling-icons-sharpness-sharpness-2-size-large-32px,
.scaling-icons-sharpness-sharpness-3-size-x-small-12px, .scaling-icons-sharpness-sharpness-3-size-small-16px, .scaling-icons-sharpness-sharpness-3-size-medium-24px, .scaling-icons-sharpness-sharpness-3-size-large-32px,
.scaling-icons-sharpness-sharpness-4-size-x-small-12px, .scaling-icons-sharpness-sharpness-4-size-small-16px, .scaling-icons-sharpness-sharpness-4-size-medium-24px, .scaling-icons-sharpness-sharpness-4-size-large-32px,
.scaling-icons-sharpness-sharpness-5-size-x-small-12px, .scaling-icons-sharpness-sharpness-5-size-small-16px, .scaling-icons-sharpness-sharpness-5-size-medium-24px, .scaling-icons-sharpness-sharpness-5-size-large-32px,
.scaling-icons-sharpness-sharpness-6-size-x-small-12px, .scaling-icons-sharpness-sharpness-6-size-small-16px, .scaling-icons-sharpness-sharpness-6-size-medium-24px, .scaling-icons-sharpness-sharpness-6-size-large-32px,
.scaling-icons-sharpness-sharpness-7-size-x-small-12px, .scaling-icons-sharpness-sharpness-7-size-small-16px, .scaling-icons-sharpness-sharpness-7-size-medium-24px, .scaling-icons-sharpness-sharpness-7-size-large-32px,
.scaling-icons-sharpness-sharpness-8-size-x-small-12px, .scaling-icons-sharpness-sharpness-8-size-small-16px, .scaling-icons-sharpness-sharpness-8-size-medium-24px, .scaling-icons-sharpness-sharpness-8-size-large-32px,
.scaling-icons-sharpness-sharpness-9-size-x-small-12px, .scaling-icons-sharpness-sharpness-9-size-small-16px, .scaling-icons-sharpness-sharpness-9-size-medium-24px, .scaling-icons-sharpness-sharpness-9-size-large-32px,
.scaling-icons-sharpness-sharpness-10-size-x-small-12px, .scaling-icons-sharpness-sharpness-10-size-small-16px, .scaling-icons-sharpness-sharpness-10-size-medium-24px, .scaling-icons-sharpness-sharpness-10-size-large-32px,
.scaling-icons-morale-morale-delighted, .scaling-icons-morale-morale-satisfied, .scaling-icons-morale-morale-dissatisfied, .scaling-icons-morale-morale-unhappy,
.scaling-icons-morale-morale-very-unhappy, .scaling-icons-morale-morale-unknown {
    -unity-background-image-tint-color: #B4B4B4;
    --unity-image-tint-color: #B4B4B4;
}

/* Befestigungen, dezent und nur an kleinen Zetteln: Kaderplanung (Kork) mit zwei Pinnnadeln an den Kacheln,
   Taktiktafel mit einem Magneten an der Spielerliste, Kabine mit Klebeband an der Kaderliste. Angeheftetes hebt
   sich beim Drüberfahren nicht. */
#RecruitmentScreen .control_bar_button {
    background-image: var(--bild-blatt);
    -unity-slice-scale: 0.8;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#RecruitmentScreen .control_bar_button:hover {
    background-image: var(--bild-blatt);
    translate: 0 0;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#TacticalPlannerTool .components-frames-team-selection-table {
    background-image: var(--bild-blatt);
    -unity-slice-scale: 0.8;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#TeamSquadReport .frames-general-view {
    background-image: var(--bild-blatt);
    -unity-slice-scale: 0.8;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Notenkästchen wie im Heft (Jonas 31.10.2026): eckig, fette Heftzahl in Weiß auf der Notenfarbe. FM trennt nur nach
   ganzen Noten (unter 6, 6, 7, 8, 9). Farben gelten hell wie dunkel ("fest" schützt sie vor der Spiegelung). */
.data_display-average_rating-default-default-rating-less-than-6 {
    background-color: #B0453A; /* fest */
    border-radius: 2px;
    border-width: 0;
}
.data_display-average_rating-default-default-rating-6 {
    background-color: #8A8273; /* fest */
    border-radius: 2px;
    border-width: 0;
}
.data_display-average_rating-default-default-rating-7 {
    background-color: #3E9A5C; /* fest */
    border-radius: 2px;
    border-width: 0;
}
.data_display-average_rating-default-default-rating-8, .data_display-average_rating-default-default-rating-9 {
    background-color: #1C8243; /* fest */
    border-radius: 2px;
    border-width: 0;
}
.data_display-average_rating-default-default-rating-less-than-6 SIText, .data_display-average_rating-default-default-rating-6 SIText,
.data_display-average_rating-default-default-rating-7 SIText, .data_display-average_rating-default-default-rating-8 SIText,
.data_display-average_rating-default-default-rating-9 SIText {
    -unity-font-definition: var(--typography-family-thematic);
    font-size: 15px;
}

/* Seit die Blätter einen Schatten tragen, endet das Papier rechts 6 px und unten gut 11 px vor der Elementkante
   (Schattenrand im Bild, SHEET_SHADOW). Der Inhalt rückt mit, sonst liefen Fortschrittsbalken und Kopffotos über
   den Rand (Jonas 31.10.2026). */
.states-templates-tile-content {
    margin-right: 6px;
    margin-bottom: 9px;
}
.report-player-full-header-max-type-player #PersonPictureFrame {
    margin-bottom: 11px;
    overflow: hidden;
}

/* Kalender (Jonas 31.10.2026): Spiele zeigen die Wettbewerbsfarbe (Branding, z. B. Bundesliga-Rot) voll statt
   halb durchsichtig; darüber eine halbe Tintenschicht, so ist weiße Schrift auch auf hellen Wettbewerbsfarben
   lesbar und der Farbton bleibt erkennbar. Nur dort liegt die Farbebene direkt im Rahmen .calendar-event-border;
   Trainings, Jugend- und Länderspiele ohne Wettbewerbsfarbe bleiben Zettel mit Tinte. */
.calendar-event #MiddleLayer {
    opacity: 1;
}
.calendar-event-border > .calendar-event-content, .calendar-event-border > BindingRemapper > .calendar-event-content {
    background-color: #1C1A1680; /* fest */
    border-left-width: 0;
}
.calendar-event-border > .calendar-event-content SIText, .calendar-event-border > BindingRemapper > .calendar-event-content SIText {
}
.calendar-event-border > .calendar-event-content .global-text-secondary {
}
/* Raster samt Wochentagen auf einem Blatt statt halbdurchsichtig über dem Tisch. */
.calendar-max-res.margin-bottom-global-gap-regular {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 8px 14px 14px 8px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.calendar-grid {
    background-color: #00000000;
}
/* Reiterzeile über Werkzeugseiten (Kalender: Allgemein, Training, Begegnungen, Monat; Aufgaben: Übersicht,
   Delegieren): lag frei auf dem Tisch, jetzt ein Papierstreifen. */
.tabbed-grid-layout-tab-button-container-flex-start-centered, .tabbed-grid-layout-tab-button-container-default,
.tabbed-grid-layout-tab-button-container-flex-start, .tabbed-grid-layout-tab-button-container-space-between,
.tabbed-grid-layout-tab-button-container-flex-start-extra-tab-flex-end {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 6px 16px 12px 8px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* In den Einstellungen liegt die Reiterzeile schon auf dem Dialogblatt. */
.preferences-card-tab-padding .tabbed-grid-layout-tab-button-container-flex-start {
    background-image: var(--bild-leer);
    padding: 0;
}
/* Ebenso im Berichtskopf (Gegneranalyse: Übersicht … Kadertiefe): dort lief der Streifen als Band quer über Kopf und
   Wappen, und mit dem Innenabstand rechnete FM die Reiter auf über 6000 px Breite, die meisten lagen außerhalb
   (Jonas 01.11.2026). */
#ReportHeader .tabbed-grid-layout-tab-button-container-default {
    background-image: var(--bild-leer);
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
}
/* Aufgaben › Delegieren: Taktiken und Standards tragen Symbolklassen in mittlerer Grösse, die nur der Code setzt
   (in SIs Blättern gibt es sie nicht, die Symbolliste fand sie deshalb nicht; per Werkstatt gefunden). */
.game-concepts-training-tactics_medium, .game-concepts-training-set-pieces_medium {
    -unity-background-image-tint-color: #E3E1DB;
}
/* Blöcke direkt im Seitenraster (Vereinsgeschichte › Bilanz, Finanzen › Einnahmen/Ausgaben) lagen als halbdurchsichtiges Papier auf dem Tisch
   (--layout-modules-block-surface ist für Blöcke auf einem Blatt gedacht). Dort ein volles Blatt. */
.grid-element--Block > TemplateContainer > .frame-generic-with-padding, .frames-income-breakdown,
/* Mein Profil (Jonas 01.11.2026): dazwischen liegt ein BindingExpect oder ComponentElement */
.grid-element--Block > TemplateContainer > BindingExpect > .frame-generic-with-padding,
.grid-element--Block > TemplateContainer > ComponentElement > .frame-generic-with-padding,
/* Spieler › Transfer und Nation › Wettbewerbe (leer); im Atlas (03.11.2026) die einzigen weiteren Auflagen direkt auf dem
   Tisch, Suche: FM-UI-Atlas, Hintergrund #1C1A1680 ohne Blatt bis zum Tisch */
.grid-element--Block .frame-states-transfer-information,
.grid-element--Block .frame-states-competitions-template-empty {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Trikotnamen im Vereinsprofil: Text- und Grundfarbe setzt der Code je Verein (Heim rot auf Weiss, Auswärts weiss
   auf Blau). Ohne Kontur, im ungedünnten Schnitt. */
#HomeText, #AwayText, #ThirdText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Wettbewerbsregeln unter der Kaderliste: grauer runder Kasten wird eine Fusszeile mit Haarlinie wie im Heft. */
#CollapsedRules.match-rules-property-1-expanded {
    background-color: #00000000;
    border-radius: 0;
    border-top-width: 1px;
    border-top-color: #FDF8ED24;
}
/* Noten-Plaketten (Vorstand: 1+ …): gefüllte Kreise in dunkler Notenfarbe, die Note stand schwarz darauf. Weiss. */
.scaling-icons-grades-circle-large-style-filled SIText, .scaling-icons-grades-circle-regular-style-filled SIText,
.scaling-icons-grades-a-size-large-filled-true SIText, .scaling-icons-grades-a-size-medium-filled-true SIText {
}
/* Karten der Kartenleisten (Ratschläge, Vorstandsanfrage …): Knopf und Auswahlfeld füllten die ganze Karte samt
   Schattenrand, Pfeil und Klickfläche lagen auf der Papierkante (Jonas 31.10.2026). Innen Abstand in Schattenbreite,
   der Pfeil mit etwas Luft. */
VisualElement.control_bar_button {
    padding-right: 6px;
    padding-bottom: 7px;
}
.control-bar-action-dropdown__selection-field .ui-concepts-chevron-down_small {
    margin-right: 8px;
}
/* Tauschmenü oben rechts in jeder Portal-/Übersichtskachel: absolut am rechten Rand der Kachel samt Schattenrand
   (.right-0), der Pfeil sass auf der Papierkante (Jonas 31.10.2026). Nach innen, mit Luft. */
#GridElementControls > #swap-tile-dropdown {
    right: 14px;
    top: 4px;
}
/* Taktikkachel der Übersichten: der gezeichnete Platz fehlte (FMs Bild hinter der Aufstellung). Die Platzskizze
   des Hefts in leichter Perspektive auf der Taktikfläche (ein flacher Platz wirkte auf der breiten Fläche gestaucht),
   die Spielerfiguren etwas grösser. */
.tactics-tile-4x4 {
    background-image: var(--bild-platzschraeg);
    -unity-background-scale-mode: stretch-to-fill;
}
.tactics-tile-4x4 FMPitchIndicator {
    scale: 1.2 1.2;
}
/* Info-Plaketten der Spielerlisten (Vin, Unt, Lai, Trn …): SIs „strong“-Farben sind Neongrün, gespiegelt wurden sie
   fast schwarz (Jonas 31.10.2026: zu dunkel). Mittlere Grüntöne aus SIs „base“-Stufe, weisse Schrift bleibt. */
.player-status.advisory {
    background-color: #1C9457; /* fest */
}
.player-status.advisory-low {
    background-color: #2F9426; /* fest */
}
.player-status.advisory-high {
    background-color: #23864A; /* fest */
}
/* Deaktivierte Primärknöpfe (Bestätigen …) sind hell: Kontur dort in blasser Tinte statt Weiss. */
.buttons-button-primary-default:disabled SIText {
}
/* Kaderregistrierung: die Regelspalte ist breiter als ihr Block (333 in 312 px), die Karten liefen rechts aus dem
   Blatt. Auf Blockbreite. */
.rules-all---ucl > SIVisible {
    width: 100%;
}
/* TransferRoom-Logo in den Kacheln: weisser Schriftzug für dunklen Grund. Dunkel getönt, „Transfer“ druckt in Tinte. */
.transfer-room-logos-tr-long {
    -unity-background-image-tint-color: #C3BFB3;
}
/* Spielersuche: die Filterzeile über der Liste (Filter, Löschen, Suche bearbeiten) lag frei auf dem Kork. Ein
   Papierstreifen wie die Reiterzeilen. */
#PersonSearchFiltersBlock > #search-top-section {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 4px 14px 10px 8px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Grosse Kartensymbole mit einem kleinen Farbtupfer (primäre Taktik, Aufgaben): als „farbig“ vom Tintenblatt
   ausgenommen, standen sie weiss auf Papier. In Tinte. */
.game-concepts-tactic-primary_large, .game-concepts-jobs_large {
    -unity-background-image-tint-color: #E3E1DB;
}
/* Standards: Kürzel der Aufgaben (A1, C2, D1, STA) auf Kategoriefarben und auf den schwarzen Punkten des Platzes,
   auch auf der dunklen Plakette im Ausführer-Knopf (Mitschrift 03.11.2026). */
SIText.set-piece-pitch-text-category-a, SIText.set-piece-pitch-text-category-b, SIText.set-piece-pitch-text-category-c,
SIText.set-piece-pitch-text-category-d, .tactics-speak-to-combo-left #tk-txt,
#tk-box.aerial-threats-property-1-default #tk-txt {
}
/* Daumen hoch/runter (Feedback, Mitteilungen): SIs Neongrün ging auf Papier unter. Heftgrün und Heftrot. */
VisualElement.ui-concepts-thumbs-up_small, VisualElement.ui-concepts-thumbs-up_medium {
    -unity-background-image-tint-color: #2F9426;
}
VisualElement.ui-concepts-thumbs-down_small, VisualElement.ui-concepts-thumbs-down_medium {
    -unity-background-image-tint-color: #B0453A;
}
/* Kreisdiagramm Fantyp: SIs Farben wurden gespiegelt fast schwarz. Mittlere Töne in SIs Reihenfolge (Normalos grün,
   Familien blau, Erfolgsfans weinrot, Geschäftsleute lila, Lässig hellgrün, Ultras orange), passend zur Legende,
   die FM selbst färbt. */
.pie-chart-supporter-profile-colours {
    --chart-colour-1: #2F6B3E; /* fest */
    --chart-colour-2: #2E5FA3; /* fest */
    --chart-colour-3: #8A2F5E; /* fest */
    --chart-colour-4: #9A4FC8; /* fest */
    --chart-colour-5: #3F9A2E; /* fest */
    --chart-colour-6: #B8661E; /* fest */
}
/* Letzter Punkt im Finanzdiagramm: eigenes Element in SIs Lila. */
.data_display-graphs-data_points-medium-circle.data_display-graphs-data_points-medium-circle-purple {
    background-color: #E3E1DB;
}
/* Einträge ohne Wettbewerbsfarbe mit gleichem Rahmen (Jugendspiele, Hinweise, Kaderplaner) tragen zusätzlich
   .tile-default-background: zurück zum Zettel mit Tinte. */
.tile-default-background.calendar-event-border > .calendar-event-content {
    background-color: #FDF8ED12;
    border-left-width: 3px;
    border-left-color: #E3E1DB;
}
.tile-default-background.calendar-event-border > .calendar-event-content SIText {
}
/* Posteingangsliste: ihr eigenes Papier (#Messages, über SIs Code-Farbe) reichte bis an die Elementkante und stand
   unten rechts als zweite Kante über dem Schattenrand des Blatts (Jonas 31.10.2026). Gleicher Einzug wie die
   Kacheln. */
.messages-tile-background #Messages.height-100-percent {
    margin-right: 6px;
    margin-bottom: 9px;
}

/* Kalender (Jonas 31.10.2026): Tageszahlen in den Chips und die Spiele im Trainingskalender stehen auf dunklem bzw.
   wettbewerbsrotem Grund, die Tinte darauf war kaum lesbar. Weiß im ungedünnten Schnitt; nur im Trainingskalender
   und am heutigen Tag (blau), im allgemeinen Kalender stehen die Zahlen ohne Chip auf Papier. */
.calendar-day-training .calendar-day-header SIText, .calendar-day-current .calendar-day-header SIText,
.calendar-training-fixture-element SIText,
.calendar-training-fixture-edit-session-element SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Knöpfe, die ihren Text selbst tragen (SIButton ohne SIText: „Heute“, „In Urlaub gehen“), Eingabefelder und die
   Dateiliste beim Speichern/Laden: Der gedünnte Schnitt ohne Tintenkontur wirkte dort fremd, und in der Hauptschrift
   ist der Unterstrich ein hoher Block (Hover-Trick der Linknamen), Dateinamen wie „HSV_Vor“ zeigten ihn. */
#ActionButtons SIButton, #Today > SIButton {
    -unity-font-definition: var(--schrift-heft-knopf-500); /* Knopfschnitt Figtree 500 (Jonas 10.11.2026) */
}
FMFileBrowser SIText, .report-states-card-states-fm-menu_load-game StreamedTable SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
.bindableeditbox > TextElement {
    -unity-font-definition: var(--schrift-heft-text-400);
}

/* Wochendurchlauf: die linke Spalte (eingehende Nachrichten, nächstes Spiel) war ein grauer Block; SI setzt ihre
   Farbe inline (Nachtblau 40 %), ein Bild liegt darüber. Das Blatt mit Schattenrand ließ sie dort als dunklen Schatten
   durchscheinen (Jonas 02.11.2026); die Spalte liegt ohnehin auf dem Blatt des Dialogs. Daher Papier ohne Rand, das
   deckt, mit feiner Tintenkante. */
ComponentElement#MainFrame.base-template-grow.siblock-border.hide-overflow {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 1px;
    border-color: #1C1A1626; /* fest */
}

/* Laden vor dem Anpfiff („Die Mannschaften wärmen sich auf“, LoadMatchProgressPanel): statt SIs Neonlinien der
   Schreibtisch kurz vor Anpfiff (Spielball, Klemmbrett, Stoppuhr, Pfeife). Das SI-Bild wird unsichtbar, die Szene
   liegt als Hintergrund darunter. Dieselbe Kette beim Spielstand-Laden ist dort ausgeblendet.
   Tönung und Hintergrund am SI-Bild selbst griffen nicht (Jonas' Bildschirmfoto 02.11.2026: Neonbühne, FM setzt das
   Bild per Code). Darum das SI-Bild ganz unsichtbar und die Szene auf seinem Elternelement, das den Schirm füllt
   (100 % x 100 %); BindingRoot.panel-fade mit einer Reihe darunter gibt es nur in LoadMatchProgressPanel. */
BindingRoot.panel-fade > VisualElement.row-direction-normal {
    background-image: var(--bild-anpfiffbild);
    -unity-background-scale-mode: scale-and-crop;
}
BindingRoot.panel-fade > VisualElement.row-direction-normal > SIImage.menu-tile-background {
    opacity: 0;
}

/* Kurz aufblitzende Lade- und Übergangsbilder (Jonas 02.11.2026, aus FMs Vorlagen gesucht, nicht im Spiel gesehen):
   LoadingScreen (#fullscreen-center) füllt den Schirm mit SIs Neonbild und dem pulsierenden FM-Zeichen, etwa beim
   Wechsel vom Startmenü ins Spiel. Bild unsichtbar, der Schreibtisch vom Spielstand-Laden darunter; das Zeichen bleibt. */
#fullscreen-center > VisualElement {
    background-image: var(--bild-ladebild);
    -unity-background-scale-mode: scale-and-crop;
}
#fullscreen-center > VisualElement > SIImage {
    opacity: 0;
}
/* Lichtwarnung beim Start und Controller-Einführung: SIs Neonbild bzw. dunkle Mustertextur hinter dem Blatt. Holz. */
.panel-fade > SIImage#Background {
    --unity-image-tint-color: #00000000;
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: #FFFFFF;
}
/* Ebene unter dem Startmenü (IntroPanelBackground): SIs Startbild, Managerkulisse und die 3D-Kabine als Render-Textur
   blitzten durch, bevor das Startmenü sein Bild malt. Bilder unsichtbar, die 3D-Ebenen durchsichtig, darunter Holz.
   Die Render-Textur des Managers (#ManagerRenderTexture, Avatar beim Anlegen) bleibt. */
#MainMenuBackgroundVisible, #ManagerCreationBackgroundVisible {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
#MainMenuBackgroundVisible > SIImage, #ManagerCreationBackgroundVisible > SIImage {
    opacity: 0;
}
#BackgroundPrerenderTexture, #BackgroundRenderTexture {
    opacity: 0;
}
#PrerenderedVisible, #RenderedVisible {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}

/* Pressekonferenz (Jonas 02.11.2026): statt FMs Presseraum-Foto das Holz bzw. Bütten wie überall; zwischen den
   Journalisten-Kacheln sieht man nur Streifen, ein Raum dort war unruhig. Das Foto liegt nicht in der Pressekonferenz,
   sondern im allgemeinen Spielhintergrund (Werkstatt `punkt` in der offenen Pressekonferenz: Panel#GameWorldBackground
   > #panel_root > Schalter > SIImage#background_image). Foto unsichtbar (FM setzt es per Code), der Untergrund auf dem
   Panel. Gilt für jeden Vollbild-Raum, den FM als Foto zeigt; FMs 3D-Räume (Render-Textur daneben) bleiben. */
#GameWorldBackground SIImage#background_image {
    opacity: 0;
}

/* Spiel: Spielernamen in der Leiste unten sind Linknamen (FM schreibt sie weiß) in SIs Barlow-Klasse ohne Kontur,
   der weiße Kern stand offen. Wie überall der gedünnte Namensschnitt mit Tintenkontur. */
.squad-overview SIText.sitext.condensed-sm-strong {
    /* 16 px: beim Schnitt 400 blieb der weiße Kern stehen (Jonas 01.11.2026), beim gedünnten 300 noch eine feine helle
       Linie (02.11.2026; eine breitere Kontur wirkt nicht, sie ist gedeckelt). Eigener, noch dünnerer Kern. */
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
/* Namensschilder über den Spielern (dunkles, halbdurchsichtiges Schild): Schrift weiß. */
#BindingRoot > SIText.row-direction-normal {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Kommentarleiste: Grund in Vereinsfarbe, die Schrift war Tinte und auf dunklem Rot unlesbar. Weiß mit weichem
   dunklem Schatten (eine Kontur machte den dünnen Schnitt hohl), so trägt sie auch auf Gelb (Karten). */
.match-commentary-bar SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
    text-shadow: 0 1px 3px #000000CC; /* fest */
}
/* Zurufe und Anpassungen im Spiel: SIs dunkles Klappfeld war gespiegelt ein graues Feld mit dunklen Symbolkästen.
   Ein Blatt; die Symbole stehen in Tinte auf einem Hauch Tinte. */
.tactical-tweaks-panel {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
    padding-bottom: 14px; /* die Liste endete unter der Risskante */
}
.tactical-shout-icon-container-dark {
    background-color: #FDF8ED14;
}
.tactical-shout-icon-container-dark SIImage {
    --unity-image-tint-color: #E3E1DB;
}

/* Gezeichnete Platzlinien (Team-News in der Kabine, Taktikkacheln): FM malt sie per Code in --pitch-line-color, SI
   setzt 20 % Grau, auf Papier fast unsichtbar. Tinte zu 40 %; der Selektor-Trick überstimmt SIs gleichnamige Regel. */
* .pitch-lines-fm, #TeamNewsPanel_PredictedFormation {
    --pitch-line-color: #FDF8ED66;
}
/* Kopf der Spielvorschau (eigene Titelleiste von FM): unter dem Papierstreifen lag eine flache graue Fläche; der Tisch
   dort schien als Holzstreifen zwischen dunkler Titelleiste und Papierstreifen durch (Jonas 02.11.2026). Der Ton der
   Titelleiste. */
#TeamSelectionTitleBar > .midnight-background-colour, ComponentElement.midnight-background-colour.main-header-height {
    background-image: none;
    background-color: #2A2722; /* fest */
}

/* Taktik im Spiel: dahinter soll das Spiel bleiben, nicht der Tisch. */
#MatchTactics #Card-frame, #MatchOppositionInstructionsTool #Card-frame, #MatchSetPiecesTool #Card-frame,
#MatchPenaltiesTool #Card-frame, #MatchPenaltyTakersTool #Card-frame {
    background-color: #00000000;
}
/* Ebenso Gegneranweisungen, Standards und Elfmeter im Spiel (Jonas 01.11.2026); der Elfmeter-Name ist geraten. */
#MatchTactics #Card-frame > #Header, #MatchTactics #Card-frame > #GridSafeArea,
#MatchOppositionInstructionsTool #Card-frame > #Header, #MatchOppositionInstructionsTool #Card-frame > #GridSafeArea,
#MatchSetPiecesTool #Card-frame > #Header, #MatchSetPiecesTool #Card-frame > #GridSafeArea,
#MatchPenaltiesTool #Card-frame > #Header, #MatchPenaltiesTool #Card-frame > #GridSafeArea,
#MatchPenaltyTakersTool #Card-frame > #Header, #MatchPenaltyTakersTool #Card-frame > #GridSafeArea {
    background-image: var(--bild-leer);
}
/* Knopfleiste im Spiel (Taktik, Anweisungen, Grundausrichtung, Zurufe, Anpassungen): flaches Grau über dem Rasen.
   Papieretiketten mit Tintenhaarlinie wie im Startbildschirm. */
SIButton.buttons-me-menu-controls-base, SIButton.buttons-me-menu-controls-base--position-leading,
SIButton.buttons-me-menu-controls-base--position-middle, SIButton.buttons-me-menu-controls-base--position-trailing {
    background-color: #201E19;
    border-color: #FDF8ED40;
}
/* Spielfeldinterview: Antwortspalte, Fragezeile und Antwortknöpfe waren flache graue Flächen, der Kopf ein grauer
   Balken. Antwortspalte und Fragezeile werden Blätter, die Antworten Zettel mit Haarlinie, der Kopf ein
   Papierstreifen. */
#SpeakToContainer-Absolute-WontCenter {
    background-color: #00000000;
}
#Container.interaction-_interaction-hub-base-default, .meetings-statement-bar {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.interaction-_interaction-hub-base-default .speakto-frame-sender-message-response {
    background-color: #00000000;
}
SIButton.speakto-body-header-suggestion-button--action-secondary {
    background-color: #1C1A16B3;
    border-width: 1px;
    border-color: #FDF8ED26;
}
/* Kopfleiste über Team-News, Ansprache und Interviews: früher ein Papierstreifen; seit das Titelschild selbst helles
   Papier ist, wie bei den Vollbild-Meldungen durchsichtig (Jonas 02.11.2026). */
#SIVisible_NotShowPhonePanels.midnight-background-colour,
VisualElement#Header.team-talk-header.midnight-background-colour {
    background-color: #00000000; /* fest; Ansprache: der Kopf trägt die Fläche selbst */
    background-image: none;
}

/* Figuren auf gezeichneten Plätzen (Formationskacheln im Spiel, Ergebnis): der Name ist ein Linkname (FM schreibt
   weiß) in SIs Barlow-Klasse ohne Kontur und stand unsichtbar auf dem Papier. Namensschnitt mit Tintenkontur. Das
   Rollenkürzel war breiter als sein dunkler Kasten („SplV“ ragte heraus): kleiner und der Kasten mit Luft. */
FMPitchIndicator #Player SIText#Name {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    font-size: 10px;
}
FMPitchIndicator SIText.tactics-pitch-role-abbreviation {
    font-size: 10px;
    letter-spacing: 0;
}
FMPitchIndicator #PositionContainer {
    padding-left: 2px;
    padding-right: 2px;
}

/* Tabelle neben den Begegnungen (Wettbewerb › Begegnungen): Die Legende (UCL, UEL …) stand auf der Risskante, das
   Blatt hat unten nur seinen Schattenrand. Die Tabelle hat eine feste Höhe (Innenabstand greift nicht), die Legende
   rückt deshalb ein Stück hoch; darüber ist Platz. */
#HasLeagueSwitch WrappedObjectList.wrapped-object-list {
    translate: 0 -16px;
}

/* Wettbewerb › Zu- und Abgänge › Transfers: Der Block liegt direkt im Raster und hatte nur die halbdurchsichtige
   Auflage, der Tisch schien durch, auch im Schattenrand des Blatts. Ein volles Blatt; die Kachel-ID überstimmt SIs gleichnamige
   Regel. */
#CompetitionSiteTransferWindow .frame-states-transfer-window_transfers-template-empty {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Standard- statt Advanced-Textgenerator: SI schaltet alle Knöpfe (.sibutton, also fast jede Kachel und Zeile), Tooltips
   und zwei Diagrammachsen auf Unitys Advanced-Generator (vererbt). Der braucht eine native Schrift, die FMs Skin-Lader
   für Schriften aus Dateien nie anlegt (sourceFontFile fehlt); Unity versuchte es bei jedem Text neu und schrieb je
   Versuch eine Warnung mit Stacktrace ins Player.log, 31 MB in zehn Minuten (31.10.2026). „* “ überstimmt SIs Blatt,
   das nach dem Skin geladen wird. Folge: keine Unterstützung für Rechts-nach-links-Sprachen (die Heftschriften
   haben ohnehin keine arabischen Zeichen). */
* .sibutton, * .sitext-tooltip-text, * .recruitment-budget-charts-x-axis-labels,
* .recruitment-budget-charts-y-axis-labels {
    -unity-text-generator: standard;
}

/* Trainereditor, Aussehen: Tinte stand direkt auf der dunklen 3D-Szene (Jonas, 01.11.2026). Linke Spalte und Kopfzeile
   werden Blätter, die Knöpfe unten Zettel; die Figur rechts bleibt frei. FM setzt die Farbe der Kopfzeile selbst
   (weiß gesetzt blieb sie dunkel), darum Papier statt heller Schrift. */
#ManagerCreationScreen #Options, #ManagerCreationScreen #Header {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    margin-left: 16px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#ManagerCreationScreen #Options {
    padding-top: 6px;
    padding-bottom: 30px;
    margin-top: -14px;
}
#ManagerCreationScreen #Header {
    width: 635px; /* so breit wie #Options */
    margin-top: 16px;
    margin-bottom: 0;
    padding: 18px 28px 22px 28px;
}
#ManagerCreationScreen #save-reset-buttons SIButton.buttons-button-base-default,
#ManagerCreationScreen #save-reset-buttons SIButton.buttons-button-secondary-default {
    background-color: #201E19;
    border-color: #FDF8ED40;
}
#ManagerCreationScreen .manager-creation-menu-text-block SIImage, .game-concepts-coaching-assignment_small {
    --unity-image-tint-color: #E3E1DB;
    -unity-background-image-tint-color: #E3E1DB;
}
/* Trainereditor, Biografie bis Zusammenfassung: flaches Grau über die ganze Fläche. Holz darunter, Eingaben und
   Übersicht je ein Blatt; die Schrittanzeige saß sonst auf der Risskante. */
.manager-creation-main-interaction-panel {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
.manager-creation-lhs-panel, .biography-summary-panel {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 24px 32px 30px 32px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.manager-creation-lhs-panel #step-stepper {
    translate: 0 -26px;
}

/* Karriere beginnen: SIs dunkle 3D-Kulisse (.manager-creator-bg) unsichtbar, Holz darunter, die Kachelreihe auf einem
   Blatt. Erweiterte Einstellungen (Länder, Ligen, Datenbank): Holz und ein Blatt wie bei der Teamwahl. Von der Sitzung
   „Gesichter in Taktikübersicht“ live geprüft (01.11.2026). */
.manager-creator-bg {
    --unity-image-tint-color: #00000000;
    background-color: #00000000;
}
#StartJourneyBackground > BindingRoot, #Background.components-persona-bg {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
.ios-start-journey-container, #MainInteractionPanel.components-persona-bg {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #EBEBEB;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Karriere beginnen: das Blatt füllte den ganzen Schirm (Jonas 01.11.2026). Auf Inhaltsgröße, Holz ringsum. */
#GameCreationStartJourneyScreen .ios-start-journey-container {
    margin-left: 300px;
    margin-right: 300px;
    margin-top: 90px;
    margin-bottom: 90px;
}
/* Mannschaftsauswahl (Schneller Karrierestart): grauer Grund mit Ligabild, links ohne Papier, die Vereinskacheln
   in grellen Vereinsverläufen mit grauer Schrift (Jonas 01.11.2026). Holz, alles auf einem Blatt, die Kacheln
   Papier; der Vereinsverlauf bleibt als feiner Rand stehen. */
#GameCreationQuickStart > BindingRoot.midnight {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
#GameCreationQuickStart SIImage#LeagueBackground {
    opacity: 0;
}
#GameCreationQuickStart #NonPhone {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #EBEBEB;
    margin-left: 18px;
    margin-right: 18px;
    margin-bottom: 8px;
    padding-top: 18px;
    padding-bottom: 16px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#GameCreationQuickStart SIButton.club-selector-preset-button {
    background-color: #25221D;
}
/* Spieleinrichtung: fester Nachtblau-Grund, Titel und Knöpfe unten waren Tinte darauf (Jonas 01.11.2026). Holz,
   der Titel hell auf dem Holz, die Knöpfe Papieretiketten. */
#GameCreationGameSummaryScreen > BindingRoot.midnight {
    background-color: #00000000;
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
#GameCreationGameSummaryScreen #StartingClubAndDateSummary SIText#Title {
}
#GameCreationGameSummaryScreen #NavButtons .buttons-button-secondary-default {
    background-color: #1C1A16E6;
    border-width: 1px;
    border-color: #FDF8ED40;
}
/* Trainerprofile (Auswahl vor dem Spielstart): flaches Grau. Holz, die Auswahl ein Blatt, die Knöpfe Zettel. Nur das
   äußere Element: #container gibt es auch in jeder Trainerkarte und Tendenzzeile. */
#GameCreationManagerSelectionScreen > BindingRoot {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
#GameCreationManagerSelectionScreen .manager-selection-padding-48 > ComponentElement {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 28px 36px 40px 36px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#GameCreationManagerSelectionScreen SIButton.buttons-button-base-default,
#GameCreationManagerSelectionScreen SIButton.buttons-button-secondary-default {
    background-color: #201E19;
    border-color: #FDF8ED40;
}
/* Eilmeldung zum Amtsantritt: SIs Kopf ist ein dunkler Verlauf (Bild und Verlauf setzt FM selbst), die Tinte darauf
   war unlesbar. Helle Schrift wie im Fernsehen. */
#BreakingNewsContentNonPhone #Manager SIText {
    text-shadow: 0 1px 3px #000000CC; /* fest */
}
/* Trainingskalender und Spielplan lagen ohne Blatt direkt auf dem Holz (fussballromantiker, 01.11.2026). Nur dort: der
   allgemeine Kalender hat sein Blatt schon (.calendar-max-res oben), ein zweites schnitt die letzte Reihe ab. Im
   Training das äußere Element samt Wochentagen; ein inneres .calendar-max-res hat kein .flex-grow-class. */
#CalendarTraining ComponentElement.calendar-max-res.flex-grow-class, #CalendarFixtures .calendar-grid {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    padding-top: 12px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Spiele der eigenen Mannschaft ohne Wettbewerbsebene (Testspiel, Serie A): FM schreibt Name und Gegner per Rich-Text
   weiß und setzt die Knopffläche selbst; ohne Fläche stand Weiß auf Papier. Die halbe Tinte liegt darum eine Ebene
   tiefer, auf dem Behälter. */
.calendar-event-border #FixtureBackground.calendar-event {
    background-color: #1C1A16B3; /* fest */
}
/* Trainingseinheiten nach Art farbig (@kloppo71, 01.11.2026): gespiegelt waren alle Flächen gleich blass und der
   Taktikstrich grau, nur Spielvorbereitung stach blau heraus. Je Art eine helle Fläche im Ton ihres Strichs, Taktik
   grün. SIGradient im Selektor, sonst gewinnt SIs gleichnamige Regel aus dem später geladenen Blatt. */
SIGradient.calendar-training-gradient-physical-and-recovery { --start-colour: #59251A; --end-colour: #461E13; }
SIGradient.calendar-training-gradient-footballing-development { --start-colour: #5B2042; --end-colour: #2C2A23; }
SIGradient.calendar-training-gradient-tactical-understanding {
    --start-colour: #20351C;
    --end-colour: #292620;
    --calendar-training-border-colour: #2E8B57; /* fest */
}
SIGradient.calendar-training-gradient-match-preparation { --start-colour: #1D345A; --end-colour: #2C2922; }
SIGradient.calendar-training-gradient-extra-curricular { --start-colour: #402B0D; --end-colour: #34230A; }
SIGradient.calendar-training-gradient-rest { --start-colour: #322F27; --end-colour: #2A2821; }
SIGradient.calendar-training-gradient-travel { --start-colour: #39362D; --end-colour: #2F2C25; }
/* Voraussichtliche Aufstellung (Gegneranweisungen) und vereinfachte Taktiktafel: FM schreibt die Namen per Rich-Text
   weiß auf dunkle Chips, die Tintenkontur der Heftschrift machte sie unlesbar (Chat, 01.11.2026). */
.tactics-simplified-position-indicator-bottom SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Team-News und Spielkopf (Heim – Gast über Aufstellung und Gegneranweisungen): FM schreibt Titel, Gegner und
   Wettbewerb weiß, auf dem Kabinenfoto und auf dem Holz unlesbar (Chat, 01.11.2026). Ein dunkel getöntes Blatt als
   Streifen darunter, die Schrift bleibt hell (helles Papier ließ die weißen Links verschwinden). */
#BindingExpect_TopBarMatch VisualElement#TopBar.row-direction-normal {
    min-height: 64px; /* die Unterzeile lief unten aus dem Schild (Jonas 02.11.2026) */
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #FFFFFF;
    padding: 4px 18px 8px 14px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Helles Papier statt dunklem Schild (Jonas 02.11.2026, seit die graue Kopfleiste durchsichtig ist und das Schild auf
   dem Holz liegt): die von FM weiß gesetzten Texte drucken im Tintenkern, der Titel kräftiger. */
#BindingExpect_TopBarMatch #TopBar SIText {
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
#BindingExpect_TopBarMatch #TopBar SIText#PanelTitleText {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Teamkürzel der Anzeigetafel: FM färbt sie je nach Trikot selbst (auf hellen Kästen dunkel), die helle Kontur der
   Tafelschrift machte sie trotzdem weiß, auf hellem Kasten unlesbar (fussballromantiker, 01.11.2026). Ungedünnter
   Schnitt ohne Kontur, dann zeigt sich FMs eigene Farbe. */
.fm-scoreboard #ClubHomeTeamText, .fm-scoreboard #ClubAwayTeamText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Kategorien im Posteingang (J B, 01.11.2026): ohne Kontur blieb vom gedünnten Schnitt nur ein blasser Strich in SIs
   hellen Kategorietönen. Kräftige Töne, die Kontur in derselben Farbe gibt das Gewicht. */
.message-tag-blue SIText.message-tag-text {}
.message-tag-cyan SIText.message-tag-text {}
.message-tag-green SIText.message-tag-text {}
.message-tag-induction SIText.message-tag-text {}
.message-tag-magenta SIText.message-tag-text {}
.message-tag-navy SIText.message-tag-text {}
.message-tag-orange SIText.message-tag-text {}
.message-tag-purple SIText.message-tag-text {}
.message-tag-default SIText.message-tag-text {}
/* Taktische Effektivität (henri_l1898, 01.11.2026): SI färbt die Kreise je Stufe (.tactical-effectiveness-radial-1
   bis -10); heft-regeln setzt aber für jeden Kreis ein gespiegeltes Grün (.siradialgauge), das die Stufen
   überdeckte, alles wirkte grün. Feste Ampel von Rot über Gelb nach Grün, mit doppelter Klasse stärker. */
.siradialgauge.tactical-effectiveness-radial-1 { --current-colour: #C8372D; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-2 { --current-colour: #D4532A; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-3 { --current-colour: #DE7428; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-4 { --current-colour: #E3962C; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-5 { --current-colour: #D9B52A; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-6 { --current-colour: #BDBE2E; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-7 { --current-colour: #97B436; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-8 { --current-colour: #6AA53C; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-9 { --current-colour: #3B9341; /* fest */ }
.siradialgauge.tactical-effectiveness-radial-10 { --current-colour: #1F7A42; /* fest */ }
/* Dieselbe Ampel für die Effektivitätsbalken in Tabellen (gefüllte Stufen .gauge-step--selected.tactical-effectiveness-N,
   Jonas 04.11.2026: alle Balken gleich dunkeltürkis, SIs „ondark“-Skala war gespiegelt). */
.gauge-step--selected.tactical-effectiveness-1, .gauge-step-large--selected.tactical-effectiveness-1 { background-color: #C8372D; /* fest */ }
.gauge-step--selected.tactical-effectiveness-2, .gauge-step-large--selected.tactical-effectiveness-2 { background-color: #D4532A; /* fest */ }
.gauge-step--selected.tactical-effectiveness-3, .gauge-step-large--selected.tactical-effectiveness-3 { background-color: #DE7428; /* fest */ }
.gauge-step--selected.tactical-effectiveness-4, .gauge-step-large--selected.tactical-effectiveness-4 { background-color: #E3962C; /* fest */ }
.gauge-step--selected.tactical-effectiveness-5, .gauge-step-large--selected.tactical-effectiveness-5 { background-color: #D9B52A; /* fest */ }
.gauge-step--selected.tactical-effectiveness-6, .gauge-step-large--selected.tactical-effectiveness-6 { background-color: #BDBE2E; /* fest */ }
.gauge-step--selected.tactical-effectiveness-7, .gauge-step-large--selected.tactical-effectiveness-7 { background-color: #97B436; /* fest */ }
.gauge-step--selected.tactical-effectiveness-8, .gauge-step-large--selected.tactical-effectiveness-8 { background-color: #6AA53C; /* fest */ }
.gauge-step--selected.tactical-effectiveness-9, .gauge-step-large--selected.tactical-effectiveness-9 { background-color: #3B9341; /* fest */ }
.gauge-step--selected.tactical-effectiveness-10, .gauge-step-large--selected.tactical-effectiveness-10 { background-color: #1F7A42; /* fest */ }
/* Taktische Anweisungen (Mit Ball/Ohne Ball, im Spiel und im Taktikbildschirm): SIs Zeichnungen sind weiße Linien mit
   farbigen Akzenten für dunklen Grund, auf Papier sah man nichts (Chat, 01.11.2026). Jede Zeichnung liegt auf einer
   kleinen dunkelgrünen Taktiktafel. */
#IconArea.center-align-and-justify-children {
    background-color: #2F4636; /* fest */
    border-radius: 4px;
}
/* Wiederholungsleiste im Spiel (Drei-Punkte-Menü, Jonas 02.11.2026): SIs nachtblaues Fenster mit runden Ecken und
   hellem Rahmen, darin dunkle Knöpfe. Ein Zettel wie die anderen Bedienfelder im Spiel: das Blatt, die Knopfgruppe mit
   feiner Tintenkante, Knöpfe ohne Fläche, Symbole und „Live“ in Tinte. */
/* SI setzt Fläche und Rahmen des Fensters per Code (Nachtblau, runde Ecken): das Fenster unsichtbar, sein Inhalt
   sichtbar; das Blatt liegt auf dem Inhalt und reicht über die Innenabstände des Fensters. */
BindingRoot.margin-right-global-gap-extra-large.padding-horizontal-global-padding-extra-large {
    visibility: hidden;
}
BindingRoot.margin-right-global-gap-extra-large.padding-horizontal-global-padding-extra-large > ContextShortcutsElement {
    visibility: visible;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    margin: -16px -14px -16px -14px;
    padding: 16px 14px 18px 14px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
ContextShortcutsElement > VisualElement.row-direction-always-normal {
    border-color: #1C1A1640; /* fest */
    border-radius: 2px;
}
/* Knöpfe: ohne Fläche; die gesperrten (SI dimmt sie über den Sperrzustand) bleiben sichtbar, etwas heller. */
ContextShortcutsElement SIButton.sibutton.buttons-me-match-controller-base--position-leading,
ContextShortcutsElement SIButton.sibutton.buttons-me-match-controller-base--position-middle,
ContextShortcutsElement SIButton.sibutton.buttons-me-match-controller-base--position-trailing {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-color: #1C1A1626; /* fest */
}
ContextShortcutsElement SIButton.sibutton.buttons-me-match-controller-base--position-leading:hover,
ContextShortcutsElement SIButton.sibutton.buttons-me-match-controller-base--position-middle:hover,
ContextShortcutsElement SIButton.sibutton.buttons-me-match-controller-base--position-trailing:hover {
    background-color: #1C1A1614; /* fest */
}
ContextShortcutsElement SIEnabled.unity-disabled, ContextShortcutsElement .unity-disabled {
    opacity: 1;
}
ContextShortcutsElement SIButton.sibutton VisualElement {
    --unity-image-tint-color: #E3E1DB;
}
ContextShortcutsElement .unity-disabled SIButton.sibutton VisualElement {
    -unity-background-image-tint-color: #8C8370; /* fest */
}
ContextShortcutsElement SIButton.sibutton SIText.sitext {
}
/* Ergebniskopf (Halbzeit, Spielergebnis): Wappen und Vereinsnamen auf SIs dunklem Verlauf; das Ergebnis setzt FM
   selbst dunkel, es verschwand (fussballromantiker, 01.11.2026). Ein Papierzettel dahinter (Jonas). Der dunkle Verlauf ist ein Geschwister des Inhalts, Ketten über .entity-background-header greifen nicht. */
SIText#IsMatch.heading-xxl {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 2px 18px 6px 18px;
    margin: 0 10px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Halbzeit/Spielende (Jonas 02.11.2026): der Kopf lag als dunkler Verlauf über dem Holz, die Vereinsnamen in Tinte
   darauf kaum lesbar. Der ganze Kopf ein Blatt: SIs Spielkarte und Verlauf darin unsichtbar, alle Texte in Tinte. */
#BindingExpect_MatchResult VisualElement#Background.entity-background-header {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#BindingExpect_MatchResult VisualElement#Background.entity-background-header > * {
    opacity: 0;
}
#BindingExpect_MatchResult .secondary-text-colour, #BindingExpect_MatchResult .global-text-secondary SIText {
}
/* Trainernamen unter den Vereinen: weißer <color>-Tag (Links), Namensschnitt mit Tintenkern. Nur der Auswärtstrainer
   trägt .content-ellipsis; der Heimtrainer stand deshalb weiß (Jonas 04.11.2026). Über die Teamblöcke beide. */
#BindingExpect_MatchResult #HomeTeam SIText.secondary-text-colour,
#BindingExpect_MatchResult #AwayTeam SIText.secondary-text-colour {
    -unity-font-definition: var(--schrift-heft-dunkel-400);
}
#BindingExpect_MatchResult .global-text-secondary * {
    -unity-background-image-tint-color: #57503F; /* fest */
}
/* Vereinsnamen dort: SI schreibt sie als weißen <color>-Tag in die Heftschrift (auf dem Blatt unsichtbar). Wie im Kopf
   der Gegneranalyse der Namensschnitt mit Tintenkern. */
#BindingExpect_MatchResult SIText#ClubName.thematic-xl {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Einblendungen im Spiel (Tor, Wechsel, Karte): neben dem Streifen in Vereinsfarbe zwei Zeilen, die die Spiegelung
   zu Weiß auf hellem Verlauf und Tinte auf Schwarz verdrehte; Torschütze und Vorlagengeber waren unlesbar (Chat,
   fussballromantiker, 01.11.2026). Der Textteil wird ein Zettel, die Namen drucken in Tinte. */
#BindingExpect_GoalScoredPopup #RootElement > .margin-left-global-gap-small,
#BindingExpect_SubsPopup #RootElement > .margin-left-global-gap-small,
#BindingExpect_CardPopup #RootElement > .margin-left-global-gap-small {
    background-color: #FDF8ED; /* fest */
    border-width: 1px;
    border-color: #FDF8ED40;
}
#BindingExpect_GoalScoredPopup #RootElement > .margin-left-global-gap-small VisualElement,
#BindingExpect_SubsPopup #RootElement > .margin-left-global-gap-small VisualElement,
#BindingExpect_CardPopup #RootElement > .margin-left-global-gap-small VisualElement {
    background-color: #00000000;
}
#BindingExpect_GoalScoredPopup SIText, #BindingExpect_SubsPopup SIText, #BindingExpect_CardPopup SIText {
}
/* Premier-League-Einblendungen (Tor, Karte, aberkanntes Tor): hinter der Namenszeile liegt ein Verlauf aus dem Code
   (#NameBackgroundGradient), links schwarz; Vorname und Rückennummer standen in PL-Lila darauf unlesbar (Discord,
   Torgrafik Nottingham Forest, Jonas 10.11.2026). Ohne ihn liegt die Zeile auf SIs weißem PL-Grund. */
SIGradient#NameBackgroundGradient {
    visibility: hidden;
}
/* Aktiver Reiter der Vereinsleiste: SI setzt ihn in die Haupttextfarbe, gespiegelt Tinte, auf dunkler Vereinsfarbe
   unsichtbar (der aktive Bereich fehlte oben). Auf dunkler Leiste weiß; auf heller (.nav-on-light) bleibt Tinte. */
#MainNav.nav-on-dark .buttongroup__button--active SIText {
}
/* FMPedia: SI zeichnet einen dunkelblauen Verlauf (Farben aus dem Code) über das Blatt, Tinte war darauf unlesbar. Bis
   10.11.2026 deckte ihn flache graue Farbe, Jonas: „nicht unser Stil“. Jetzt die Papierfaser des Blatts (das Blatt
   darunter zeichnet FM bei diesem Fenster nicht, mit unsichtbarem Verlauf blieb nur Leere); Kopf mit Haarlinie,
   Überschriften in Barlow, Inhaltsknöpfe im Knopfschnitt. */
.ios-fmpedia-card-fullscreen > #header, .ios-fmpedia-card-fullscreen > #body_container {
    background-color: rgba(0, 0, 0, 0); /* fest */
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
}
.ios-fmpedia-card-fullscreen > #header {
    border-bottom-width: 1px;
    border-color: #FDF8ED26;
}
#FMPediaRoot SIText#fmpedia_header_title {
    -unity-font-definition: var(--typography-family-thematic);
}
#FMPediaRoot SIText#introduction_title_text, #FMPediaRoot SIText#content_title_text {
    -unity-font-definition: var(--schrift-heft-eng-600);
}
#FMPediaRoot SIText.fmpedia-text-cell {
    -unity-font-definition: var(--schrift-heft-knopf-500);
    font-size: 14px;
}
/* Lesezeichen (Aufklappfenster der zweiten Leiste, Jonas 10.11.2026): flache graue Fläche mit Rahmen, Symbole in Tinte
   auf SIs fast schwarzem Kästchen. Jetzt ein Blatt, Symbole frei in Tinte, Einträge im Knopfschnitt. */
ComponentElement.bookmark-edit-panel {
    background-color: rgba(0, 0, 0, 0); /* fest */
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
}
.bookmark-edit-panel VisualElement#IconHolder.badge-icon-regular-sink {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
.bookmark-edit-panel SIText#EditBookmarkItemText {
    -unity-font-definition: var(--schrift-heft-knopf-500);
    font-size: 15px;
}
/* Transferübersicht (Wettbewerb): SIs Kasten halb weiß auf dem Blatt, wirkte wie ein Fremdkörper (Jonas 10.11.2026).
   Ein Hauch Tinte mit Haarlinie wie die übrigen Felder auf dem Blatt. */
VisualElement#Frame.transfer-overview-tiles {
    background-color: #FDF8ED08;
    border-width: 1px;
    border-color: #FDF8ED24;
    border-radius: 0;
}
/* Pfeile zu Untermenüs in Aufklappmenüs: weiße Bilder ohne Farbregel, auf Papier unsichtbar (Jonas, 01.11.2026). */
.indicator.indicator-right-arrow, .indicator.indicator-left-arrow {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}
/* Vertragsverhandlung (Janjani03, 01.11.2026): nach dem Abschicken sperrt FM die Angebotsfläche mit halber
   Deckkraft, das Blatt wurde durchscheinend und das Holz kam durch; ein Blatt eine Ebene tiefer hält sie weiß.
   Die Antwortblasen des Beraters hatten nur einen dünnen farbigen Rand: jetzt Fläche und Strich in Grün, Rot oder
   Gelb, Zustimmung und Ablehnung auf einen Blick. */
#NegotiationBindingExpect > #BlockRemapper {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
VisualElement.speech-bubble-positive-colour {
    background-color: #1F2E15; /* fest */
    border-color: #2E7D32; /* fest */
    border-left-width: 3px;
}
VisualElement.speech-bubble-negative-colour {
    background-color: #542216; /* fest */
    border-color: #B23A2B; /* fest */
    border-left-width: 3px;
}
VisualElement.speech-bubble-minor-warning-colour {
    background-color: #332709; /* fest */
    border-color: #B7861C; /* fest */
    border-left-width: 3px;
}
VisualElement.speech-bubble-major-warning-colour {
    background-color: #44270F; /* fest */
    border-color: #C0562A; /* fest */
    border-left-width: 3px;
}
/* Kopfleiste der Vertragsbedingungen (Spieler: #terms-block-top-bar, Mitarbeiter: #Frame): SIs Nachtblau lag als grauer
   Kasten auf dem Blatt (Jonas 04.11.2026: „muss einfach weg“). Flach, nur eine Haarlinie darunter. */
#terms-block-top-bar.frames-terms-block-top-bar, VisualElement#Frame.frames-terms-block-top-bar {
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-color: #FDF8ED26;
}
/* In der Transferverhandlung setzt FM das Nachtblau der Leiste per Code; nur ein Bild deckt es: die flache Papierfläche
   (Mitschrift 04.11.2026, Bild 043: Haarlinie griff, Fläche blieb). */
VisualElement#Frame.frames-terms-block-top-bar {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
}
/* Gehaltsfeld: Pfeil im Feld weiß, Plus und Minus nackte Zeichen ohne Knopf (Jonas 04.11.2026). Pfeil in Tinte, Plus
   und Minus als kleine umrandete Knöpfe wie die übrigen Felder. */
VisualElement.si-combobox__preview-element-chevron {
    -unity-background-image-tint-color: #E3E1DB;
}
SIButton.si-combobox__button.sibutton {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: #FDF8ED66;
    border-radius: 3px;
    margin-left: 4px;
    width: 28px;
    -unity-font-definition: var(--schrift-heft-text-400);
    -unity-font-style: bold;
    font-size: 16px;
}
SIButton.si-combobox__button.sibutton:hover {
    background-color: #FDF8ED14;
}
/* Gesprächsspalte rechts (Verhandlung): die Blase des Gegenübers grau, die Hauptaktion („Verhandeln“, „Vertrag
   abschließen“) ein blauer Block, „Verhandlungen abbrechen“ ein grauer Kasten (Jonas 04.11.2026). Blase als heller
   Zettel, Hauptaktion mit gelbem Textmarker wie „Zur Aufstellung“, die übrigen Aktionen flach mit Haarlinie. */
VisualElement#BubbleBackground.speech-background-type-npc-message {
    background-color: #26241E; /* fest */
    border-width: 1px;
    border-color: #FDF8ED40;
}
TemplateContainer.speakto-optional-interaction-primary-button,
VisualElement#DataContainer.speakto-button-interaction-button-choices-primary {
    background-color: rgba(0, 0, 0, 0);
}
VisualElement#DataContainer.speakto-button-interaction-button-choices-primary {
    background-image: var(--bild-marker);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin: 6px 10px;
}
VisualElement#DataContainer.speakto-button-interaction-button-choices-primary SIText {
}
VisualElement#DataContainer.speakto-button-interaction-button-choices-primary VisualElement,
VisualElement#DataContainer.speakto-button-interaction-button-choices-primary SIImage {
    --unity-image-tint-color: #E3E1DB;
}
TemplateContainer.speakto-optional-interaction-button {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-color: #FDF8ED26;
}
/* Farbwähler (Einstellungen > Farben bearbeiten, fussballromantiker 01.11.2026): FM setzt die Kartenfläche selbst
   dunkelblau, Titel und RGB-Felder waren unlesbar. Der Innenabstand wandert ins Kind, das als Papier deckt. */
.sipopup-container #Card.row-direction-normal {
    padding: 0;
    border-color: #FDF8ED40;
}
.sipopup-container #Card.row-direction-normal > VisualElement {
    background-color: #201E19; /* fest */
    padding: 13px;
}
/* Kopf der Nationalmannschaft: Name, Kennzahlen und letzte Spiele lagen frei auf dem Holz (Jonas, 01.11.2026); eine
   Karte wie bei Vereinen. Hier liegt kein VisualElement unter dem Verlauf, sondern ein SISafeAreaElement, darum
   greift die Vereinsregel oben nicht. */
#report-national-team-full-header-max {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-top: 6px;
    margin-left: 16px;
    margin-right: 16px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Mannschaftssitzung: die untere Hälfte jeder Spielerkarte setzt FM selbst dunkelblau, Name und Charakter standen in
   Tinte darauf (selbst gesehen 01.11.2026). Nur diese beiden hell; die Stimmungsmarke darunter behält ihre Farben. */
.tiles-players-meetings-cell #player > SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
.tiles-players-meetings-cell #player > SIText.global-text-secondary {
}
/* Teambericht des Scouts (Posteingang): die Spielkarte oben trägt einen dunklen Vereinsverlauf, Vereinsnamen und Plätze
   standen in Tinte darauf (selbst gesehen 01.11.2026). Bei gebrandeten Wettbewerben (Premier League) liegt auch die
   Wettbewerbszeile mit Anstoß und Datum auf Dunkel (Jonas 02.11.2026): alle Texte der Karte hell, Symbole ebenso. */
#TeamReport_FixtureHeader .padding-top-global-padding-regular SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
#TeamReport_FixtureHeader .padding-top-global-padding-regular > VisualElement.row-direction-normal * {
    -unity-background-image-tint-color: #FFFFFF; /* fest */
    --unity-image-tint-color: #FFFFFF;
}
/* Taktik im Spiel (Jonas 01.11.2026): die Teamanweisungen lagen ohne Papier über dem Spielfeld. Die ganze Karte
wird ein Blatt; die Anweisungskacheln heben sich beim Hover nicht (der Schatten stand hart auf der Karte); die
   Reiter oben (Taktik,
Standards,
Elfmeter,
Gegneranweisungen) bekommen einen Papierzettel; auf der Taktiktafel
   stehen Namen und Rollen weiß auf dem Rasen. */
#MatchTactics #Body > BindingRemapper > .grid-element--Block,
#TacticalPlannerTool #Body > BindingRemapper > .grid-element--Block,
#FullScreenTeamSelection #Body > BindingRemapper > .grid-element--Block {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Innen keine weiteren Blätter: Papier auf Papier gab doppelte Risskanten und Schatten (Jonas). Die Kacheln sind
flache Felder mit Haarlinie. */
#MatchTactics #Body .grid-element--Block .grid-element--Block,
#TacticalPlannerTool #Body .grid-element--Block .grid-element--Block,
#FullScreenTeamSelection #Body .grid-element--Block .grid-element--Block,
#MatchTactics #Body .grid-element--Block .layout-block-base-container,
#TacticalPlannerTool #Body .grid-element--Block .layout-block-base-container,
#FullScreenTeamSelection #Body .grid-element--Block .layout-block-base-container,
#MatchTactics #Body .grid-element--Block .siblock-border,
#TacticalPlannerTool #Body .grid-element--Block .siblock-border,
#FullScreenTeamSelection #Body .grid-element--Block .siblock-border {
    background-image: var(--bild-leer);
    background-color: #00000000;
}
#MatchTactics .layout-tile-interaction-button.layout-tile-interaction-button-background,
#TacticalPlannerTool .layout-tile-interaction-button.layout-tile-interaction-button-background,
#FullScreenTeamSelection .layout-tile-interaction-button.layout-tile-interaction-button-background,
#MatchTactics .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#TacticalPlannerTool .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#FullScreenTeamSelection .layout-tile-interaction-button.layout-tile-interaction-button-background:hover {
    background-image: var(--bild-leer);
    background-color: #FDF8ED08;
    border-width: 1px;
    border-color: #FDF8ED26;
    border-radius: 3px;
    translate: 0 0;
    rotate: 0deg;
}
#MatchTactics .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#TacticalPlannerTool .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#FullScreenTeamSelection .layout-tile-interaction-button.layout-tile-interaction-button-background:hover {
    background-color: #FDF8ED14;
}
#TopBarTacticsButtonGroup #ButtonGroup {
    background-color: #201E19; /* fest */
    border-width: 1px;
    border-color: #FDF8ED40;
    border-radius: 3px;
}
#TopBarTacticsButtonGroup SIText {
}
FMTacticsWithPhases FMPitchIndicator SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
}
#team-instruction-header .sink_containment,
#TacticalPlannerTool #Body .sink_containment,
#FullScreenTeamSelection #Body .sink_containment,
#MatchTactics #Body .sink_containment {
    background-color: #00000000;
    border-width: 0;
}
/* Die drei Spalten der Taktikkarte (Tafel, Anweisungen, Übersicht) liegen ohne Rahmen und Fläche auf dem Blatt
(Jonas: einheitlich,
„die Begrenzungen der Innenkästen braucht es nicht“). */
#MatchTactics #Body .grid-element--Block .grid-element--Block,
#TacticalPlannerTool #Body .grid-element--Block .grid-element--Block,
#FullScreenTeamSelection #Body .grid-element--Block .grid-element--Block {
    background-color: #00000000;
    border-width: 0;
}
/* Waagerechte Scrollleiste unter den Anweisungskacheln: die Kacheln passen, die Leiste stand nur als grauer Strich
   da (Jonas). Höhe null, weil die Scrollansicht display selbst setzt. */
#TeamInstructionsBlock .unity-scroller--horizontal {
    height: 0;
    min-height: 0;
    opacity: 0;
}
#MatchTactics #Body .grid-element--Block .grid-element--Block .border-color-layout-modules-block-border-colour,
#TacticalPlannerTool #Body .grid-element--Block .grid-element--Block .border-color-layout-modules-block-border-colour,
#FullScreenTeamSelection #Body .grid-element--Block .grid-element--Block .border-color-layout-modules-block-border-colour {
    border-width: 0;
}
/* Stufenbalken der taktischen Effektivität: der gewählte Strich nimmt dieselbe Skala wie die Kreise; gespiegelt war
   er immer gleich dunkel (Jonas 01.11.2026). */
.stepper-step--selected.tactical-effectiveness-1 { background-color: #C8372D; /* fest */ }
.stepper-step--selected.tactical-effectiveness-2 { background-color: #D4532A; /* fest */ }
.stepper-step--selected.tactical-effectiveness-3 { background-color: #DE7428; /* fest */ }
.stepper-step--selected.tactical-effectiveness-4 { background-color: #E3962C; /* fest */ }
.stepper-step--selected.tactical-effectiveness-5 { background-color: #D9B52A; /* fest */ }
.stepper-step--selected.tactical-effectiveness-6 { background-color: #BDBE2E; /* fest */ }
.stepper-step--selected.tactical-effectiveness-7 { background-color: #97B436; /* fest */ }
.stepper-step--selected.tactical-effectiveness-8 { background-color: #6AA53C; /* fest */ }
.stepper-step--selected.tactical-effectiveness-9 { background-color: #3B9341; /* fest */ }
.stepper-step--selected.tactical-effectiveness-10 { background-color: #1F7A42; /* fest */ }
/* Standards: im Kopf (Art, Szenario, Variante) lag ein blauer Vereinsverlauf über dem Blatt (Jonas). Er ist ein
   Geschwister des Inhalts und lässt sich ausblenden. */
.border-color-layout-modules-block-border-colour > SIGradient.sigradient {
    opacity: 0;
}
/* Knopfbeschriftungen, die direkt im Knopf stehen (Ratschlag anwenden, Alle Vorschläge umsetzen, Teamanweisungen
   entfernen …): SI gibt ihnen den gedünnten Namensschnitt ohne Kontur, sie wirkten dünn und fremd (Jonas). Der
   ungedünnte Heftschnitt; Kind-Texte mit eigener Klasse behalten ihre Regel. */
SIButton.buttons-button-base-default, SIButton.buttons-button-primary-default, SIButton.buttons-button-secondary-default {
    -unity-font-definition: var(--schrift-heft-knopf-500); /* Figtree 500 wie die Knopfregel der Schrifthierarchie (Jonas 10.11.2026) */
}
/* Wertungskasten ohne Wertung (Gegner vor dem ersten Spiel): FM zeigt einen Strich, weiß mit Tintenkontur verschwand
   er auf dem grauen Kasten (Jonas). */
.data_display-average_rating-default-default-rating-null Label {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Taktik im Spiel, ruhiger (Jonas 01.11.2026): Tafel, Ersatzbank und Aufstellungstabelle sind außerhalb des Spiels
eigene Blätter auf dem Tisch; auf dem großen Blatt der Spieltaktik gaben sie Risskanten auf Papier. Hier flache
   Felder ohne Rahmen wie die Anweisungsspalten. */
#MatchTactics .tactics-collapsable-pitch-container,
#TacticalPlannerTool .tactics-collapsable-pitch-container,
#FullScreenTeamSelection .tactics-collapsable-pitch-container,
#MatchTactics .tactics-collapsable-pitch-container-with-darker-header,
#TacticalPlannerTool .tactics-collapsable-pitch-container-with-darker-header,
#FullScreenTeamSelection .tactics-collapsable-pitch-container-with-darker-header,
#MatchTactics .tactics-subs-block,
#TacticalPlannerTool .tactics-subs-block,
#FullScreenTeamSelection .tactics-subs-block,
#MatchTactics .components-frames-team-selection-table,
#TacticalPlannerTool .components-frames-team-selection-table,
#FullScreenTeamSelection .components-frames-team-selection-table {
    background-image: var(--bild-leer);
    background-color: #00000000;
    border-width: 0;
}
/* Leiste „Regeln – Testspiel | Keine Spieltagsregeln“ unter der Tabelle: ohne Regeln sagt sie nichts (Jonas). Gibt
   es Spieltagsregeln, zeigt FM einen anderen Zweig des Schalters, der bleibt. */
#hasRulesSwitch > #noRules {
    height: 0; /* display setzt der Schalter selbst, die Höhe nicht */
    min-height: 0;
    padding: 0;
    margin: 0;
    border-width: 0;
    overflow: hidden;
}
/* Das Blatt hat einen Rand aus Schnittkante und Schatten; die Knöpfe unten rechts (Bestätigen) ragten darüber
hinaus (Jonas). Innenabstand bis zur Papierkante. */
#MatchTactics #Body > BindingRemapper > .grid-element--Block,
#TacticalPlannerTool #Body > BindingRemapper > .grid-element--Block,
#FullScreenTeamSelection #Body > BindingRemapper > .grid-element--Block {
    padding-left: 6px;
    padding-right: 8px;
    padding-bottom: 8px;
    -unity-slice-scale: 0.5; /* schmalere Schnittkante, wie die Blätter der Taktiktafel */
}
/* Teamanweisungen der Taktikübersicht: FM rechnet die drei Spalten 27 px höher als den Platz auf der Karte, sie
   ragten unten über die Risskante (Jonas). Begrenzt auf die Kartenhöhe; die Spalten scrollen selbst. */
#TacticalPlannerTool #TeamInstructionsTabGrid .si-tile {
    max-height: 688px;
}
/* Die Übersichtsspalte rechts ist ein eigener Blockrahmen mit Blatt: heller als die beiden anderen Spalten. */
#MatchTactics #Body .grid-element--Block .border-color-layout-modules-block-border-colour,
#TacticalPlannerTool #Body .grid-element--Block .border-color-layout-modules-block-border-colour,
#FullScreenTeamSelection #Body .grid-element--Block .border-color-layout-modules-block-border-colour {
    background-image: var(--bild-leer);
    background-color: #00000000;
}
/* Spielerkärtchen auf der Taktiktafel: der weiße Namensteil trägt links, rechts und unten einen dunklen Rand, die
   Rollenleiste darüber nicht; das sah nach Versatz aus (Jonas). Kein Rand am Namensteil, dafür eine Haarlinie um
   das ganze Kärtchen. */
.tactics-visualiser-player-bottom-border {
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
}
.layout-tile-interaction_border_tactics {
    border-width: 1px;
    border-color: #FDF8ED59;
}
/* Aktive taktische Anpassungen: die Symbole auf den dunklen Plaketten waren teils Tinte, teils weiß (Jonas). */
.tactical-tweak-row__icon-badge, .tactical-tweak-row__icon-badge * {
    -unity-background-image-tint-color: #FFFFFF; /* fest */
    --unity-image-tint-color: #FFFFFF; /* fest */
}
/* Spielerstatus „Gelb“ (und andere Warnungen) in der Aufstellungstabelle: SI meint Gelb, gespiegelt wurde die
   Plakette dunkel (Jonas). Gelb mit Tinte; Gelbe Karten selbst ebenso. */
.player-status.warning, .yellow-card {
    background-color: #F2C200; /* fest */
}
.player-status.warning SIText, .yellow-card-text {
}
/* Körpersprache (Aufstellung im Spiel): alle Plaketten grau auf Papier (Jonas). Nach Stimmung gefärbt: Grün gut,
   Papier neutral, Orange bis Rot schlecht, Lila selbstzufrieden, Blau traurig. */
.body-language-very-positive-background-colour { background-color: #1F7A42; /* fest */ }
.body-language-positive-background-colour { background-color: #3B9341; /* fest */ }
.body-language-slightly-positive-background-colour { background-color: #6AA53C; /* fest */ }
.body-language-neutral-background-colour, .body-language-none-background-colour,
.body-language-mixed-background-colour { background-color: #382F19; /* fest */ }
.body-language-slightly-negative-background-colour { background-color: #E3962C; /* fest */ }
.body-language-negative-background-colour { background-color: #DE7428; /* fest */ }
.body-language-very-negative-background-colour { background-color: #C8372D; /* fest */ }
.body-language-angry-background-colour { background-color: #A12B23; /* fest */ }
.body-language-complacent-background-colour { background-color: #7A5C99; /* fest */ }
.body-language-sad-background-colour { background-color: #3D6A9E; /* fest */ }
/* Schrift auf den Plaketten nach Kontrast (Jonas 10.11.2026: „da muss alles lesbar sein“): Weiß nur auf den dunklen
   (Dunkelgrün, Rot, Lila, Blau, je über 5:1), auf Grün, Hellgrün und Orange Tinte (4,5 bis 7:1; Weiß hatte dort 2,4 bis
   3,9). Dark wiederholt diese Farben in tonpapier_uss (heft_test.py), weil der Dark-Bau Textfarben ohne eigene Fläche
   entfernt. */
.body-language-very-positive-text-colour, .body-language-very-negative-text-colour, .body-language-sad-text-colour {
    -unity-font-definition: var(--schrift-heft-text-400);
}
.body-language-positive-text-colour, .body-language-slightly-positive-text-colour,
.body-language-slightly-negative-text-colour, .body-language-negative-text-colour {
    -unity-font-definition: var(--schrift-heft-text-400);
}
.body-language-neutral-text-colour, .body-language-none-text-colour, .body-language-mixed-text-colour {
}
/* Mannschaftssitzung: dieselben Plaketten, der Text darin trägt dort keine Körpersprache-Klasse und blieb grau auf
   der hellen Plakette (Jonas). Text nach der Plakette, nicht nach seiner eigenen Klasse. */
.body-language-very-positive-background-colour SIText, .body-language-very-negative-background-colour SIText,
.body-language-angry-background-colour SIText, .body-language-complacent-background-colour SIText,
.body-language-sad-background-colour SIText {
}
.body-language-positive-background-colour SIText, .body-language-slightly-positive-background-colour SIText,
.body-language-slightly-negative-background-colour SIText, .body-language-negative-background-colour SIText {
}
.body-language-neutral-background-colour SIText, .body-language-none-background-colour SIText,
.body-language-mixed-background-colour SIText {
}
/* TransferRoom (Anforderungen, Antworten): der große Block nimmt die Auflage (halbes Papier) wie innere Felder und
   lag ohne Blatt halb durchsichtig auf dem Holz (Jonas). Er wird ein Blatt. */
.transfer-in-property-1-club-adverts-property-2-user {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
}
/* Mitarbeiterwerte (Ungeeignet bis Weltklasse) wie die Wertfelder der Spieler (Jonas 01.11.2026): dieselbe fette
   Zahlenschrift und dieselben Farben wie die Attributfarben im LIESMICH (FM-Einstellung, die der Skin für Spieler
   nicht erreicht; hier sind es Skin-Klassen). Doppelte Klasse, weil SIs Feldklasse den Grund leert. */
SIText.data_display-coaching_ratings-small {
    -unity-font-definition: var(--typography-family-thematic);
    font-size: 14px; /* logische Pixel, wachsen mit FMs Oberflächenskalierung */
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 3px;
    -unity-text-align: middle-center;
}
/* Acht Stufen, jede unterscheidbar (Jonas): Ungeeignet unter Schlecht, Weltklasse über Sehr gut. */
SIText.data_display-coaching_ratings-small.coaching-rating-elite {
    color: #FFFFFF; /* fest */
    background-color: #0E5129; /* fest */
}
SIText.data_display-coaching_ratings-small.coaching-rating-outstanding {
    color: #FFFFFF; /* fest */
    background-color: #197A3E; /* fest */
}
SIText.data_display-coaching_ratings-small.coaching-rating-very-good {
    color: #FFFFFF; /* fest */
    background-color: #3E9A5C; /* fest */
}
SIText.data_display-coaching_ratings-small.coaching-rating-good {
    color: #553600; /* fest */
    background-color: #F1CD84; /* fest */
}
SIText.data_display-coaching_ratings-small.coaching-rating-average {
    color: #1C1A16; /* fest */
    background-color: #EADFC2; /* fest */
    border-width: 1px;
    border-color: #FDF8ED22;
}
/* FMs Reihenfolge unten: Ungeeignet (unsuited) < Sehr schlecht (reasonable) < Schlecht (competent). */
SIText.data_display-coaching_ratings-small.coaching-rating-competent {
    color: #57503F; /* fest */
    background-color: #D6CFC1; /* fest */
}
SIText.data_display-coaching_ratings-small.coaching-rating-reasonable {
    color: #7A3A2E; /* fest */
    background-color: #EBD3CA; /* fest */
}
SIText.data_display-coaching_ratings-small.coaching-rating-unsuited {
    color: #6E1F17; /* fest */
    background-color: #E2B9AE; /* fest */
}
/* Biografie ohne Bild: FM setzt den Namen weiß in ein Feld in Vereinsfarbe, das Feld liegt hier hell (Jonas). */
#IsStaff SIText.text-middle-center, #IsPlayer SIText.text-middle-center {
}
/* Eignung beim Ziehen auf der Taktiktafel (Ringe und Texte an den Positionen): gespiegelt waren alle sieben Stufen
   fast schwarzes Oliv auf dem Rasen, nicht zu unterscheiden (Jonas 01.11.2026). Hell genug für den Rasen, Grün über
   Gelb nach Rot. */
.tactics-visualiser-player-suitability-natural { border-color: #5FD872; -unity-background-image-tint-color: #5FD872; /* fest */ }
.tactics-visualiser-player-suitability-accomplished { border-color: #B0E05A; -unity-background-image-tint-color: #B0E05A; /* fest */ }
.tactics-visualiser-player-suitability-competent { border-color: #F0DE55; -unity-background-image-tint-color: #F0DE55; /* fest */ }
.tactics-visualiser-player-suitability-unconvincing { border-color: #F7B955; -unity-background-image-tint-color: #F7B955; /* fest */ }
.tactics-visualiser-player-suitability-awkward { border-color: #F4924A; -unity-background-image-tint-color: #F4924A; /* fest */ }
.tactics-visualiser-player-suitability-makeshift { border-color: #F06A48; -unity-background-image-tint-color: #F06A48; /* fest */ }
.tactics-visualiser-player-suitability-poor { border-color: #E8524A; -unity-background-image-tint-color: #E8524A; /* fest */ }
.tactics-visualiser-player-suitability-natural-text {}
.tactics-visualiser-player-suitability-accomplished-text {}
.tactics-visualiser-player-suitability-competent-text {}
.tactics-visualiser-player-suitability-unconvincing-text {}
.tactics-visualiser-player-suitability-awkward-text {}
.tactics-visualiser-player-suitability-makeshift-text {}
.tactics-visualiser-player-suitability-poor-text {}
/* Der Ring um das Spielerkärtchen beim Ziehen: dicker, damit die Eignung auf den ersten Blick auffällt (Jonas). */
.frame-330-tactics-visualiser-player-indicator {
    border-width: 3px;
}
/* Beim Ziehen markiert FM die passenden Spieler in der Aufstellungstabelle; gespiegelt war das Grau (Jonas: bläulich). */
.tactics-row-highlight-highlighted {
    background-color: #5B9BD54D; /* fest */
}
/* Leihen, wo FM eine Klasse setzt (Jonas: geliehen hellblau, verliehen hellrot). Namen, die FM per Code färbt,
   erreicht der Skin nicht; der Tintenkern macht sie dunkel. Die Kontur nimmt hier die Farbe mit. */
.player-on-loan-colour {
}
.loaned-out-color .cell-primary-text {
}
/* Hoverkarte des Spielers: die Wertetafel lag als heller Kasten (Auflage) auf dem Kartenblatt (Jonas). Ohne Fläche
   und Rahmen. */
.sitooltip VisualElement.frames-player-attributes-full-block-size-min-player-attributes-property-3-compact {
    background-color: #00000000;
    border-width: 0;
}
/* Kleine Platzgrafik bei „Positionelle Fähigkeit“: ohne Rasen standen nur Punkte da und liefen in den Text (Jonas).
   Ein grüner Platz darunter, etwas Abstand nach unten. */
.tactics-accent-pitch-container-positional-ability {
    background-color: #3F7D4A; /* fest */
    border-radius: 2px;
    margin-bottom: 4px;
}
/* Multiplayer-Einstellungen (Zahnrad › Einstellungen): die Seite liegt auf einer fest dunkelblauen Fläche, die
   Tintentexte waren unlesbar (Jonas 01.11.2026). Ein Blatt. */
#OnlineCareerPreferences #layout-card-and-interaction-default-default > VisualElement.align-items-start {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Lesezeichen rechts in der zweiten Leiste: der Papierstreifen ragt 18 px über den Bildschirm, der Block klebt an
   seinem rechten Rand, der Pfeil lief aus dem Bild (Jonas 01.11.2026). */
#Bookmarks.bookmarks-area-large-width {
    margin-right: 22px;
}
/* Starker und schwacher Fuß (Spielerprofil): die sechs Striche trugen eine Farbe für alle Stufen (Jonas
   01.11.2026). Rot (sehr schwach) über Gelb nach Grün (sehr stark); SIs Klassen heissen verdreht, very-low ist
   die beste Stufe. */
#FootednessL .data_display-graphs-stepper-step_indicator-type-checked-size-small-very-high, #FootednessR .data_display-graphs-stepper-step_indicator-type-checked-size-small-very-high { background-color: #C8372D; /* fest */ }
#FootednessL .data_display-graphs-stepper-step_indicator-type-checked-size-small-high, #FootednessR .data_display-graphs-stepper-step_indicator-type-checked-size-small-high { background-color: #DE7428; /* fest */ }
#FootednessL .data_display-graphs-stepper-step_indicator-type-checked-size-small-above-average, #FootednessR .data_display-graphs-stepper-step_indicator-type-checked-size-small-above-average { background-color: #D9B52A; /* fest */ }
#FootednessL .data_display-graphs-stepper-step_indicator-type-checked-size-small-below-average, #FootednessR .data_display-graphs-stepper-step_indicator-type-checked-size-small-below-average { background-color: #97B436; /* fest */ }
#FootednessL .data_display-graphs-stepper-step_indicator-type-checked-size-small-low, #FootednessR .data_display-graphs-stepper-step_indicator-type-checked-size-small-low { background-color: #3B9341; /* fest */ }
#FootednessL .data_display-graphs-stepper-step_indicator-type-checked-size-small-very-low, #FootednessR .data_display-graphs-stepper-step_indicator-type-checked-size-small-very-low { background-color: #1F7A42; /* fest */ }
/* Veränderungspfeile neben den Attributen: Bilder mit eingebranntem Hellgelb, auf Papier kaum zu sehen (Jonas).
   Eine Tönung multipliziert, der Farbton bleibt, das Bild wird dunkler. */
.attributes-row-number SIImage.ui-concepts-placeholder-size-small {
    --unity-image-tint-color: #8A8A8A;
    -unity-background-image-tint-color: #8A8A8A;
}
/* Verletzungsgrafik: die Körpersilhouetten sind weisse Bilder, auf Papier unsichtbar (Jonas 01.11.2026). Getönt in
   Papiergrau; die verletzte Stelle (eigenes Bild in Gefahrenfarbe) bleibt darüber. */
#InjuryBackgroundFront, #InjuryBackgroundBack {
    -unity-background-image-tint-color: #5E5444; /* fest */
    opacity: 1;
}
#InjuryBackground {
    opacity: 1; /* SI legt die Silhouetten halb durchsichtig an */
}
/* Ohne aktive Verletzung (Fitnessübersicht in Nachrichten, Jonas 02.11.2026) malt #InjuryBackground die Silhouette
   selbst (.special-icons-injury-special-injury-default), ebenso die Grundsilhouetten der wiederkehrenden Verletzungen;
   dieselbe Tönung wie oben. */
#InjuryBackground.special-icons-injury-special-injury-default,
#InjuryBackground .special-icons-injury-special-injury-silhouett-base-front,
#InjuryBackground .special-icons-injury-special-injury-silhouett-base-back {
    -unity-background-image-tint-color: #5E5444; /* fest */
}
/* Spielkopf in Nachrichten (Gegneranalyse, Spielbericht): grosse Vereinsnamen und Ergebnis zeigten einen weissen
   Kern, der Wettbewerbsname war blass (Jonas 01.11.2026). Kräftigerer Schnitt, breitere Tintenkante. */
SIText#ClubName.heading-xl, SIText#IsMatchResultLinkableText.heading-xxl {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
SIText#ClubText.heading-md {
}
/* Schlüsselerkenntnisse der Gegneranalyse (Lufthoheit, Kreativität …): SIs pinke Akzentschrift, gespiegelt ein
   fremdes Blau in der Fliesstextschrift. Heft-Überschrift in Heftblau. */
SIText#Title.thematic-md.tifo-text-brand-highlight-pink {
    -unity-font-definition: var(--typography-family-thematic);
    font-size: 17px;
}
/* Scoutbericht: Spielernamen unter den Trikots auf dem dunklen Rasen standen in Tinte. */
SIText.tactics-report-pitch-name {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Ergebnis auf den News-Kacheln (geteiltes Vereinsbild, dunkel): stand in Tinte (Jonas 01.11.2026); große Kacheln nutzen
   40 px (Jonas 02.11.2026). */
#Clubs > SIText#static_text.fm-universe-20px, #Clubs > SIText#static_text.fm-universe-40px {
}
/* Im Kopf eines Nachrichtenartikels (Spielbericht im Posteingang) liegt dieselbe Ergebniszeile auf Papier: Tinte
   (Jonas 02.11.2026). */
.news-story-block-header-foreground-content-area #Clubs > SIText#static_text.fm-universe-20px,
.news-story-block-header-foreground-content-area #Clubs > SIText#static_text.fm-universe-40px {
}
/* Wettbewerbstitel im Seitenkopf (30 px): weisser Kern sichtbar (Jonas 01.11.2026, Weltmeisterschaft). */
SIText.ios-fm-universe-title.fm-universe-xlarge-30px {
}
/* Helle Vereinsfarben (FM setzt .nav-on-light): Symbole rechts in der Leiste (FMPedia, Welt, Einstellungen,
   Lesezeichen) und die Pfeile links waren durch das Spiegeln weiss auf hell, nur beim Darüberfahren sichtbar
   (Kloppo, Jonas 01.11.2026). Tinte wie SI es vorsieht. */
#MainNav.nav-on-light .nd-flat-black {
}
#MainNav.nav-on-light .ui-concepts-chevron-left_small, #MainNav.nav-on-light .ui-concepts-chevron-right_small,
#MainNav.nav-on-light .dashboard-hud-manager-dropdown .ui-concepts-chevron-down_small {
}
/* Spielplan anderer Mannschaften (Reserve, Jugend, fremde Vereine): rechts liegt die Spielkarte auf einem dunklen
   Kalenderzettel mit Vereinsverlauf, Datum und Stadion waren Tinte darauf (Jonas 01.11.2026, U23 Atalanta). Der Kopf
   wird hell wie das Blatt, die von FM weiss gesetzten Vereinsnamen drucken im Tintenkern. */
#BindableSwitchElement_Fixture > #Header > #Background.entity-background-header {
    background-color: #FDF8ED0A;
    border-bottom-width: 1px;
    border-color: #FDF8ED26;
}
#BindableSwitchElement_Fixture #Background .calendar-fixture-card, #BindableSwitchElement_Fixture #Background > SIGradient {
    opacity: 0;
}
/* Spielkopf der Wettbewerbs- und Spielseiten (Kachel „Match Preview Header“, Vorlage MatchPreviewCardHeader): bei
   Wettbewerben ohne eigene Ebenenklasse (Coppa Italia) malte SI Ebenen und Verlauf in Wettbewerbsfarbe, ein
   nachtblaues Band mit Tinte darauf (Jonas 11.11.2026). Wie im Spielplan: Ebenen und Verlauf unsichtbar. */
.calendar-fixture-card-border > #Background .calendar-fixture-card,
.calendar-fixture-card-border > #Background > SIGradient {
    opacity: 0;
}
#BindableSwitchElement_Fixture SIText.fixture-card-team-name {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Kalender im Wochendurchlauf (und gleiche Kacheln): Spiele liegen auf dunklen Zetteln, Wettbewerb, Heim/Auswärts
   und Ergebnis standen in Tinte darauf (Jonas 01.11.2026). Hell, ohne Kontur. */
.calendar-event-content-tile SIText#CompName, .calendar-event-content-tile SIText#Venue.calendar-line-height-16,
.calendar-event-content-tile SIText#Result.calendar-line-height-16,
.calendar-event-content-tile SIText#Time.calendar-line-height-16 {
    -unity-font-definition: var(--schrift-heft-text-400);
}
/* Vereinsseite (und andere Seiten mit diesem Kopf): Kopf und die fünf Kacheln darunter lagen ohne Blatt auf dem
   Holz, die Infozeile rechts grau darauf, die Kacheln halb durchsichtig (Jonas 02.11.2026). Der ganze Kopf wird
   eine Papierkarte wie im Spielerprofil, die Kacheln flache Felder darauf; der von FM weiss gesetzte Vereinsname
   druckt im Tintenkern. */
/* Das Blatt sitzt auf dem inneren Bereich: dort ist der Abstand links und rechts gleich (Jonas: rechts lief es bis
   an den Rand, links brach es vorher ab). Die Kacheln ohne Rahmen und Fläche, bei „Nächstes Spiel“ lagen zwei
   ineinander. */
.ios-site-header > .sigradient > #NonPhoneLayout > SISafeAreaElement {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    padding: 10px 18px 12px 18px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.ios-site-header > .sigradient > #NonPhoneLayout VisualElement.border-radius-global-border-extra-small {
    background-color: #00000000;
    border-width: 0;
}
.ios-site-header SIText.thematic-xl.fm-club-primary-color {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Taktikseiten (vor dem Spiel, Übersicht, im Spiel): die drei Spalten sind höher als der Platz auf dem Blatt und
   ragten unten über die Kante (Jonas 02.11.2026). Begrenzt; die Anweisungen scrollen, die Tafel wird kürzer. */
#FullScreenTeamSelection #TeamInstructionsTabGrid BlockElement.grid-element--Block,
#TacticalPlannerTool #TeamInstructionsTabGrid BlockElement.grid-element--Block,
#MatchTactics #TeamInstructionsTabGrid BlockElement.grid-element--Block {
    max-height: 688px;
    overflow: hidden;
}
#FullScreenTeamSelection #TeamInstructionsTabGrid BindingRemapper#pitch-remapper,
#TacticalPlannerTool #TeamInstructionsTabGrid BindingRemapper#pitch-remapper,
#MatchTactics #TeamInstructionsTabGrid BindingRemapper#pitch-remapper {
    max-height: 676px;
}
/* Team-News vor dem Spiel: hinter den Blättern links und rechts liegt eine dunkle Kachel (Farbe per Code), sie schien
   am Rand des Blatts durch; die voraussichtliche Aufstellung war weiss auf Papier (Jonas 02.11.2026). Die Blätter
   decken ganz, die Aufstellung liegt auf Rasen. */
#TeamNewsPanel VisualElement#TeamNews, #TeamNewsPanel VisualElement#StaffAdvice {
    background-color: rgba(0, 0, 0, 0); /* fest */
    /* Die Flächenfarbe füllte den Schattenrand des Blatts: ein heller Kasten mit geraden Kanten über der Blattkante
       (Jonas 02.11.2026). Randloses, deckendes Papier mit feiner Kante statt Blatt + Fläche. */
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 1px;
    border-color: #1C1A1633; /* fest */
}
/* Ratschlag-Karte darin: als Block bekam sie ein eigenes Blatt mit Schatten auf dem Papier; ohne. */
#TeamNewsPanel #StaffAdvice StreamedObjectList.streamed-list-view.border-color-layout-modules-block-border-colour {
    background-image: var(--bild-leer);
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
}
#TeamNewsPanel #PredictedFormation FMTacticsPanel {
    background-color: #3F7D4A; /* fest */
    border-radius: 3px;
}
/* Zurück/Vor im dunklen Titelschild vor dem Spiel (Team-News, Ansprache): Pfeile in Tinte auf Dunkel (Jonas). */
#BindingExpect_TopBarMatch VisualElement#TopBar .ui-concepts-chevron-left_small,
#BindingExpect_TopBarMatch VisualElement#TopBar .ui-concepts-chevron-right_small {
    -unity-background-image-tint-color: #E3E1DB; /* fest; Tinte auf dem hellen Schild */
}
#BindingExpect_TopBarMatch VisualElement#TopBar SIButton#BackButton.sibutton,
#BindingExpect_TopBarMatch VisualElement#TopBar SIButton#ForwardButton.sibutton,
#BindingExpect_TopBarMatch VisualElement#TopBar SIButton#BackButton.sibutton:hover,
#BindingExpect_TopBarMatch VisualElement#TopBar SIButton#ForwardButton.sibutton:hover {
    background-color: rgba(0, 0, 0, 0); /* fest; ohne Kachel, nur Pfeile (Jonas 02.11.2026) */
    border-width: 0;
}
/* Mannschaftsansprache, Interviews, Gespräche (alle Antwort-Blätter): hinter dem Blatt liegt eine dunkle Kachel
   (Farbe per Code), sie schien am Rand durch; im Titelschild lief die Unterzeile unten aus dem Kasten (Jonas 02.11.2026). Blatt deckend, Titel
   eine Stufe kleiner. */
VisualElement#Container.interaction-_interaction-hub-base-default.align-items-stretch {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
}
/* Die dunkle Kachel darunter (#SpeakToContainer, Farbe und runde Ecken per Code) unsichtbar, ihr Inhalt sichtbar: das
   Antwort-Blatt bleibt unser Blatt mit Kante und Schatten, ohne dunklen Rand und ohne helle Fläche im Blattrand
   (Jonas 02.11.2026). */
VisualElement#SpeakToContainer-Absolute-WontCenter {
    visibility: hidden;
}
VisualElement#SpeakToContainer-Absolute-WontCenter > * {
    visibility: visible;
}
/* Ansprache-Sätze: keine Kästen auf dem Blatt, nur eine Haarlinie zwischen den Sätzen; beim Darüberfahren ein Hauch. */
.interaction-_interaction-hub-base-default SIButton.speakto-body-header-suggestion-button--action-secondary {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #1C1A1626; /* fest */
    border-radius: 0;
}
.interaction-_interaction-hub-base-default SIButton.speakto-body-header-suggestion-button--action-secondary:hover {
    background-color: #1C1A160D; /* fest */
}
/* Rechte Seite (Kader): SIs halbdurchsichtige Fläche mit Rahmen lag als zweiter Kasten im Blatt. */
ComponentElement.frame-states-full-screen-team-talk-template-given {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
}
#BindingExpect_TopBarMatch SIText#PanelTitleText.thematic-lg {
    font-size: 19px;
}
/* Spielerporträts (Jeff, DF11 Faces, 02.11.2026): SI legt einen runden grauen Grund hinter jedes Gesicht, ausgeschnittene
   Köpfe standen auf einer Scheibe. Ohne Grund und Rahmen; die runde Beschneidung der kleinen Bilder macht FM im
   Programm, die erreicht kein Skin. Typ vorangestellt, weil heft-regeln dieselben Klassen färbt. */
TemplateContainer.thumbnails-alt-person-picture-club-property-1-32px,
TemplateContainer.thumbnails-alt-person-picture-property-1-16px,
TemplateContainer.thumbnails-alt-person-picture-property-1-24px,
TemplateContainer.thumbnails-alt-person-picture-property-1-32px,
TemplateContainer.thumbnails-alt-person-picture-property-1-44px,
TemplateContainer.thumbnails-alt-person-picture-property-1-person_picture_alt,
TemplateContainer.thumbnails-alt-person-picture-property-1-variant2,
TemplateContainer.thumbnails-alt-person-picture-property-1-variant3,
TemplateContainer.thumbnails-person-picture-job-player-sex-male,
TemplateContainer.thumbnails-person-picture-job-player-sex-male-player-1,
VisualElement.thumbnails-alt-person-picture-club-property-1-32px,
VisualElement.thumbnails-alt-person-picture-property-1-16px,
VisualElement.thumbnails-alt-person-picture-property-1-24px,
VisualElement.thumbnails-alt-person-picture-property-1-32px,
VisualElement.thumbnails-alt-person-picture-property-1-44px,
VisualElement.thumbnails-alt-person-picture-property-1-person_picture_alt,
VisualElement.thumbnails-alt-person-picture-property-1-variant2,
VisualElement.thumbnails-alt-person-picture-property-1-variant3,
VisualElement.thumbnails-person-picture-job-player-sex-male,
VisualElement.thumbnails-person-picture-job-player-sex-male-player-1 {
    border-radius: 0;
    background-color: #00000000;
    border-width: 0;
}
.person-picture-circle-frame {
    border-width: 0;
    background-color: #00000000;
}

/* Fortfahren (Jonas 02.11.2026): ein schlichter Papierzettel mit Tintenschrift (Karo passte im Spiel nicht), das Wort
   mit gelbem Textmarker angestrichen (ohne Strich zu unauffällig); beim Darüberfahren zieht der Strich bis zu den
   Pfeilen. SI malt den Knopf blau mit lila Rand
   (.continue-button), je Wettbewerb in eigenen Farben, darüber einen wandernden Verlauf und ein Pulsieren; alles aus.
   Der Strich liegt auf der Verlaufsebene (füllt den Knopf), Text und Pfeile darüber. */
#ContinueButton #comp-specific-background-image {
    display: none;
}
SIButton#continue-button.continue-button, SIButton#continue-button.continue-button:hover {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 1px;
    border-color: #5A503C;
    border-radius: 2px;
}
SIButton#continue-button.continue-button:hover {
    border-color: #ADA48D;
}
#continue-button SIGradient {
    --start-colour: #FFFFFF00;
    --end-colour: #FFFFFF00;
    opacity: 0;
}
#continue-button #NotContinuedPulseOverlay, #continue-button #continue-button-background {
    opacity: 0;
}
#continue-button SIText#text {
    color: #2A2722; /* fest */
    font-size: 16px;
    background-image: var(--bild-marker);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-left: -7px;
    margin-top: -3px;
    margin-bottom: -3px;
}
#continue-button:hover SIText#text {
    background-image: none;
}
#continue-button Sliding#continue-button-gradient {
    opacity: 0;
}
#continue-button:hover Sliding#continue-button-gradient {
    opacity: 1;
    background-image: var(--bild-marker);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    left: 8px;
    right: 8px;
    top: 7px;
    bottom: 7px;
}
#continue-button #primary-icon-image, #continue-button #primary-icon * {
    -unity-background-image-tint-color: #D4D1C8;
    --unity-image-tint-color: #D4D1C8;
}
/* Muss beantwortet werden (Jonas 02.11.2026): „An Pressekonferenz teilnehmen“ und Ähnliches. SI deckelt die Breite
   des Textfelds per Code (Inline-Stil) auf das, was neben dem Symbol Platz hat; in unserer Schrift läuft der lange
   Text darüber hinaus ins Symbol, und der Strich am Text endete mitten im Satz. Das Symbol fällt weg, der Strich liegt
   wie beim Darüberfahren über dem ganzen Knopf (macht die Pflicht zugleich auffälliger). */
/* SIVisible setzt seine Anzeige selbst; ausgeblendet wird das Kind darin. */
SIButton#continue-button.continue-button---must-respond #primary-icon-visible > BindingSetter {
    display: none;
}
SIButton#continue-button.continue-button---must-respond SIText#text {
    background-image: none;
}
SIButton#continue-button.continue-button---must-respond Sliding#continue-button-gradient {
    opacity: 1;
    background-image: var(--bild-marker);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    left: 8px;
    right: 2px; /* der lange Text reicht fast bis an den Rand */
    top: 7px;
    bottom: 7px;
}

/* Posteingang (Jonas 02.11.2026): ungelesene Nachrichten tragen links neben der Uhrzeit einen Punkt, den SI per Code
   weiß malt (eine Flächenfarbe aus USS greift nicht); auf dem Blatt unsichtbar. Ein Bild liegt über der Codefarbe:
   die Papierfläche, in Füllertinte getönt. */
MessagesStreamedObjectList SIVisible > VisualElement#icon {
    background-image: var(--bild-flaeche);
    -unity-background-image-tint-color: #0F5C8F;
}

/* Trainingskalender (Jonas 02.11.2026): die Datumsplaketten sind dunkel, ihre Zahlen hell, nur im Trainingsmenü (der
   allgemeine Kalender bleibt, wie er ist). Die Einheiten als Heftkärtchen, eckig statt rund. */
#TrainingScreen .calendar-date-labels-default-property SIText {
}
#TrainingScreen SIGradient.sigradient.calendar-training-session-gradient-element,
#TrainingScreen SIButton.sibutton.calendar-training-session-button-element {
    border-radius: 0;
}

/* Vereinsleiste (Jonas 02.11.2026): die Menüpunkte stehen frei auf der Vereinsfarbe (Zettel je Punkt oder ein
   durchgehender Zettel wirkten überladen). Rechts hängt ein Zettel von oben in die Leiste, darauf Suche und Symbole,
   Datum und Fortfahren in Tinte, durch Haarlinien getrennt; so bleiben sie auch auf weißen Vereinsfarben lesbar.
   Gleiche Faser und Kante wie die übrigen Zettel (das Blatt, oben abgeschnitten); ein negativer Abstand schiebt die
   Oberkante aus dem Bild. Das Wappen klebt leicht schräg auf einem eigenen Zettel, als Blickfang (eine Form nach dem
   Wappen geht nicht: FM setzt es per Code, USS kennt keine Umrissmaske); das Menü rückt dafür etwas nach rechts. */
#MainNav #GlobalNavigationTutorialAnchor {
    margin-left: 22px;
}
#MainNav #ClubBadgeStyleSetter {
    rotate: -5deg;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    padding-left: 7px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 8px;
    margin-top: -4px;
    margin-bottom: -4px;
}
/* Der Behälter hat bei SI eine feste Höhe (48); Innenabstand allein drückte die Inhalte zusammen und hob die ganze
   Leiste an. Höhe um den Überstand größer, oben gleich viel Innenabstand wie negativer Außenabstand: nur das Papier
   reicht über die Oberkante, Inhalte und Leiste bleiben, wo SI sie hinsetzt. */
#MainNav #NonDiegeticContainer {
    background-image: var(--bild-haengeblatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    height: 70px;
    min-height: 70px;
    max-height: 70px;
    margin-top: -22px;
    padding-top: 16px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 12px;
}
/* Datum und Fortfahren liegen auf dem Zettel: ohne eigenes Papier, links eine Haarlinie. */
#MainNav #CurrentDayTutorialAnchor, #MainNav #ContinueButtonTutorialAnchor {
    border-left-width: 1px;
    border-left-color: #FDF8ED40;
    padding-left: 14px;
    margin-left: 4px;
}
.nav-on-dark .navigation-primary-nav-calendar-wiget-calendar, #MainNav .navigation-primary-nav-calendar-wiget-calendar,
#MainNav .navigation-primary-nav-calendar-wiget-calendar:hover {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
#MainNav SIButton#continue-button.continue-button, #MainNav SIButton#continue-button.continue-button:hover {
    background-image: none;
    border-width: 0;
}
#MainNav #NonDiageticMenu SIText.sitext, #MainNav .navigation-primary-nav-calendar-wiget-calendar SIText.sitext {
}
#MainNav .navigation-primary-nav-calendar-wiget-calendar .calendar-widget-time-container SIText.sitext {
}
#MainNav #NonDiageticMenu * {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}

/* Zweite Leiste eines Wettbewerbs (Jonas 02.11.2026): links der Name des gezeigten Wettbewerbs (Verein, Spieler) in
   Weiß auf dem Papierstreifen; SI schreibt das Weiß als <color>-Tag in den Text, die Textfarbe greift nicht. Der
   Tintenkern (Kontur 1 in Tinte) deckt es ab; die Umschaltpfeile in Tinte. */
.navigation-type-competition #ViewedEntityTypeSwitch SIText.sitext {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
.navigation-type-competition #ViewedEntityTypeSwitch BindingRemapper.justify-content-center * {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}

/* Dream-Team der Medien (Ligaübersicht, Jonas 02.11.2026): der Platz lag mit SIs halbdurchsichtiger Fläche und Rahmen
   auf dem Blatt, die Platzlinien doppelt und gräulich. Ein eigener Zettel, leicht schräg aufgelegt, ohne Rahmen; SIs
   Linien aus, statt ihrer eine saubere Skizze in Tinte (heft_test.build_team_pitch). */
#TeamOfTheWeekPitchVisible > VisualElement.background-color-global-sink-surface-base.padding-global-padding-large {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    rotate: 0deg;
}
/* SIs Rahmen um den Platz ist ein Inline-Stil (1,3 px Grau), USS kommt nicht an ihn heran. Der Zettel liegt daher auf
   dem Kind, das über die Innenabstände hinaus bis über den Rahmen reicht und ihn verdeckt; schräg aufgelegt. */
#TeamOfTheWeekPitchVisible > VisualElement.background-color-global-sink-surface-base > BindableSwitchElement {
    width: auto;
    align-self: stretch;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-left: -15px;
    margin-right: -15px;
    margin-top: -15px;
    margin-bottom: -15px;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 15px;
    padding-bottom: 15px;
    rotate: -0.8deg;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#TeamOfTheWeekPitchVisible FMTacticsPanel#DreamXI {
    --pitch-line-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: var(--bild-teamplatz);
    -unity-background-scale-mode: stretch-to-fill;
}

/* Volltext beim Darüberfahren über gekürzte Namen (.sitext-tooltip, Jonas 02.11.2026): SI zeigt ihn weiß auf grauem
   Kasten, unlesbar. Papier mit feiner Tintenkante, Schrift in Tinte. Liegt in der Ebene der Aufklappmenüs. Der Kasten
   ist ein BindingRoot bzw. Tooltip, kein VisualElement (UI-Atlas; mit VisualElement griff die Regel nie, Jonas
   04.11.2026). Seit 11.11.2026 dunkel mit heller Schrift (Jonas: „müsste dunkel sein“): Vereinsnamen sind Links, FM
   malt sie per Code weiß, auf dem Papierkasten standen sie weiß auf Hell (Wettbewerbsseite, „Borussia
   Mönchengladbach“). In allen vier Looks gleich. Auf 27.0.1 ist der Kasten ein VisualElement (im Spiel gesehen). */
BindingRoot.sitext-tooltip, Tooltip.sitext-tooltip, VisualElement.sitext-tooltip {
    background-color: #2B2925; /* fest */
    background-image: none;
    border-width: 1px;
    border-color: #1C1A16; /* fest */
    border-radius: 0;
}
.sitext-tooltip Label.sitext-tooltip-text {
    -unity-font-definition: var(--schrift-heft-text-400);
}

/* Kopf der Wettbewerbsseite: SI malt hinter das Kopfblatt einen Verlauf in Wettbewerbsfarbe, über dem Blatt blieb ein
   blaues Band stehen (Jonas 02.11.2026); ebenso unter dem Papierstreifen der zweiten Leiste. Die Farben setzt SI per
   Code. Das Verlaufselement wird unsichtbar, sein Inhalt ausdrücklich wieder sichtbar: nur der Verlauf malt nicht. */
.comp-site-header > BindingRemapper > SIGradient.sigradient, .navigation-type-competition SIGradient#CompGradient {
    visibility: hidden;
}
.comp-site-header > BindingRemapper > SIGradient.sigradient > *, .navigation-type-competition SIGradient#CompGradient > * {
    visibility: visible;
}
/* Ebenso in allen Seitenköpfen (Verein, Nation, Nationalteam, News-Startseite): Bild und Verlauf in Vereinsfarben schienen
   um das Kopfblatt herum auf dem Tisch durch, oben als Streifen (Jonas 03.11.2026). Fünf Formen im FM-UI-Atlas, Verlauf
   zwei bis vier Ebenen unter dem Vorlagen-Container; nur diese Ebene wird unsichtbar, ihr Inhalt wieder sichtbar. */
#SiteHeaderDynamicItem > TemplateContainer > * > SIImage.unity-image,
#SiteHeaderDynamicItem > TemplateContainer > * > * > SIImage.unity-image,
#SiteHeaderDynamicItem > TemplateContainer > * > SIGradient.sigradient,
#SiteHeaderDynamicItem > TemplateContainer > * > * > SIGradient.sigradient,
#SiteHeaderDynamicItem > TemplateContainer > * > * > * > SIGradient.sigradient {
    visibility: hidden;
}
#SiteHeaderDynamicItem > TemplateContainer > * > SIGradient.sigradient > *,
#SiteHeaderDynamicItem > TemplateContainer > * > * > SIGradient.sigradient > *,
#SiteHeaderDynamicItem > TemplateContainer > * > * > * > SIGradient.sigradient > * {
    visibility: visible;
}
/* Menüpunkte der Vereinsleiste: SIs Hover-Farbe kehrte die Spiegelung in Tinte um, auf dunkler Vereinsfarbe unlesbar
   (Jonas 02.11.2026). Auf dunkler Leiste bleiben sie beim Drüberfahren weiß, die Pfeile ebenso. */
#MainNav.nav-on-dark #ManagingClubButtons SIButton:hover SIText.sitext {
}
#MainNav.nav-on-dark #ManagingClubButtons SIButton:hover * {
    -unity-background-image-tint-color: #FFFFFF; /* fest */
    --unity-image-tint-color: #FFFFFF;
}

/* Wettbewerb › Aktueller Stand (Saisonvorschau, Jonas 02.11.2026): Kopf, Dream-Team mit Spielerkarte,
   Transferausgaben und Schlüsselspieler (in der Mannschaftsvorschau Schlüsselpersonal, Zu- und Abgänge) lagen in SIs halbdurchsichtigen Flächen (Tinte 8 %, Papier 50 %) auf dem
   Holz, graue Texte gingen unter. Fläche und Rahmen setzt SI inline (USS kommt nicht heran), sie schienen im Rand des
   Blatts durch. Deshalb sind die Kartenelemente unsichtbar, ihr Inhalt sichtbar, und das Blatt liegt auf dem Behälter
   darüber, der keine eigene Fläche hat. Der Platz als dunkelgrüne Tafel wie in den Team-News, Namen weiß. Der
   Wettbewerbsname im Kopf steht als weißer <color>-Tag im Text: Tintenkern. */
#SeasonPreview_CompView BlockElement BlockElement.grid-element--Block > TemplateContainer,
#SeasonPreview_KeyPlayers BlockElement.grid-element--Block > TemplateContainer {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.frame-states-property-1-season_preview-property-2-dream-eleven-property-3-max-res,
.frames-frame-states-season_preview-transfer-spend,
.frames-frame-states-season_preview-key-players,
.frames-frame-states-season_preview-key-personnel,
.frame-states-property-1-season_preview-property-2-ins-and-outs-property-3-max-res,
#SeasonPreview_CompView SIGradient.block-border-only {
    visibility: hidden;
    background-image: none;
}
.frame-states-property-1-season_preview-property-2-dream-eleven-property-3-max-res > *,
.frames-frame-states-season_preview-transfer-spend > *,
.frames-frame-states-season_preview-key-players > *,
.frames-frame-states-season_preview-key-personnel > *,
.frame-states-property-1-season_preview-property-2-ins-and-outs-property-3-max-res > *,
#SeasonPreview_CompView SIGradient.block-border-only > * {
    visibility: visible;
}
.frame-states-property-1-season_preview-property-2-dream-eleven-property-3-max-res {
    padding-left: 12px;
    padding-right: 6px;
}
.season_preview_pitch_frame_max_res FMTacticsPanel.match-pitch-grass-colour {
    background-color: #3F7D4A; /* fest */
}
#SeasonPreview_CompView SIGradient.block-border-only SIText.thematic-lg {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
.season_preview_pitch_frame_max_res FMTacticsPanel SIText.sitext {
}

/* Kaderplanung › Planer › Beste Elf (Jonas 02.11.2026): die Positionskarten waren graue Köpfe mit lila (bester
   Spieler) und dunkelblauer (bestes Talent) Zeile, Namen in Tinte darauf unlesbar. Jede Karte ein kleiner Zettel,
   der Kopf in Tinte mit Haarlinie; die Zeilen in hellem Lila und hellem Blau (Papier, getönt, liegt über SIs Farbe),
   Namen in Tinte. Die Legende oben behält SIs Farbpunkte. Kopf- und Zeilenfarben setzt SI inline: getöntes Papier
   als Bild darüber. Der Platz als gedruckter Rasen mit Mählinien (heft_test.build_printed_lawn), Linien weiß. */
#BestXICardBody TemplateContainer.position--filled VisualElement.margin-right-global-gap-none {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: #FFFFFF;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    padding-left: 4px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 6px;
}
#BestXICardBody TemplateContainer.position--filled VisualElement.margin-right-global-gap-none > VisualElement#TopFrame {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-flaeche);
    -unity-background-image-tint-color: #FFFFFF;
    margin-top: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: #FDF8ED40;
    border-radius: 0;
}
#BestXICardBody TemplateContainer.position--filled VisualElement#TopFrame SIText {
}
#BestXICardBody TemplateContainer.position--filled VisualElement.margin-right-global-gap-none > VisualElement.row-direction-normal,
#BestXICardBody TemplateContainer.position--filled #HasProspectsVisible > VisualElement.row-direction-normal {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #E9DDF0;
    margin-top: 2px;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
}
#BestXICardBody TemplateContainer.position--filled #HasProspectsVisible > VisualElement.row-direction-normal {
    -unity-background-image-tint-color: #DCE7F3;
}
#BestXICardBody TemplateContainer.position--filled SIText#text {
}
#BestXICardBody FMTacticsPanel {
    background-color: #3F7D4A; /* fest */
    background-image: var(--bild-druckrasen);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #FFFFFF;
    border-radius: 3px;
    --pitch-line-color: #FFFFFF73;
}

/* Namen auf Taktiktafeln (Jonas 03.11.2026: „Namen weiß, überall auf Taktiktafeln“). FM schreibt sie per Code weiß
   (<color="#FFFFFF">), der Tintenkern oben macht sie auf dem dunklen Rasen zu Tinte (1,7–2,4:1). Hier ohne Kern:
   ungedünnter Schnitt, Weiß, dunkler Schatten. Ebenso die Positionskürzel auf der Gegner-Tafel (Tinte auf Rasen).
   Rückennummern (.fm-tactics-shirt-number) bleiben, wie sie sind. */
FMTacticsPanel.tactics-collapsable-pitch-grass-colour .totw-position-indicator SIText,
FMTacticsPanel.tactics-collapsable-pitch-grass-colour .tactics-simplified-position-indicator-bottom SIText,
FMTacticsPanel.tactics-collapsable-pitch-grass-colour .position--filled SIText.body-xs-strong {
    -unity-font-definition: var(--schrift-heft-text-400);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* Kaderplanung › Scouting › Scoutberichte (Jonas 02.11.2026): die Liste lag in SIs halbdurchsichtiger Fläche
   (Papier 50 %, inline) auf dem Holz. Wie in der Saisonvorschau: die Fläche unsichtbar, ihr Inhalt sichtbar, das Blatt
   auf dem Kind, das sie ganz ausfüllt. */
VisualElement#ListViewFrame.player-recommendations-block-fmc {
    visibility: hidden;
}
VisualElement#ListViewFrame.player-recommendations-block-fmc > * {
    visibility: visible;
}
VisualElement#ListViewFrame.player-recommendations-block-fmc VisualElement#main-block-container {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Kaderplanung › Scouting › Aufträge (Jonas 02.11.2026): die ganze Seite lag in SIs halbdurchsichtiger Fläche auf dem
   Holz. Ein Blatt. */
VisualElement#Frame.scout-assignments-frame {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
}

/* Kaderplanung › Planer › Kaderplaner (Jonas 02.11.2026): der schräge Platz war SIs dunkles Petrol-Bild, die
   Positionsfelder schwarz und halbdurchsichtig darauf. Der Platz als gedruckter Rasen in derselben Perspektive
   (heft_test.build_printed_lawn_perspective), die Felder als Zettel (das Blatt, klein) in Tinte; das gewählte Feld bleibt blau. Ebenso im hellen Modus
   (Positionsfeld im Filter der Spielersuche, grau auf Rasen unlesbar; Rückmeldung 02.11.2026). */
FMTacticsPanel.data_display-pitch_perspective-thematic {
    background-image: var(--bild-druckrasenschraeg);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #FFFFFF;
}
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-dark-active-false,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-dark-active-false,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-dark-active-false,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-light-active-false,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-light-active-false,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-light-active-false {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.3;
    -unity-background-image-tint-color: #F7F7F7;
}
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-dark-active-false:hover,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-dark-active-false:hover,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-dark-active-false:hover,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-light-active-false:hover,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-light-active-false:hover,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-light-active-false:hover {
    background-color: rgba(0, 0, 0, 0); /* fest */
    -unity-background-image-tint-color: #FFFFFF;
}
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-dark-active-false .input-squad-planner-data-point-upper-frame-backgroud,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-dark-active-false .input-squad-planner-data-point-upper-frame-backgroud,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-dark-active-false .input-squad-planner-data-point-upper-frame-backgroud,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-light-active-false .input-squad-planner-data-point-upper-frame-backgroud,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-light-active-false .input-squad-planner-data-point-upper-frame-backgroud,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-light-active-false .input-squad-planner-data-point-upper-frame-backgroud {
    background-color: rgba(0, 0, 0, 0);
}
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-dark-active-false SIText,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-dark-active-false SIText,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-dark-active-false SIText,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-ability-mode-light-active-false SIText,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-depth-mode-light-active-false SIText,
VisualElement#input-squad-planner-data-point-regular.input-squad-planner-data-point-regular-type-position-mode-light-active-false SIText {
}

/* Filter der Spieler- und Mitarbeitersuche (Rückmeldung 02.11.2026): nur der Mittelteil war ein Blatt; die Reiter
   (Suchkriterien, Attribute auswählen) und die Knopfleiste (Alle entfernen, Ausschließen, Abbrechen) lagen frei auf
   dem Holz, Tinte auf Holz unlesbar. Das Blatt liegt auf der ganzen Reitergruppe, der Mittelteil ist flach. */
#condition-filters-block-remapper TabGroup#tab-group {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 14px 18px 18px 18px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
#condition-filters-block-remapper #main-filter-block {
    background-image: var(--bild-leer);
}

/* Vereinsprofil (Jonas 02.11.2026): der Kopf (Wappen, Name, Liga, Medientipp …) lag als eckige Fläche auf dem Blatt,
   darunter SIs Verlauf in Vereinsfarbe; die Mannschaftskachel links war SIs dunkler Vereinsverlauf, Schrift Tinte auf
   Dunkel. Kopf ohne Fläche und Verlauf, nur eine Haarlinie darunter; die Kachel hell mit Haarlinie (Verlauf per Code
   gefärbt, daher unsichtbar statt umgefärbt). Live gesehen. */
.layout-block-base-container > SIGradient.sigradient.club-info-header {
    visibility: hidden;
}
.layout-block-base-container > SIGradient.sigradient.club-info-header > VisualElement {
    visibility: visible;
    background-image: var(--bild-leer);
    border-bottom-width: 1px;
    border-color: rgba(28, 26, 22, 0.18);
}
SIGradient.sigradient.club-nation-team-info-banner {
    visibility: hidden;
}
SIGradient.sigradient.club-nation-team-info-banner > * {
    visibility: visible;
}
SIGradient.club-nation-team-info-banner > VisualElement.club-nation-team-info-banner-background {
    background-color: rgba(28, 26, 22, 0.05);
    border-width: 1px;
    border-color: rgba(28, 26, 22, 0.18);
    border-radius: 0;
}
/* Personenkarte (z. B. Mitarbeiterbericht in einer Nachricht oder in der Vertragsverhandlung): der Name steht als
   weißer <color>-Tag in der Heftschrift (#NameLabel oder #text). Namensschnitt mit Tintenkern (Liste oben), fett über
   die breitere Kontur (Jonas 03./04.11.2026, live gesehen). */
VisualElement#Frame.padding-left-global-padding-regular > SIText.thematic-md {
}
/* Suchfeld oben (Suche › Eingabe, Jonas 03.11.2026): SIs dunkles Feld mit blauem Rand → ein Stück Blatt wie die
   Ergebnisliste darunter, ohne Rahmen (Jonas: Haarlinienkasten weg); Text, Schreibmarke und das X in Tinte, das X mit
   Haarlinie als Knopf. Dark setzt Linie und Schreibmarke hell (tonpapier_uss). */
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-edit-box TextInput#unity-text-input.unity-base-text-field__input.bindableeditbox,
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-card-close-button SIButton.buttons-controls-pc-default--active-true.sibutton.ios-header-button {
    background-color: rgba(0, 0, 0, 0);
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 1px;
    border-color: rgba(28, 26, 22, 0.35);
    border-radius: 3px;
    --unity-cursor-color: #E3E1DB;
    --unity-selection-color: rgba(232, 196, 136, 0.6);
}
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-edit-box TextInput#unity-text-input.unity-base-text-field__input.bindableeditbox,
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-edit-box TextInput#unity-text-input.unity-base-text-field__input.bindableeditbox:focus {
    border-width: 0;
}
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-edit-box TextElement.bindable-editbox-text.unity-text-element.unity-text-element__selectable {
    -unity-font-definition: var(--schrift-heft-text-400);
}
BindingSetter#SearchBindingsSetter #SearchInputPanel .global-search-card-close-button VisualElement#x-icon.ui-concepts-cross_small {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}
/* Im Spiel Flutlicht-Rasen statt Holz (Jonas 05.11.2026), das Bild von release/flutlichtrasen.png (Codex). Auf der
   gemeinsamen Hintergrundebene, nur dort deckt er Kopf, Fußleiste und die Blitzbilder beim Wechsel zwischen Szene und
   Übersicht ab. Ein Bild auf der Spielfläche überdeckte die Kopfleiste. Die Ebene zeigt FM auch in Interviews und
   Pressekonferenzen; dort und im Menü bleibt deshalb das Holz, siehe unten. */
#GameWorldBackground {
    background-image: var(--bild-tisch);
    -unity-background-scale-mode: scale-and-crop;
}
/* Rasen nur in der Spielszene (Jonas 05.11.2026): Die Ebene ist für Menü und Spiel dieselbe, die Klasse setzt Jonukas Skin Premium,
   solange die Spielübersicht offen ist. Ohne Plugin bleibt im Spiel das Holz. */
#GameWorldBackground.heft-spiel {
    background-image: var(--bild-flutlichtrasen);
}

/* Kaderplanung › Planer › Ansicht kompletter Kader (Jonas 05.11.2026): der Kopf lag ohne Blatt auf dem Holz, die Karten
   trugen SIs Nachtblau, das Feld Petrol aus der Vorlage (Inline-Farbe, deshalb Bild darüber). Der gedruckte Rasen wie
   beim Dream-Team, die Karten als kleine Blätter. */
#RecruitmentSquadPlannerTopFullSquad VisualElement.siblock, VisualElement.playerindicator_container {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
    border-radius: 0;
}
#RecruitmentSquadPlannerFullSquad VisualElement.justify-content-space-around {
    background-image: var(--bild-druckrasen);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #FFFFFF;
}
#RecruitmentSquadPlannerFullSquad FMTacticsPanel {
    --pitch-line-color: #FFFFFF96;
    background-color: #00000000;
}
/* Die Karten etwas größer (Jonas 05.11.2026); Platz zwischen den Positionen ist genug. Das Blatt endet vor dem Rand
   seines Bildes, deshalb Innenrand und mehr Breite, sonst stoßen Sterne und untere Zeile an die Kante. */
#RecruitmentSquadPlannerFullSquad VisualElement.playerindicator_container {
    scale: 1.15 1.15;
    max-width: 244px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 8px;
}
VisualElement.playerindicator_top, VisualElement.playerindicator_bottom {
    background-color: #00000000;
    border-radius: 0;
}
VisualElement.playerindicator_top {
    border-bottom-width: 1px;
    border-color: #80808040;
}
/* Der grüne Fleck hinter Trikot und Anzahl (Jonas 05.11.2026) ist eine Inline-Farbe, USS kommt nicht an sie heran. Die
   Fläche des Blatts liegt deshalb als Bild darüber. */
VisualElement.playerindicator_top VisualElement#data_display-cell-standard-small {
    background-image: var(--bild-flaeche);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: #F7F7F7;
}
VisualElement.playerindicator_top SIText {
    white-space: nowrap;
}

/* Spieler › Karriere (Saisontabelle, Jonas 04.11.2026): die Tabelle lag nur mit SIs feinem Rahmen auf dem Holz. Aus den
   Vorlagen (CareerStatsBlock, CareerStatsSeasonsOnlyBlock/-MoreDetailsBlock mit ExpandedTableTemplate), im Spiel
   ungeprüft. Ein Blatt wie die übrigen Blöcke. Ebenso die Meilensteine (PlayerMilestonesBlock): ohne Einträge lag nur
   ein Haarlinienrahmen auf dem Holz. */
VisualElement.card-states-card-states-career-stats, VisualElement.frames-milestone-list-size-size3,
TemplateContainer#OutfieldTable VisualElement.expanded-table, TemplateContainer#GKTable VisualElement.expanded-table {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
    border-radius: 0;
}
/* Datumswähler (z. B. Urlaubsoptionen › Datum wählen, Jonas 04.11.2026: „wieder FM-Look“): SIs nachtblaue Fläche lag
   über der Papierfläche des Aufklappfensters. Durchsichtig, das Papier trägt. */
FocusContentContainer.floating-element VisualElement.date_selector {
    background-color: rgba(0, 0, 0, 0);
}
/* Trainer-Übersicht im Mehrspielermodus (Portal › Übersicht › Trainer: Kontrolle abtreten, Passwort; Jonas 04.11.2026):
   die Tabelle lag ohne Blatt auf dem Holz, nur SIs feiner Rahmen. Ein Blatt wie die übrigen Blöcke. */
BindingVariables.online-manager-options-block-main-frame {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
    border-radius: 0;
}
/* Notenkreise (Empfehlung 1 bis 6 in Scouting-Listen und Berichten, Jonas 04.11.2026: „sieht alles gleich aus“): SIs
   Siebener-Skala ist für Text auf Papier stark abgedunkelt, 1, 1- und 2- wurden fast gleich dunkelgrün. Eigene
   Druckfarben je Note von Grün über Gelb bis Rot, Kreis mit hellem Fond, Ziffer in der dunkleren Stufe derselben Farbe.
   Die Skala selbst bleibt (Spielpraxis, Jugendatmosphäre nutzen sie als Textfarbe). */
.scaling-icon-grades-circle-outline-colour-a {
    border-color: #1E8E3E;
    background-color: #1E8E3E24; /* fest */
}
.scaling-icon-grades-circle-outline-colour-b {
    border-color: #447223;
    background-color: #62A53224; /* fest */
}
.scaling-icon-grades-circle-outline-colour-c {
    border-color: #6B630D;
    background-color: #A99D1424; /* fest */
}
.scaling-icon-grades-circle-outline-colour-d {
    border-color: #875A0C;
    background-color: #D08A1224; /* fest */
}
.scaling-icon-grades-circle-outline-colour-e {
    border-color: #C05927;
    background-color: #D0602A24; /* fest */
}
.scaling-icon-grades-circle-outline-colour-f, .scaling-icon-grades-circle-outline-colour-g {
    border-color: #DD6C65;
    background-color: #C0322A24; /* fest */
}
.scaling-icon-grades-text-colour-a {
}
.scaling-icon-grades-text-colour-b {
}
.scaling-icon-grades-text-colour-c {
}
.scaling-icon-grades-text-colour-d {
}
.scaling-icon-grades-text-colour-e {
}
.scaling-icon-grades-text-colour-f, .scaling-icon-grades-text-colour-g {
}
/* Elfmeter verwandelt/verschossen (Ergebnisse, Spielberichte): weißes Tor mit grünem bzw. rotem Punkt, als farbiges
   Symbol nicht in Tinte getönt; das Tor verschwand auf Papier (Jonas 04.11.2026). Ein kleiner Tintenstempel darunter,
   die Punkte behalten ihre Farbe. */
.game-concepts-penalty-scored_small, .game-concepts-penalty-missed_small {
    background-color: #1C1A16; /* fest */
    border-radius: 3px;
}
/* Symbole in nicht gewählten Segmentknöpfen (Einstellungen › Informationsanzeige Large/Medium/Small) und der Haken
   vor dem gewählten Eintrag einer Auswahlliste: SIs Bilder sind weiss, auf Papier unsichtbar (Jonas 03.11.2026).
   In Tinte; der gewählte Segmentknopf bleibt weiss auf Blau. */
.buttons-segmented-button-row-inactive-small-placement-leading > VisualElement,
.buttons-segmented-button-row-inactive-small-placement-middle > VisualElement,
.buttons-segmented-button-row-inactive-small-placement-trailing > VisualElement,
.buttons-segmented-button-row-inactive-regular-placement-leading > VisualElement,
.buttons-segmented-button-row-inactive-regular-placement-middle > VisualElement,
.buttons-segmented-button-row-inactive-regular-placement-trailing > VisualElement,
.buttons-segmented-button-row-inactive-default-placement-leading > VisualElement,
.buttons-segmented-button-row-inactive-default-placement-middle > VisualElement,
.buttons-segmented-button-row-inactive-default-placement-trailing > VisualElement,
.virtualised-list__item--selected .ui-concepts-tick_small,
.si-dropdown .ui-concepts-tick_small,
.cascading-menu__folder__entry__selected > #LeftIndicatorSection,
.sub-dropdown-content-container > .indicator-tick {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}

/* Auswahlfenster der Kartenleisten (z. B. Kaderplanung › Scoutinggebiet, Jonas 02.11.2026): graue Fläche mit
   runden, gerahmten Optionen, die gewählte satt blau mit weißer Schrift. Papier statt Grau; jede Option ein Zettel,
   die gewählte hellblau getönt mit blauer Kante links, Schrift überall in Tinte. */
ComponentElement.control_bar_popup_dialog_container {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}
.control_bar_popup_dialog_container SIRadioButton.unity-radio-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
}
.control_bar_popup_dialog_container SIRadioButton.unity-radio-button:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: #FFFFFF;
}
.control_bar_popup_dialog_container SIRadioButton.unity-radio-button.unity-radio-button-group__child-active {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: #D6E4F2;
    border-left-width: 4px;
    border-left-color: #0F5C8F; /* fest */
}
.control_bar_popup_dialog_container SIRadioButton.unity-radio-button SIText {
}
.control_bar_popup_dialog_container SIRadioButton.unity-radio-button * {
    -unity-background-image-tint-color: #E3E1DB;
    --unity-image-tint-color: #E3E1DB;
}

/* Training › Medizinische Abteilung (Jonas 02.11.2026): Saisonzusammenfassung, Risikobewertung und „Kürzlich
   zurückgekehrt“ lagen in SIs halbdurchsichtigen Flächen (Papier 50 %) auf dem Holz. Jede Fläche ein Blatt; ihre
   Farbe fest durchsichtig, sonst schien sie im Schattenrand des Blatts durch. */
VisualElement.medicial-injury-history-state4,
VisualElement.frame-medical-centre-season-summary-standard,
VisualElement#table.frames-medicial-injury-history-list,
VisualElement#Border.medical-risk-assessment-state5,
VisualElement.medical-recently-returned-post-state {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
}

/* Vereinsleiste ohne Verein (arbeitslos, Jonas 02.11.2026): SI blendet den Verlauf in Vereinsfarbe aus, unter dem
   Karton lag dann das Holz. Ein dunkler Grund unter dem Verlauf; mit Verein deckt der Verlauf ihn ganz zu. */
#MainNav #Gradients.navigation-header-gradient {
    background-color: #2A2722; /* fest */
}
/* Unter der Vereinsleiste lag eine 2 px breite blaue Linie (SIs Kante der Leiste). */
#MainNav, #MainNav #Gradients.navigation-header-gradient {
    border-bottom-width: 0;
}

/* Helles/dunkles Dreieck über dem Bildschirm bei langen Aufklappmenüs mit Scrollleiste (Jonas 02.11.2026): FMs
   Hervorhebungsebene (HighlightOverlayElement, sonst für Tutorial-Hinweise) zeichnet dabei per Code eine Abdunkelung,
   von der nur ein Dreieck ankommt; im dunklen Original fiel das kaum auf. Die Ebene bleibt da, malt aber nicht mehr
   (Tutorial-Hinweise verlieren damit ihre Abdunkelung rundum, die Hinweise selbst bleiben). */
HighlightOverlayElement.highlighting {
    opacity: 0;
}

/* Ladebildschirm nach Jobantritt (Willkommenspaket, Jonas 02.11.2026): graue Karte, Kopf im Vereinsverlauf, Meldung in
   halbdurchsichtigem Papier. Die Karte ein Blatt, der Kopf Papier mit Tintenlinie, die Meldung ohne eigene Fläche. */
VisualElement#frame.card-states-welcome-pack {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
}
.card-states-welcome-pack SIGradient#HeaderClub {
    --start-colour: #FFFFFF00; /* fest */
    --end-colour: #FFFFFF00; /* fest */
    visibility: hidden;
    border-bottom-width: 1px;
    border-bottom-color: #FDF8ED26;
    border-radius: 0;
}
.card-states-welcome-pack SIGradient#HeaderClub > * {
    visibility: visible;
}
.card-states-welcome-pack VisualElement#BreakingNewsContentNonPhone {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-color: rgba(0, 0, 0, 0); /* fest */
}
/* Dahinter statt FMs Presseraum-Foto der Schreibtisch am ersten Tag (Vertrag, Füller, Schlüssel, Krawatte). Das Foto
   ist SIImage#ChangingRoom in #BackgroundsSwitch von GameCreationLoadingScreen (Platzhalter PressConferenceRoomHighEnd,
   gilt auch beim Anlegen eines neuen Spiels): Bild ganz unsichtbar (FM setzt es per Code, Tönung greift nicht, siehe
   Anpfiff), die Szene auf dem Schalter darüber, der den Schirm füllt. */
#BackgroundsSwitch {
    background-image: var(--bild-jobantrittsbild);
    -unity-background-scale-mode: scale-and-crop;
}
#BackgroundsSwitch > SIImage#ChangingRoom {
    opacity: 0;
}

/* Wettbewerbstitel der linken Spalte jeder Wettbewerbsübersicht (Liga wie Pokal: „EFL Cup“, „Champions League“ …,
   Jonas 02.11.2026): SI schreibt den Namen als weißen <color>-Tag in den Text, keine Farbregel greift. Ein gedünnter
   Schnitt mit Tintenkontur sah rund und schwer lesbar aus. Stattdessen ein kleines Tintenschild als Grund (wie die Uhr
   in der Leiste): SIs Weiß steht darauf in derselben Barlow wie die übrigen Blocktitel. */
.width-33-percent > SIButton.buttons-button-tertiary-default {
    background-color: #1C1A16; /* fest */
    border-width: 0;
    border-radius: 2px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
}
.width-33-percent > SIButton.buttons-button-tertiary-default > SIText.sitext.thematic-md.content-ellipsis.flex-no-shrink-class.sitext-hover-cursor {
    -unity-font-definition: var(--typography-family-thematic);
    border-bottom-width: 0;
}

/* Spielvorschau-Kachel in Nachrichten („Vorschau auf nächstes Spiel“, Jonas 02.11.2026): SIs Verlauf in Vereinsfarben
   (Nachtblau) lag unter dem Blatt und stand unten als dunkler Schatten heraus; das Stadionsymbol blieb weiß, ebenso das
   Taktiksymbol daneben. Verlauf unsichtbar (Inhalt sichtbar), Symbole in Tinte. */
#PortalMessageContentScrollView SIGradient#background-gradient {
    visibility: hidden;
}
#PortalMessageContentScrollView SIGradient#background-gradient > * {
    visibility: visible;
}
#PortalMessageContentScrollView VisualElement#Stadium > .game-concepts-stadium_small,
#PortalMessageContentScrollView .game-concepts-tactic-primary_medium {
}

/* Nachrichtenkopf (Jonas 02.11.2026): die Uhrzeit rechts stand in einem hellgrauen Kästchen über dem Papier
   (.messages-header-time-stamp). Ohne Fläche, die Zeit schlicht in Tinte; die rote Linie unter dem Kopf bleibt. */
SIText.messages-header-time-stamp {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
}

/* Deadline-Day (Jonas 02.11.2026): FM blendet den Vereinsverlauf der Leiste aus (#Gradients, Deckkraft 0 per Code),
   die Leiste wurde zum Holz. Unter dem Verlauf liegt jetzt Schwarz mit Kartonfaser und einer gedruckten Linie in
   Deadline-Gelb unten (heft_test.build_deadline_bar; Gelb als Fläche sah nicht gut aus); an allen anderen Tagen deckt
   der Verlauf es zu. Die Menüpunkte bleiben weiß. */
#MainNav.tile-mockups-navigation-core-primary-hi-res {
    background-color: #141310; /* fest */
    background-image: var(--bild-deadlineleiste);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 6;
    -unity-slice-type: tiled;
}
/* Deadline-Day-Uhr auf dem rechten Leistenzettel („Fenster schließt in / 14 STUNDEN“, gibt es nur an dem Tag): ein
   eigener gelber Zettel, leicht schräg aufgeklebt, Tinte darauf (Jonas 02.11.2026). SIs Rahmen und Fläche weg. */
#MainNav SIButton.tdd-calendar-widget {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: #F7DF3E;
    rotate: -2deg;
    padding-left: 8px;
    padding-right: 6px;
}
#MainNav .tdd-calendar-widget SIText#header-text {
}
#MainNav .tdd-calendar-widget SIText#hours-text {
}
#MainNav .tdd-calendar-widget * {
}
#MainNav .tdd-calendar-widget #layout-divider-solid-vertical {
    background-color: #1C1A1640; /* fest */
}

/* Zurück/Vor links in der Vereinsleiste (Jonas 02.11.2026): SI legt dunkle, gerahmte Kacheln hinter die Pfeile, die
   über die Leiste hinausragten (am Deadline-Day über die gelbe Kante). Nur die Pfeile bleiben, auf allen Seiten,
   auch im Titelschild vor dem Spiel (Team-News, Ansprache). */
#MainNav SIButton.buttons-controls-pc-default--active-true, #MainNav SIButton.buttons-controls-pc-default--active-false,
#MainNav .main-navigation-button SIButton, #MainNav .main-navigation-button SIButton:hover,
#BindingExpect_TopBarMatch SIButton.buttons-controls-pc-default--active-true,
#BindingExpect_TopBarMatch SIButton.buttons-controls-pc-default--active-false,
#BindingExpect_TopBarMatch .main-navigation-button SIButton {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
}

/* Deadline-Day-Banner oben im Posteingang (Jonas 02.11.2026): SIs dunkles Bild mit Olivverlauf in halbdurchsichtigem
   Papier, darauf ein graues Schild „Deadline Day“ mit Olivschrift und dunkler Text daneben. Wie die Uhr in der Leiste:
   ein gelber Zettel (das SI-Bild unsichtbar, darüber das Blatt gelb getönt), das Schild schwarz mit Deadline-Gelb. */
VisualElement.tdd-messages-banner {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7DF3E;
}
.tdd-messages-banner SIImage#banner-image {
    --unity-image-tint-color: #00000000;
}
.tdd-messages-banner .background-color-transfer-deadline-day-background {
    background-color: #141310; /* fest */
    border-radius: 2px;
}
.tdd-messages-banner SIGradient#black-background-gradient {
    --start-colour: #FFFFFF00; /* fest */
    --end-colour: #FFFFFF00; /* fest */
    border-width: 0;
}
.tdd-messages-banner SIText.colours-transfer-deadline-day-primary {
    -unity-font-definition: var(--typography-family-thematic);
}
.tdd-messages-banner SIText.global-text-primary {
}
.tdd-messages-banner .game-concepts-time-passing_small {
}

/* Spielerbild auf den News-Kacheln (Jonas 02.11.2026): SI legt einen grauen Kreis hinter das Gesicht. Weg, das Gesicht
   steht frei auf dem Bild der Kachel. */
#DynamicNewsForegroundContent TemplateContainer#PersonPicture,
#DynamicNewsForegroundContent TemplateContainer#PersonPicture * {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
}

/* Spieltag vor dem Anpfiff, Kopfleiste (Mannschaftsauswahl, Taktik-Assistent; Jonas 02.11.2026): der Vereinsverlauf
   rechts trug dunkle Knöpfe direkt auf der Vereinsfarbe. Rechts (Sofortergebnis, Zahnrad, Zum Spiel) jetzt ein
   hängender Zettel wie in der Vereinsleiste, Knöpfe in Tinte. Die Kartonfaser der Vereinsleiste lässt sich hier nicht
   auflegen (der Grund unter dem Verlauf nimmt kein Bild an). */
.team-selection-header > VisualElement#RightCorner {
    background-image: var(--bild-haengeblatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    height: 76px;
    min-height: 76px;
    max-height: 76px;
    margin-top: -21px;
    padding-top: 19px;
    padding-left: 14px;
    padding-right: 4px;
    align-items: center;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.team-selection-header #RightCorner SIButton.buttons-button-base-default {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-color: #1C1A1640; /* fest */
}
.team-selection-header #RightCorner SIButton.buttons-button-base-default SIText {
}
.team-selection-header #RightCorner SIButton.buttons-button-base-default * {
}

/* Taktik-Assistent („Wählen Sie einen taktischen Stil“): der Titel stand in SIs Markenfarbe im Fließtextschnitt, die
   Vorschau rechts war eine graue Fläche mit Rahmen. Titel in der Heftschrift in Füllertinte (wie die Erkenntnisse der
   Gegneranalyse), die Vorschau Papier mit Haarlinie. */
SIText.sitext.thematic-xl.tifo-text-brand-highlight-pink {
    -unity-font-definition: var(--typography-family-thematic);
}
VisualElement#details_container.layout-block-tactics {
    background-color: rgba(0, 0, 0, 0); /* fest */
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #EFE9DA;
    border-color: #1C1A1633; /* fest */
}
.team-selection-header #RightCorner SIButton#continue-button.continue-button {
    background-image: none;
    border-width: 0;
}

/* Taktik-Assistent, Formationswahl (Jonas 02.11.2026): die Formationen lagen auf grauen, runden Flächen (SIs Taktik-
   Taupe), die kleinen Vorschaubilder ebenso, die gewählte Zeile war ein grauer Block. Plätze als dunkelgrüne Tafel wie
   in den Team-News, Linien weiß; die gewählte Zeile hellblau getöntes Papier mit blauer Kante (wie im Auswahlfenster). */
#details_container.layout-block-tactics FMTacticInstructionsWidget.tactics-visualiser-pitch,
.list-item-radio-button-style FMTacticInstructionsWidget.tactics-visualiser-pitch-preview {
    background-color: #3F7D4A; /* fest */
    border-color: #2C5A35; /* fest */
    border-radius: 2px;
    --pitch-line-color: #FFFFFF8C;
    --visualiser-pitch-default-pitch-lines: #FFFFFF8C;
    --visualiser-pitch-accent-pitch-lines: #FFFFFF8C;
    --visualiser-pitch-thematic-pitch-lines: #FFFFFF8C;
}
SIRadioButton.list-item-radio-button-style.unity-radio-button-group__child-active {
    background-color: #162E46; /* fest */
    border-color: #1C1A1633; /* fest */
    border-left-width: 4px;
    border-left-color: #0F5C8F; /* fest */
}

/* Taktik (Mannschaftsauswahl vor dem Spiel, Taktikübersicht): die beiden Kopfzeilen (Taktikwahl, Formationen/
   Teamanweisungen) trugen eigenes randloses Papier über dem großen Blatt, ein hellerer Kasten mit geraden Kanten, der
   über die Blattkante ragte (Jonas 02.11.2026). Ohne eigene Fläche: das Blatt trägt alles. */
SIGradient.sigradient.frame-tactics-nav-menu,
.frame-tactics-nav-menu .tactics-nav-primary-actions-property-1-base,
.frame-tactics-nav-menu .tactics-nav-secondary-actions-property-1-team-shape {
    background-image: none;
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
}
/* SIs Verlauf setzt seine Farben per Code (grün): das Verlaufselement unsichtbar, sein Inhalt sichtbar. */
SIGradient.sigradient.frame-tactics-nav-menu {
    visibility: hidden;
}
SIGradient.sigradient.frame-tactics-nav-menu > * {
    visibility: visible;
}
.frame-tactics-nav-menu .tactics-nav-secondary-actions-property-1-team-shape {
    border-bottom-width: 1px;
    border-bottom-color: #1C1A1626; /* fest */
}

/* Interviews und Pressekonferenzen (Jonas 02.11.2026): die Frage stand dunkel in einer satt blauen Blase, die Kachel
   des Journalisten hatte einen blauen Kopf und einen dicken Tintenrahmen mit runden Ecken. Blase hellblau mit Tinte,
   Kachel als kleiner Zettel mit feiner Kante, Kopf hellblau; „Zusätzliche Aktionen“ mit feiner Kante. */
VisualElement#BubbleBackground.speech-background-type-reply {
    background-color: #162E46; /* fest */
}
.meeting-tiles-base.meeting-tiles--background-active {
    border-width: 1px;
    border-color: #1C1A1640; /* fest */
    border-radius: 0;
}
.meeting-tiles-base #TopBar.meeting-tiles-top-panel--background-active {
    background-color: #162E46; /* fest */
    border-radius: 0;
}
SICheckBox.speakto-button-additional-actions-selector-property-1-default {
    border-color: #1C1A1640; /* fest */
}
/* Fragezeile oben (.meetings-statement-bar): SIs feiner Rahmen lag als grauer Kasten um das Blatt, das Bild der
   Journalistin ragte unten über die Blattkante. Ohne Rahmen, Inhalt innerhalb des Blatts. Die kleine Kachel der
   Journalistin wird ebenfalls ein Blatt. */
VisualElement.meetings-statement-bar {
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    overflow: hidden;
    padding-bottom: 7px;
}
VisualElement.meeting-tiles-base.meeting-tiles--background-active {
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: #F7F7F7;
    padding: 3px 4px 6px 3px;
}

/* Spielleiste im Spiel als Spielberichtsbogen (Jonas 02.11.2026: die hellen Einzelkästen bissen sich mit dem Rasen,
   wirkten unfertig): ein durchgehender Papierstreifen mit Blattkante und Schatten, etwas wärmer und dunkler getönt
   (altes Formular statt grelles Weiß). Die Spieler stehen ohne eigene Kästen darauf, getrennt durch feine
   Tintenlinien. Die Karten tragen SIs Nachtblau inline: unsichtbar, ihr Inhalt sichtbar. Bei breitem Bild steht die
   Ersatzbank als eigene Liste daneben (#SubsPlayersList, Jonas 10.11.2026: sie blieb nachtblau): derselbe Streifen. */
VisualElement#Content.squad-overview-block, StreamedObjectList#SubsPlayersList.squad-overview-block {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F2EBDC; /* eine Stufe heller (Jonas 02.11.2026), vorher E9DFC9 */
    padding: 4px 8px 0 6px;
}
/* bis an den unteren Bildrand, kein Rasen darunter (Jonas 02.11.2026); die eingeklappte Leiste (36 px) nur wenig */
#Squad_Expanded VisualElement#Content.squad-overview-block, #Squad_Expanded StreamedObjectList#SubsPlayersList.squad-overview-block {
    translate: 0 23px;
}
#Squad_Collapsed VisualElement#Content.squad-overview-block {
    translate: 0 15px;
    padding-top: 0;
}
.squad-overview-block VisualElement#SquadInfoSidebar.squad-overview-item {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-right-width: 1px;
    border-right-color: #1C1A1640; /* fest */
}
.squad-overview-block VisualElement#ListContainer {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
/* Ersatzbank daneben („Subs“ an, kleine Informationsanzeige): eigene Liste mit SIs Nachtblau (.midnight, #EEEDEA) auf
   dem Papierstreifen (Jonas 10.11.2026). Durchsichtig wie die Startelf. */
.squad-overview-block StreamedObjectList.midnight {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
.squad-overview-block VisualElement.player-info-property-1-overview-mode,
.squad-overview-block ComponentElement.player-info-property-1-overview-mode {
    visibility: hidden;
    border-right-width: 0;
}
.squad-overview-block VisualElement.player-info-property-1-overview-mode > *,
.squad-overview-block ComponentElement.player-info-property-1-overview-mode > * {
    visibility: visible;
}
#Squad_Collapsed .squad-overview-block TemplateContainer.streamed-list-view-item {
    border-right-width: 1px;
    border-right-color: #1C1A1633; /* fest */
}
.squad-overview-block SIButton.squad-overview-item {
    border-right-width: 1px;
    border-right-color: #1C1A1633; /* fest */
}

/* Halbzeit/Spielende (Jonas 02.11.2026: „Holz passt hier nicht“, „großer Zettel“): wie die Spieltaktik ein großes
   Blatt für alle Kacheln, dahinter das Stadion statt Tisch. Die Kacheln liegen flach darauf, getrennt durch Haarlinien.
   Der Abpfiff-Bericht (#FullTimeTeamReport) fehlte bis 10.11.2026: dort lag der Tisch als hartes Rechteck auf dem
   Stadion, in Wood ein Holzstück (Jonas). */
Panel#HalfTimeTeamReport #Card-frame, Panel#HalfTimeTeamReport #CardContainer,
Panel#FullTimeTeamReport #Card-frame, Panel#FullTimeTeamReport #CardContainer {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
Panel#HalfTimeTeamReport #Card-frame > #Header, Panel#HalfTimeTeamReport #Card-frame > #GridSafeArea,
Panel#FullTimeTeamReport #Card-frame > #Header, Panel#FullTimeTeamReport #Card-frame > #GridSafeArea {
    background-image: var(--bild-leer);
}
Panel#HalfTimeTeamReport VisualElement#GridLayoutElementContent, Panel#FullTimeTeamReport VisualElement#GridLayoutElementContent {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
Panel#HalfTimeTeamReport #GridLayoutElementContent .layout-block-base-container,
Panel#HalfTimeTeamReport #GridLayoutElementContent .layout-tile-interaction-button-background,
Panel#HalfTimeTeamReport #GridLayoutElementContent .layout-tile-interaction-button-background:hover,
Panel#HalfTimeTeamReport #GridLayoutElementContent .tile-states-match-simulation-hero-2d-12x4,
Panel#HalfTimeTeamReport #GridLayoutElementContent VisualElement#Background.entity-background-header,
Panel#FullTimeTeamReport #GridLayoutElementContent .layout-block-base-container,
Panel#FullTimeTeamReport #GridLayoutElementContent .layout-tile-interaction-button-background,
Panel#FullTimeTeamReport #GridLayoutElementContent .layout-tile-interaction-button-background:hover,
Panel#FullTimeTeamReport #GridLayoutElementContent .tile-states-match-simulation-hero-2d-12x4,
Panel#FullTimeTeamReport #GridLayoutElementContent VisualElement#Background.entity-background-header {
    background-image: var(--bild-leer);
    background-color: rgba(0, 0, 0, 0); /* fest */
    translate: 0 0;
    rotate: 0deg;
    border-width: 1px;
    border-color: #1C1A161F; /* fest */
}

/* TV-Grafiken der Champions League vor dem Anpfiff (Aufstellung, Tabelle; Jonas 02.11.2026): Spielernamen,
   Ersatzbank und Vereinsnamen der Tabelle standen dunkel auf SIs Blau (die Spiegelung machte ihre Farbe zu Tinte).
   Klassen aus FMs Vorlagen gelesen (LineupTacticPosition, LineupSubstituteItem, LeagueTableRow*): weiß, ohne Kontur. */
SIText.team-lineup-uefa-name, SIText.team-lineup-ucl-sub-name, SIText.team-lineup-ucl-sub-number,
SIText.league-table-ucl-row-text {
}

/* Wiederholung im Spiel (Jonas 02.11.2026): die Zeitachse unten war SIs hellgraue Leiste mit runden Ecken, „Zeitachse“
   in Markenblau; „Spieltag verlassen“ ein blauer Knopf. Die Zeitachse wie die Spielleiste ein warmer Papierstreifen
   (Blatt), Text in Tinte; der Knopf ein Papierzettel in Tinte. Anzeigetafel oben: SIs Champions-League-Schrift wird
   die Heftschrift (Farben der Tafel bleiben). */
VisualElement#Timeline.data_display-me-timeline-default {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #E9DFC9;
}
#Timeline.data_display-me-timeline-default SIText.tifo-text-brand-horizon {
}
#Timeline.data_display-me-timeline-default .colours-brand-foundation-horizon-tint {
}
#BindingExpect_PastMatchesTimeline SIText.sitext, #BindingExpect_PastMatchesTimeline Label {
}
SIText.uefa-champions-font.ucl-broadcast-stage {
    -unity-font-definition: var(--typography-family-thematic);
}
#IsManagingSwitch > TemplateContainer#NotManaging SIButton.buttons-button-primary-default {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: #F7F7F7;
}
#IsManagingSwitch > TemplateContainer#NotManaging SIButton.buttons-button-primary-default SIText {
}
#IsManagingSwitch > TemplateContainer#NotManaging SIButton.buttons-button-primary-default SIGradient {
    opacity: 0;
}

/* VAR-Einblendung im Spiel (Standard-Wettbewerbe, von einem Spieler gemeldet 02.11.2026): auf SIs dunklem TV-Bild stand
   die Entscheidung („Elfmeter“) in Tinte, unlesbar. Klassen aus FMs Vorlage VARPopup_DefaultMatchUI: Beschreibung weiß,
   die Überschrift („Überprüfung“) in hellerem Blau. */
#BindingExpect_VarPopup SIText.fm-var-text.global-text-primary {
}
#BindingExpect_VarPopup SIText.fm-var-text.tifo-text-brand-horizon {
}

/* Pressekonferenz (Jonas 02.11.2026): die wartenden Journalisten lagen als graue Kästen mit runden Ecken und grauem
   Kopf auf dem Raumbild. Jetzt Zettel wie die aktive Karte, eine Spur dunkler getönt (sie warten); die aktive behält
   ihren hellblauen Kopf. Die Stimmungsplakette „Neutral“ ohne eigenen Kasten. */
VisualElement.meeting-tiles-base.meeting-tiles--background-inactive {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: #E4DED2;
    padding: 3px 4px 6px 3px;
}
.meeting-tiles-base #TopBar.meeting-tiles-top-panel--background-inactive {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
}
.meeting-tiles-base SIStyleSetter.body-language-neutral-background-colour {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
/* Kopf der Vollbild-Termine (Pressekonferenz, Gespräche): SIs graue Fläche als Papierstreifen mit Blattkante, die
   Seiten aus dem Bild geschoben; Zurück/Vor ohne Kachel wie überall. */
ComponentElement.fullscreen-experience-header {
    background-color: rgba(0, 0, 0, 0); /* fest */
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin-left: -18px;
    margin-right: -18px;
    margin-top: -12px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.fullscreen-experience-header SIButton#BackButton.sibutton,
.fullscreen-experience-header SIButton#ForwardButton.sibutton,
.fullscreen-experience-header SIButton#BackButton.sibutton:hover,
.fullscreen-experience-header SIButton#ForwardButton.sibutton:hover {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
}
/* Spielbericht und Teambericht unten: SIs Wettbewerbsrahmen (#MiddleLayer, Champions League blau, halb deckend) schien
   als runde Kante um das Blatt. FM blendet ihn per Code ein (die allgemeine display-Regel greift dort nicht): unsichtbar. */
.simeeting-visualizer SIImage#MiddleLayer.fixture-background-border {
    visibility: hidden;
}
.fullscreen-experience-header SIStyleSetter.body-language-neutral-background-colour {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
/* Antwortblatt rechts: FM setzt dem Behälter einen grauen Rahmen per Code (Inline-Stil, die Randregel greift nicht), er
   lag als Kasten um das Blatt. Der Behälter unsichtbar, das Blatt liegt eine Ebene höher, gleich groß. */
#BindingExpect_SpeakToSidePanel VisualElement#Container.interaction-_interaction-hub-base-default {
    visibility: hidden;
}
#BindingExpect_SpeakToSidePanel VisualElement#Container.interaction-_interaction-hub-base-default > * {
    visibility: visible;
}
BindingExpect#BindingExpect_SpeakToSidePanel {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Zurufe/Anpassungen im Spiel (Jonas 02.11.2026): sie öffnen wieder richtig, aber hinter unserem Zettel lag der flache
   Papierbehälter aller Aufklappmenüs als zweiter Kasten (er schien durch den durchsichtigen Blattrand). Der Behälter
   lässt sich nicht nur hier ausblenden (kein Elternwähler in USS); der Zettel ragt deshalb um seinen Rand über den
   Behälter hinaus und deckt ihn. Das Info-Symbol rechts in Tinte statt fast weiß. */
.floating-element .tactical-tweaks-panel {
    margin: -10px;
    padding: 10px 10px 24px 10px; /* gleicht den Überstand aus, Symbole und Reiter lagen sonst an der Kante */
}
/* Das Info-Symbol trägt SIs helle Tönung im Inline-Stil der Vorlage (info-widget-small-transparent), keine Farbregel
   erreicht es. Es liegt deshalb auf einem kleinen Tintenpunkt (sein Rahmenelement): hell auf dunkel, wie ein Info-Knopf. */
.tactical-tweaks-panel VisualElement.ui-concepts-size-small {
    background-color: #2A2722; /* fest */
    border-radius: 8px;
}

/* Nationenseite (Jonas 02.11.2026): Flagge, Ländername und Kennzahlen (Einwohner, Sprachen, Währung, Abkommen)
   standen frei auf dem Holz, die Kennzahlen unleserlich. Der ganze Kopf wird eine Papierkarte wie bei Vereinen (dort
   liegt das Blatt auf #NonPhoneLayout > SISafeAreaElement, hier sitzt der Bereich direkt unter dem Verlauf). Den
   Ländernamen setzt FM weiß: er druckt im Tintenkern wie der Vereinsname. */
.ios-site-header > SIGradient.sigradient > SISafeAreaElement {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    margin: 6px 16px 0 16px;
    padding: 6px 12px 8px 12px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Über und um die Karte lag SIs Kopfverlauf (Farben per Code) als heller Schleier auf dem Holz, in allen Seitenköpfen
   (Nation, Nationalmannschaft, Verein; Jonas 02.11.2026: „überall, wo der ist, weg“). Unsichtbar, sein Inhalt
   sichtbar. Der Verlauf sitzt je nach Kopf direkt im Baustein oder unter einem BindingRemapper. */
#SiteHeaderDynamicItem > TemplateContainer > ComponentElement > SIGradient.sigradient,
#SiteHeaderDynamicItem > TemplateContainer > ComponentElement > BindingRemapper > SIGradient.sigradient {
    visibility: hidden;
}
#SiteHeaderDynamicItem > TemplateContainer > ComponentElement > SIGradient.sigradient > *,
#SiteHeaderDynamicItem > TemplateContainer > ComponentElement > BindingRemapper > SIGradient.sigradient > * {
    visibility: visible;
}
#site-nation-banner-max VisualElement#LHS SIText.sitext.thematic-xl {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Weltrangliste als grauer Kasten mit Schatten (SIs Verlauf, Farbe per Code): unsichtbar, die Zahl steht auf dem Blatt. */
#site-nation-content-block-national-teams SIGradient.sigradient {
    visibility: hidden;
}
#site-nation-content-block-national-teams SIGradient.sigradient > * {
    visibility: visible;
}
/* Wichtiges Personal: die Bezeichnungsspalte ist 100 px breit, „Schlüsselspieler“ lief unter das Porträt. Etwas
   breiter, die Namensspalte gibt ab. */
#site-nation-content-block-national-teams VisualElement.align-items-centre.margin-vertical-global-gap-small > VisualElement.row-direction-normal {
    min-width: 122px;
    width: 122px;
}

/* Kontinentseiten (Jonas 02.11.2026): die Kopfkarte (Blatt aus der allgemeinen Kopfregel, 16 px Rand je Seite) behielt
   SIs volle Breite und lief rechts aus dem Bild, „Mannschaften“ war abgeschnitten. Breite frei, die Ränder greifen.
   Der Globus war weiß auf dem Blatt: in Tinte getönt. Den Kontinentnamen setzt FM weiß, er druckt im Tintenkern. */
VisualElement#ContinentSiteHeader {
    width: auto;
}
#ContinentSiteHeader SIImage#ContinentImage {
    --unity-image-tint-color: #D4D1C8;
    -unity-background-image-tint-color: #D4D1C8;
}
#ContinentSiteHeader #IsWorld SIText.sitext.fm-universe-center-32px {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}

/* Vollbild-Meldungen (Eilmeldung zum Saisonende u. ä., Jonas 02.11.2026): die Kopfleiste trug SIs Fläche
   .midnight-background-colour, bei uns fast weiß, sehr grell über dem Holz. Durchsichtig: Titelschild und
   Posteingang-Zettel liegen auf dem Holz. Überall, wo diese Kopfleiste vorkommt (Jonas: „überall so machen“), auch
   mit anderer Flächenklasse. */
#NonPhone > VisualElement#bkg, VisualElement#bkg > VisualElement#Header.main-header-height {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
/* Weiter-Knopf rechts in dieser Kopfleiste (Posteingang, Weiter): unser Zettel mit Blattkante statt der flachen
   Kachel mit Rahmen (Jonas 02.11.2026). */
#bkg > #Header SIButton#continue-button.continue-button, #bkg > #Header SIButton#continue-button.continue-button:hover {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.35;
    -unity-background-image-tint-color: #FFFFFF;
    border-width: 0;
}

/* Räume als 3D-Bild (Kabine, bei hoher Grafik) und Interviewräume (Jonas 02.11.2026): FM zeigt den Raum als
   SIRenderTextureImage im allgemeinen Spielhintergrund; unsichtbar, darunter liegt das Holz des Panels. Vor dem Spiel
   (Team-News, Ansprache auch in der Halbzeit, Interview im Spielertunnel) statt Holz der Spieltags-Schreibtisch mit
   Ball, dieselbe Szene wie beim Laden vor dem Anpfiff; übrige Interviews und Pressekonferenzen behalten das Holz. */
#GameWorldBackground SIRenderTextureImage {
    opacity: 0;
}
/* Ansprache nicht: dasselbe Panel liegt in der Halbzeit unter der Taktik, dort war der Ball zu unruhig (Jonas). */
Panel#TeamNewsPanel, Panel#TunnelInterviewPanel {
    background-image: var(--bild-anpfiffbild);
    -unity-background-scale-mode: scale-and-crop;
}

/* Fragezeile in Interviews und Pressekonferenzen (Jonas 02.11.2026): lange Fragen passten nicht in die Blase, oben
   und unten fehlten Zeilen (SIs Leiste ist 119 px hoch, die Blase scrollt nur; unsere Schrift läuft etwas länger als
   SIs). Die Leiste höher, die Frage eine Spur kleiner. */
SIVisible#IsJournalist > VisualElement#Frame.meetings-statement-bar,
VisualElement#TopBar.meetings-statement-container {
    height: 156px;
    min-height: 156px;
    max-height: 156px;
}
VisualElement#BubbleBackground.speech-background-type-reply SIText#text.sitext.body-md {
    font-size: 14px;
}

/* Taktik vor dem Spiel (Mannschaftsauswahl, Jonas 02.11.2026): oben lag SIs Leiste in Vereinsfarbe (HSV blau),
   darauf das Titelschild, darunter die Reiter auf eigenem Streifen über die ganze Breite. Jetzt liegt der Tisch auch
   hinter der Titelleiste (oben bündig, der Inhalt unten bündig: ein Bild ohne Versatz), und nur links
   ein Zettel für Begegnung und Reiter, so breit wie ihr Text; rechts bleibt der hängende Zettel mit den Knöpfen.
   Der Zettel ist die linke Ecke der Kopfzeile, nach unten über die Reiterzeile verlängert (die Reiter liegen als
   späteres Geschwister darüber), Ränder links und oben aus dem Bild geschoben. */
Panel#TeamSelectionTitleBar {
    background-image: var(--bild-tisch); /* reiner Tisch wie der Inhalt darunter (Jonas: Szene hier zu unruhig) */
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: top;
}
Panel#TeamSelectionTitleBar ComponentElement.midnight-background-colour.main-header-height {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
.team-selection-header > TemplateContainer#Gradients.navigation-header-gradient {
    visibility: hidden;
}
Panel#TeamSelectionTitleBar .team-selection-header > VisualElement#LeftCorner {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    align-self: flex-start;
    min-width: 520px;
    height: 97px; /* endet mit der Titelleiste (85 px), sonst schnitt sie die untere Blattkante ab */
    min-height: 97px;
    max-height: 97px;
    margin-left: -18px;
    margin-top: -12px;
    padding-left: 18px;
    padding-top: 12px;
    padding-bottom: 30px;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
/* Unter den Reitern lag SIs Vereinsverlauf (HSV blau, halb durchsichtig) als Streifen über dem Zettel; sonst deckt ihn
   unser Papierstreifen. In allen Reiterleisten unsichtbar, gleich welcher Verein oder Wettbewerb. */
.navigation-type-competition BindableSwitchElement#EntityGradient {
    visibility: hidden;
}
Panel#TeamSelectionTitleBar #BindingExpect_TopBarMatch VisualElement#TopBar.row-direction-normal {
    background-image: none;
}
/* Die Reiterzeile ist hier ein Papierstreifen wie auf allen Seiten, aber nur so breit wie ihre Reiter: Auf Standards,
   Elfmeter und Gegner kommen „Taktik-Feedback“ und „Data Hub“ dazu, die Reiter liefen über den Zettel hinaus aufs Holz
   (Jonas 10.11.2026). Mindestens so breit wie der Zettel, damit beide rechts bündig enden; FM schiebt dabei keine Reiter
   ins Mehr-Menü (im Spiel geprüft). */
Panel#TeamSelectionTitleBar .navigation-type-competition {
    justify-content: flex-start;
}
Panel#TeamSelectionTitleBar .navigation-type-competition > SISafeAreaElement {
    flex-grow: 0;
    min-width: 520px;
}
/* Der Streifen beginnt 18 Einheiten links außerhalb des Bildes (Blattkante), den Innenabstand setzt FMs Safe-Area per
   Code: „Mannschaftsauswahl“ begann bei x −11 (Jonas 10.11.2026). Der Namenskasten rückt nach rechts. */
Panel#TeamSelectionTitleBar .navigation-type-competition VisualElement.tile-mockups-navigation-secondary-entity-default {
    margin-left: 18px;
}
/* Titel der Begegnung im kräftigen Tintenkern wie die übrigen Schildtitel. */
#BindingExpect_TopBarMatch #TopBar SIText.sitext.thematic-lg {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
}
/* Wappen bzw. Wettbewerbslogo im Titelschild: SI legt einen Kasten in Vereins- oder Wettbewerbsfarbe dahinter (per
   Code); unsichtbar, das Logo steht frei auf dem Papier. */
#BindingExpect_TopBarMatch #TeamInfo > SIStyleSetter > VisualElement.border-radius-interaction-global-radius-md {
    visibility: hidden;
}
#BindingExpect_TopBarMatch #TeamInfo > SIStyleSetter > VisualElement.border-radius-interaction-global-radius-md > * {
    visibility: visible;
}

/* Leere Ersatzplätze in der Positionsleiste (Kader, E13–E15): SIs Nachtblau als Grund (per Code), die Schrift folgte
   global-text-primary und stand als Tinte darauf (Jonas 10.11.2026). Weiß ohne Kontur; ohne #Sub gewann die Tinte
   (live geprüft). */
.tactic-position-overview-widget-item__unfilled SIText#Sub.sitext {
}

/* Rollenkürzel auf der Taktiktafel (CFD, BCB …) sind Knöpfe mit SIText#text: die Knopfregel (Figtree 500, 14 px) traf
   sie mit, sie wurden riesig (Jonas 10.11.2026). Zurück auf SIs Größe; Id im Selektor schlägt die Knopfregel. */
.position--filled #RoleButton SIText#text.body-xs-strong, .position--filled #RoleButton SIText.body-xs-strong {
    font-size: 11px;
    -unity-font-definition: var(--schrift-heft-eng-600); /* kräftiger, die dünne Figtree war kaum lesbar (Jonas) */
}

/* Ergebnisse in Spielkarten (Wettbewerb, News; Vorlagen CompetitionFixturesListItem/NewsFixtureListItem): SI gibt dem
   Heimergebnis body-sm-strong, dem Auswärtsergebnis keine Klasse; es stand in anderer Schrift und Größe (Jonas
   10.11.2026, „die Nullen sind größer“). Beide gleich. */
#FixtureInfo #HasResultsSwitch > SIText {
    -unity-font-definition: var(--schrift-heft-dunkel-500);
    font-size: var(--typography-size-14);
}

/* Taktik-Knopf im Kopf der Mannschaftsansprache (#ButtonElements SIButton#tactic, Jonas 10.11.2026, „nicht unser
   Styling“): Petrolgrund, Rahmen, runde Ecken und Bild setzt FM per Code am Element, kein Skin erreicht sie (im Spiel
   geprüft, auch ein Hintergrundbild kam nicht durch). Nur die Schrift im Knopfschnitt, weiß auf Petrol. */
#ButtonElements SIButton#tactic SIText {
    -unity-font-definition: var(--schrift-heft-knopf-500);
    font-size: 14px;
}
#ButtonElements SIButton#tactic VisualElement.game-concepts-training-tactics_small {
    -unity-background-image-tint-color: #FFFFFF; /* fest */
    --unity-image-tint-color: #FFFFFF;
}

/* Fußleiste der Einstellungen (Jonas 10.11.2026, „ungerade Linie“): SIs Leiste war nur so breit wie die Knöpfe ohne
   Community/Support, die Knopfreihe lief rechts aus dem Blatt („Bestätigen“ abgeschnitten, im Deutschen sichtbar). Über
   die ganze Kartenbreite. Community und Support liegen bei SI absolut links darüber und schoben sich bei den breiteren
   deutschen Knöpfen unter „Skin neu laden“ (Jonas 10.11.2026, „Überlauf“): ausgeblendet, beide stehen auch im
   FM-Menü (Zahnrad, Vorlage FMMenu). */
.figma-base-card-modal-surface #CommunitySupportLinks, .figma-base-card-modal-surface #CommunitySupportLinks * {
    visibility: hidden; /* display setzt SIVisible per Code */
}
/* Skinauswahl daneben wie die Knöpfe (Jonas 10.11.2026): unten bündig (stand mittig, 1,3 Einheiten höher) und im
   Knopfschnitt statt Namensschnitt mit Tintenkontur. */
.figma-base-card-modal-surface #reload-skin-button > #skin-chooser-selection {
    align-self: flex-end;
}
.figma-base-card-modal-surface #skin-chooser SIText,
.figma-base-card-modal-surface #skin-chooser SIText#text.sitext.body-md.content-no-wrap.content-ellipsis.sitext-hover-cursor.margin-left-global-gap-small {
    -unity-font-definition: var(--schrift-heft-knopf-500);
    font-size: 14px;
}
.figma-base-card-modal-surface > VisualElement.row-direction-normal.align-items-start.justify-content-start.flex-grow-class {
    align-self: stretch;
}
.figma-base-card-modal-surface > VisualElement.row-direction-normal.align-items-start.justify-content-start.flex-grow-class > VisualElement.row-direction-always-normal.justify-content-end {
    flex-grow: 1;
}

/* Dialoge (Spielstand speichern/laden, Rückfragen; Jonas 02.11.2026): SIs Dialogebene hat keine Abdunkelung, der Zettel
   lag ohne Abstand auf dem Bildschirm. Dahinter ein Tintenschleier. */
Panel#GenericModalDialog {
    background-color: rgba(20, 19, 16, 0.55); /* fest */
}

/* SI-TV vor dem Anpfiff, nachgeschärft nach Bildern aus dem Spiel (Jonas 02.11.2026):
   - Kopf: um den Vereinsnamen lag unsere Tintenkontur, die Unterzeile („16. in LaLiga“) im gedünnten Schnitt mit Kontur
     war auf dunklem Kopf (Bilbao) unlesbar. FM färbt beide in Vereinsfarbe; ohne Kontur, Unterzeile ungedünnt.
   Farben (Namen, Ersatzbank, Kapitänsbinde, Tabelle) kommen seit dem Abend aus SIs eigenen Werten (tv_restore_uss in
   heft_test.py); feste Weiß-Regeln hier machten danach die Namen weiß auf SIs weißen Feldern (La Liga, Jonas). */
.team-lineup-sitv-header SIText {
}
.team-lineup-sitv-header SIText.team-lineup-sitv-header-subtext {
    -unity-font-definition: var(--schrift-heft-text-400);
}

/* Anzeigetafeln im Spiel (EFL League One, Jonas 02.11.2026): die Spielzeit stand weiß im weißen Kasten. FM schreibt sie
   mit .tifo-text-neutral-black (var(--colours-base-neutral-black)), und unsere Spiegelung macht dieses Schwarz hell. Auf
   den Tafeln wieder schwarz, wie bei SI (gilt für alle Tafeln mit dieser Klasse: EFL, Bundesliga, Europa League …). */
#ScoreBug SIText.tifo-text-neutral-black {
}

/* Markierung unter dem gewählten Menüpunkt der Vereinsleiste (Jonas 02.11.2026): SIs Strich trägt die gespiegelte
   Textfarbe, ein Tintenstrich unter weißer Schrift auf der Vereinsfarbe. Wie die Schrift: auf dunkler Leiste weiß,
   auf heller (weiße Vereinsfarben) Tinte. */
#MainNav.nav-on-dark VisualElement#Chip.navigation-chip {
    background-color: #FFFFFF; /* fest */
}
#MainNav.nav-on-light VisualElement#Chip.navigation-chip {
    background-color: #1C1A16; /* fest */
}

/* Knopfleisten oben im Spiel (Jonas 02.11.2026: „Zettel wie unten in der Leiste, sonst zwei Stile“): statt einzelner
   heller Etiketten je Gruppe ein Papierstreifen wie die Spielerleiste unten (gleiche Tönung), der von oben ins Bild
   hängt (oberer Rand abgeschnitten, wie der Zettel in der Vereinsleiste). Die Knöpfe ohne eigene Fläche, getrennt
   durch Haarlinien; Pause in Tinte statt weiß auf Blau. Rechts haben die Gruppen eine feste Höhe (sonst schob der
   Innenabstand die Symbole aus dem Bild). */
#ScoreBug VisualElement#Left-part, #ScoreBug BindingExpect#Controls, #ScoreBug SIButton#stats-button {
    background-image: var(--bild-haengeblatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F2EBDC;
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-radius: 0;
    margin-top: -14px;
    padding-top: 0; /* kurz von oben, die Knöpfe reichen bis an den Rand (Jonas: zu viel Luft oben) */
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
}
#ScoreBug BindingExpect#Controls, #ScoreBug SIButton#stats-button {
    height: 41px;
    min-height: 41px;
    max-height: 41px;
}
#ScoreBug VisualElement#Left-part SIButton, #ScoreBug VisualElement#Left-part SIFloatingPopupWidget,
#ScoreBug VisualElement#Left-part SIDropdown, #ScoreBug BindingExpect#Controls SIButton {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-right-width: 1px;
    border-right-color: #1C1A1640; /* fest */
    border-radius: 0;
    padding-top: 8px; /* Trennlinien bis zum oberen Rand, Inhalt unter der abgeschnittenen Kante */
}
#ScoreBug BindingExpect#Controls SIButton#playpause {
    border-right-width: 0;
}
#ScoreBug BindingExpect#Controls SIButton#playpause SIImage.unity-image {
    --unity-image-tint-color: #E3E1DB;
}
/* Die drei Punkte (Spielsteuerung ein/aus): ein Schalter in einem Behälter mit SIs blauer Fläche. */
#ScoreBug BindingExpect#Controls BindingVariables.buttons-me-menu-controls-base--position-middle,
#ScoreBug BindingExpect#Controls SICheckBox, #ScoreBug BindingExpect#Controls SICheckBox VisualElement {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
}
#ScoreBug BindingExpect#Controls BindingVariables.buttons-me-menu-controls-base--position-middle {
    border-right-width: 1px;
    border-right-color: #1C1A1640; /* fest */
}
#ScoreBug BindingExpect#Controls SICheckBox VisualElement#image {
}

/* Reiter im Taktik-Bildschirm des Spiels (Taktik, Standards, Elfmeter, Gegneranweisungen; Jonas 02.11.2026): SIs
   Reitergruppe lief als heller Streifen über die ganze Breite. Jetzt ein hängender Zettel, so breit wie die Reiter. */
#BindingExpect_TopBarTacticsButtonGroup ButtonGroup#ButtonGroup.buttongroup.largetabs {
    align-self: flex-start;
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-radius: 0;
    background-image: var(--bild-haengeblatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F2EBDC;
    margin-top: -14px;
    padding-top: 12px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 12px;
}

/* „Was ist neu in FM27?“ (Jonas 02.11.2026): ein graues Fenster mit runden Ecken, darüber ein dunkler Musterschleier
   (der alles abdunkelte), die Einträge als graue Kästen. Ein Heftblatt; Schleier aus, das Hintergrundbild darunter
   unsichtbar (sein Inhalt sichtbar), die Einträge ohne Kasten, durch Haarlinien getrennt; dahinter der Tintenschleier
   wie bei den Dialogen. */
VisualElement#WhatsNewPanel-NonPhone.whatsnew-panel {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-radius: 0;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #FFFFFF;
    overflow: visible;
}
.whatsnew-panel VisualElement#TintPatternsImage.whatsnew-background-overlay {
    opacity: 0;
}
.whatsnew-panel SIImage#BGImage {
    --unity-image-tint-color: #00000000;
}
.whatsnew-panel SIImage#BGImage > * {
    --unity-image-tint-color: #FFFFFF;
}
.whatsnew-panel VisualElement#WhatsNewDialogRow.whatsnew-row-item {
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-radius: 0;
    border-bottom-width: 1px;
    border-bottom-color: #1C1A1626; /* fest */
}
BindingRoot.block-background {
    background-color: rgba(20, 19, 16, 0.55); /* fest */
}
/* Lesbarkeits-Rundgang 03.11.2026 (Mitschrift, research/tools/mitschrift_rundgang.ps1): Stellen unter 3:1. */
/* Info neben Hinweisen (Kopf in Standards): FM tönt das Symbol dort per Code blass lavendel, das schlägt jede
   Tönung. Die Tönung multipliziert nur, also ein Info-Symbol in Tinte als Bild. */
VisualElement.ui-concepts-more-info_small.ui-icon-no-fill-background {
    background-image: var(--bild-infotinte);
}
/* Weiße Symbole auf Papier: Kopfsymbole der Taktischen Effektivität, das weiße Verletzten-Plus (Kopf der
   Medizinischen Abteilung, Mitarbeiter-Kachel der Kaderplanung, Jonas 03.11.2026). In Tinte. */
.tactical-effectiveness-breakdown .tactic_icons-match, .tactical-effectiveness-breakdown .tactic_icons-buy-in-level,
.scaling-icons-condition-level-injured---white-size-small-16px, .scaling-icons-condition-level-injured---white-size-medium-24px,
.scaling-icons-condition-level-injured---white-size-large-32px {
    -unity-background-image-tint-color: #E3E1DB;
}
/* Kleine Nachrichtenkacheln (Wappen, Spielerfoto, Ergebnis): SI legt sie auf Vereinsfarbe, als Fläche per Code
   (SIStyleSetter) oder als Verlauf zweier Vereine (SIGradient). Vereinsfarbe gehört nur in die Leiste (Jonas
   03.11.2026: aufs Papier). Papier als Bild über die Code-Fläche, der Verlauf unsichtbar, sein Inhalt sichtbar, eine
   Haarlinie um die Kachel. Das Ergebnis darauf druckt dann in Tinte. */
#headlineContent > .pane-container {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F2EBDC;
    border-width: 1px;
    border-color: #1C1A1626; /* fest */
}
#headlineContent > .pane-container SIStyleSetter {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F2EBDC;
}
#headlineContent > .pane-container SIGradient.sigradient {
    visibility: hidden;
}
#headlineContent > .pane-container SIGradient.sigradient > * {
    visibility: visible;
}
#headlineContent > .pane-container #Clubs > SIText#static_text.fm-universe-20px {
}
/* Unter dem Ergebnis legt SI einen dunklen Streifen (#Textfilter, 65 % Schwarz) für weiße Schrift auf Foto. Auf
   Papier nicht nötig. */
#headlineContent > .pane-container .textfilter_bk {
    background-color: rgba(0, 0, 0, 0); /* fest */
}
/* Rückennummer in der Spielerkarte: FM setzt Trikotfarbe und Nummernfarbe per Code, die Tintenkontur übermalte die
   Nummer dunkelrot auf Rot (Mitschrift 03.11.2026, Jonas). Normale Schrift ohne Kontur, dann gilt FMs Nummernfarbe. */
.data_display-player-report-header-squad-number-type-standard SIText {
    -unity-font-definition: var(--schrift-heft-text-400);
    white-space: nowrap; /* zweistellige Nummern brachen im 24-px-Kasten um (Jonas 04.11.2026) */
}
/* Positionssymbol in der Kaderliste (Aufgestellt): weiß, auf grauen Feldern unsichtbar. Tinte. */
FMPitchPositionIcon#PositionIcon.pitch-position-icon-picked {
    -unity-background-image-tint-color: #E3E1DB;
}
/* Aktualisieren-Symbol in den Auswahlknöpfen (Trainingsintensität): eine SI-Regel tönte es weiß. Tinte. */
VisualElement.align-items-center.justify-content-center.ui-concepts-refresh_small {
    -unity-background-image-tint-color: #E3E1DB;
}
/* Wettbewerbskarten (Wettbewerbe, DFB-Pokal-Ziel): SI legt eine halbdurchsichtige Wettbewerbsfarbe per Code über den
   Kopf. Unsichtbar, ihr Inhalt sichtbar. */
SIStyleSetter.competition_header_opacity {
    visibility: hidden;
}
SIStyleSetter.competition_header_opacity > * {
    visibility: visible;
}
/* Wertungskasten ohne Wertung: der weiße Strich (Jonas) hatte auf dem grauen Kasten nur 2,5:1. Kasten dunkler. */
.data_display-average_rating-default-default-rating-null {
    background-color: #5E574B; /* fest */
}
/* Kaderplaner: das gewählte Feld ist blau, die Position stand grau darauf. Weiß. */
.input-squad-planner-data-point-regular-type-ability-mode-dark-active-true #PositionText,
.input-squad-planner-data-point-regular-type-ability-mode-light-active-true #PositionText,
.input-squad-planner-data-point-regular-type-ability-mode-mixed-active-true #PositionText,
.input-squad-planner-data-point-regular-type-depth-mode-dark-active-true #PositionText,
.input-squad-planner-data-point-regular-type-depth-mode-light-active-true #PositionText,
.input-squad-planner-data-point-regular-type-depth-mode-mixed-active-true #PositionText,
.input-squad-planner-data-point-regular-type-position-mode-dark-active-true #PositionText,
.input-squad-planner-data-point-regular-type-position-mode-light-active-true #PositionText,
.input-squad-planner-data-point-regular-type-position-mode-mixed-active-true #PositionText {
}

/* TV-Grafiken der Wettbewerbe: Schriftklassen ohne eigene Farbe weiß wie im Original (85 Klassen, aus SIs Stilblättern). */
SIText.bundesliga-broadcast-stage,
