/* TV-Grafiken im Spiel: SIs eigene Farben (siehe tv_restore_uss in heft_test.py). */
Panel#TeamLineupPanel, Panel#PreMatchLeagueTablePanel, Panel#PenaltyShootoutPanel, DynamicItem.fm-scoreboard, #ScorebugOverlay, #BindingExpect_SubsPopup, #BindingExpect_SubsPopup_Bundesliga, #BindingExpect_SubsPopup_UEFAWomensChampionsLeague, #BindingExpect_VarPopup, #BindingExpect_VARPopup, #BindingExpect_VARPopup_Bundesliga, #BindingExpect_VARPopup_UEFAWomensChampionsLeague, #VarPopup, #BindingExpect_GoalScoredPopup, #BindingExpect_GoalScoredPopup_Bundesliga, #BindingExpect_GoalScorePopup_UEFAWomensChampionsLeague, #BindingExpect_CardPopup_Bundesliga, #BindingExpect_CardPopup_UEFAWomensChampionsLeague, #BindingExpect_GoalDisallowedPopup_UEFAWomensChampionsLeague, #BindingExpect_LowerThirdPopup, VisualElement#InfoBlock, VisualElement#InfoFrame {
