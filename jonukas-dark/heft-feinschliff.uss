SIText.fifa-wc2026-font-condensed-black,
SIText.fifa-wc2026-font-normal-black,
SIText.fifa-wc2026-font-normal-light,
SIText.fifa-wc2026-font-normal-medium,
SIText.fifa-wc2026-font-ultracondensed-black,
