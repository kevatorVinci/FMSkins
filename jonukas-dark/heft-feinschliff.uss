    --colours-brand-highlight-pink: #DA71FE;
    --colours-brand-highlight-pink-40: #DA71FE66;
    --colours-brand-highlight-pink-base: #EB85FF;
    --colours-brand-primary-08: #A300DB14;
    --colours-brand-tints-horizon-120: #C299FF;
    --colours-brand-tints-horizon-alpha-20: #AF78FF33;
    --colours-brand-tints-horizon-alpha-30: #AF78FF4D;
    --colours-brand-tints-horizon-alpha-8: #AF78FF14;
    --colours-brand-tints-twilight-120: #8B3FDF;
    --colours-feature-draft-shortlist-alpha-16: #E664FF29;
    --colours-feature-draft-shortlist-alpha-24: #E664FF3D;
    --colours-feature-draft-shortlist-alpha-32: #E664FF52;
    --colours-feature-draft-shortlist-alpha-40: #E664FF66;
    --colours-feature-draft-shortlist-alpha-48: #E664FF7A;
    --colours-feature-draft-shortlist-alpha-8: #E664FF14;
    --colours-feature-draft-shortlist-base: #E664FF;
    --communication-accessibility-focus: #DA71FE;
    --communication-feedback-information: #DA71FE;
    --communication-player-on-loan: #DA71FE;
    --continue-button-default-background: #E50F51;
    --continue-button-default-background-hover: #F23670;
    --continue-button-default-background-secondary: #FF4164;
    --continue-button-default-border: #FF4164;
    --continue-button-default-grad-l: #A40FC7;
    --continue-button-default-grad-r: #A40FC700;
    --continue-button-standard-surface-gradient-l: #6E0FD7;
    --continue-button-standard-surface-gradient-r: #6E0FD700;
    --continue-button-standard-surface-hover-gradient-l: #8B3FDF;
