    background-image: var(--bild-leer);
}
/* Control bar cards (Advice, Aufgaben ...) lay a gradient and a rounded border over the button, which tinted
   the paper blue (seen in game 23.10.2026). */
.control_bar_wrapper {
    --start-colour: #00000000;
    --end-colour: #00000000;
}
/* ... and inside it two code-coloured gradients in club colours (tinted the cards blue for HSV). Club colours
   belong on the bar only (magazine rule), so the gradients go. */
.control_bar_wrapper, .control_bar_button > SIGradient {
    display: none;
}
.control_bar_wrapper_border {
    border-width: 0;
}
/* Air above the deckle edge: many tiles (profile: Zufriedenheit, Training ...) have content of fixed height
   down to the bottom edge; padding only made it overflow (tested with tint colours in game 23.10.2026). The
   title row (34 px) gives 6 px instead, the compact Barlow heads need less. */
.tile-title-frame {
    height: 28px;
    min-height: 28px;
    margin-right: 10px;
}
/* Figma utility classes with a container radius that no radius token reaches (border-radius-global-border alone
   sits on 57 templates, e.g. the frame of the match preview around a sheet). Smaller ones stay for controls. */
.border-radius-global-border, .border-radius-global-border-large, .border-radius-8, .border-radius-16,
.border-radius-border-radius-radius-8, .border-radius-border-radius-radius-12 {
    border-radius: 0;
}
/* Foot of a block ("Tabelle minimieren / Kacheln anzeigen"): SI's own grey bar with round corners; now a strip of
   the same paper under a hairline, so it reads as the bottom of the sheet above it. */
.recruitment-player-search-foldout-bar {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #DCDCDC;
    border-top-width: 1px;
    border-top-color: #F2EBDA24;
    border-radius: 0;
}
.recruitment-player-search-foldout-bar:hover {
    background-color: #00000000;
    -unity-background-image-tint-color: #FFFFFF;
}
/* Inbox list: an inline style paints it dark; the edgeless fibre on top continues the sheet. */
.messages-tile-background #Messages {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #DCDCDC;
}
/* Rubric heads like the magazine's kicker: ink instead of a coloured link. No rule under it (SI draws one as a thick
   bottom border, ours was 2 px ink; Jonas 03.11.2026: no underlines anywhere). */
.title-link-primary-text {
    letter-spacing: 1px;
    font-size: 17px;
}
.title-link-button, .title-link-button:hover, .title-link-button:active:enabled {
    border-bottom-width: 0;
}
.title-link-button:hover .title-link-primary-text {
}
.tile-title-color {
    letter-spacing: 1.5px;
}
/* Club overview finances: the chart draws its value axis left of its own box, which ran off the sheet (seen in
   game 23.10.2026); room for the labels inside. */
/* Finance page (Jonas 31.10.2026): projections, income and expenditure draw their value axis left of the box too,
   into the neighbouring chart, and their date axis below it onto the dividers and table heads. Room on both sides;
   FM draws about eleven value ticks into a short chart, so the labels go one size down. */
.fm-finance-graph-overal, .fm-finance-graph-projections, .fm-finance-graph-income, .fm-finance-graph-expenditures {
    padding-left: 92px;
    margin-bottom: 24px;
    --axis-font-size: 10;
}
/* Projections were the flattest chart, its eleven value labels stacked into each other (takes effect on the next
   page build, not on the reload itself). */
.silinechart.fm-finance-graph-projections {
    height: 150px;
    min-height: 150px;
    --axis-font-size: 8;
}
/* League history (club history, club profile): the season labels under the axis were cut by the legend below. */
.fm-league-history-chart {
    margin-bottom: 22px;
}
/* The other money charts (finance summary, budgets, wages) draw the same value axis: room for it as well. */
.fm-finance-chart, .fm-financial-history-chart, .fm-budget-chart, .fm-budget-graph, .fm-budget-wage-graph,
.fm-wage-expenditure-history-chart, .fm-recruitment-chart {
    padding-left: 92px;
}
