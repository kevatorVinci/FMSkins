/* Every tile = a sheet of dark paper. The 9-slice keeps the deckle edge, the centre tiles the fibre. */
.layout-tile-base-container {
    border-radius: 0;
}
.surfaces-card-tile-border {
    border-width: 0;
    border-radius: 0;
}
.layout-tile-interaction-button.layout-tile-interaction-button-background {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #DCDCDC;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}
.layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
.layout-tile-interaction-button.layout-tile-interaction-button-background:active:enabled {
    background-color: #00000000;
    -unity-background-image-tint-color: #FFFFFF;
}
/* Tiles with a picture (news, static news) or a club gradient (fixture) behind the button, and the main
   menu tiles, keep SI's look (empty image, see below). */
#background-image > .layout-tile-interaction-button,
#background-gradient > .layout-tile-interaction-button,
.startScreenTile .layout-tile-interaction-button {
    background-image: var(--bild-leer);
}
/* The tactics tile paints its base container green (--pitch-tile-default-background), which showed through
   the torn edge (seen in game 23.10.2026). */
.layout-tile-tactics .layout-tile-base-container {
    background-color: #00000000;
}
/* Blocks (squad list, inbox, news + table, control bar cards) are no tiles: they carry the block surface
   classes (10 classes, border-color-... alone in 487 templates). Half slice scale, as blocks
   can be small. The width rule does not win everywhere (FM drew 1.3 px around the squad list), so the colour goes
   transparent too: the sheet's own edge and shadow lie inside, the frame showed as a box around it (Jonas 31.10.2026). */
.border-color-layout-modules-block-border-colour, .siblock-border, .block-border-only, .layout-block-base-container, .frame-panel-squad, .message-container-frame, .figma-base-card-template-inner-frame, .control_bar_button, .control_bar_button_container_min, .frames-player-attributes-full-block-size-max-rows {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #DCDCDC;
    border-width: 0;
    border-color: #00000000;
    border-radius: 0;
}
/* A sheet inside a sheet showed as two overlapping scraps (news headline tile on the portal block, seen in game
   23.10.2026): only the outermost holder is paper. "background-image: none" has no effect in FM27's skin
   decoder, an empty image does. */
.layout-tile-interaction-button-background .layout-tile-interaction-button.layout-tile-interaction-button-background,
.layout-tile-interaction-button-background .border-color-layout-modules-block-border-colour,
.layout-tile-interaction-button-background .siblock-border,
.layout-tile-interaction-button-background .block-border-only,
.layout-tile-interaction-button-background .layout-block-base-container,
.layout-tile-interaction-button-background .frame-panel-squad,
.layout-tile-interaction-button-background .message-container-frame,
.layout-tile-interaction-button-background .figma-base-card-template-inner-frame,
.layout-tile-interaction-button-background .frames-player-attributes-full-block-size-max-rows,
.states-templates-tile-content .layout-tile-interaction-button.layout-tile-interaction-button-background,
.states-templates-tile-content .border-color-layout-modules-block-border-colour,
.states-templates-tile-content .siblock-border,
.states-templates-tile-content .block-border-only,
