.tactics-radio-buttons .unity-radio-button-group__child-active, .tactics-radio-buttons .list-item-radio-button-style.unity-radio-button-group__child-active:hover {
    border-color: #433F35;
}

.tactics-collapsable-pitch-container, .tactics-collapsable-pitch-container-with-darker-header,
.tactics-subs-block {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
    border-radius: 0;
}

.tactics-nav-primary-actions-property-1-base, .tactics-nav-secondary-actions-property-1-team-shape {
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
}

/* SI's code gradient behind the rows showed as fine green lines in the joints (seen in game 23.10.2026): the
   rows overlap by 2 px and the gradient colours are set to paper as well. */
.tactics-nav-primary-actions-property-1-base {
    margin-bottom: -2px;
}

.tactics-nav-secondary-actions-property-1-team-shape {
    flex-grow: 1;
    border-radius: 0;
}

.frame-tactics-nav-menu {
    border-width: 0;
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    --start-colour: #E1DCCA;
    --end-colour: #E1DCCA;
    background-image: var(--bild-flaeche);
    -unity-slice-left: 1;
    -unity-slice-right: 1;
    -unity-slice-top: 1;
    -unity-slice-bottom: 1;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
}

/* ---- repris de heft-feinschliff.uss ---- */
/* Aktiver Taktik-Umschalter: FM schreibt hell auf Farbe, Kontur in Weiss. Aktive Segmente (Mit Ball, Dieser Monat):
   ihr Grund kommt mal vom Knopf, mal von einem Kindelement, mal hell, mal dunkel. Schrift deshalb in Tinte, aktiv
   markiert ein Tintenstrich unten wie im Heft (den Rand zeichnet der Knopf selbst, kein Kind deckt ihn). */
.buttons-button-tactics-toggle-default--toggle-true SIText {
    -unity-text-outline-color: #FFFFFF;
}

/* Ausnahme: Reiter der Taktik (Formationen, Teamanweisungen) sind auch eine Segmentgruppe, liegen aber als Reiter auf
   Papier; aktiv in Tinte. */
.tactical-tweaks-tabs .tactical-tweaks-tab--active-true.buttongroup__button--active SIText {
    color: #1C1A16;
    -unity-text-outline-color: #1C1A16;
}

#TacticalPlannerTool .components-frames-team-selection-table {
    background-image: var(--bild-blatt);
    -unity-slice-scale: 0.8;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Zurufe und Anpassungen im Spiel: SIs dunkles Klappfeld war gespiegelt ein graues Feld mit dunklen Symbolkästen.
   Ein Blatt; die Symbole stehen in Tinte auf einem Hauch Tinte. */
.tactical-tweaks-panel {
    background-color: #00000000;
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0;
    padding-bottom: 14px; /* die Liste endete unter der Risskante */
}

.tactical-shout-icon-container-dark {
    background-color: #1C1A1614;
}

.tactical-shout-icon-container-dark SIImage {
    --unity-image-tint-color: #1C1A16;
}

/* Taktik im Spiel (Jonas 01.11.2026): die Teamanweisungen lagen ohne Papier über dem Spielfeld. Die ganze Karte
wird ein Blatt; die Anweisungskacheln heben sich beim Hover nicht (der Schatten stand hart auf der Karte); die
   Reiter oben (Taktik,
Standards,
Elfmeter,
Gegneranweisungen) bekommen einen Papierzettel; auf der Taktiktafel
   stehen Namen und Rollen weiß auf dem Rasen. */
#MatchTactics #Body > BindingRemapper > .grid-element--Block,
#TacticalPlannerTool #Body > BindingRemapper > .grid-element--Block,
#FullScreenTeamSelection #Body > BindingRemapper > .grid-element--Block {
    background-image: var(--bild-blatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-background-image-tint-color: #F7F7F7;
    border-width: 0; /* Papierbild: kein Rahmen ums Blatt */
}

/* Innen keine weiteren Blätter: Papier auf Papier gab doppelte Risskanten und Schatten (Jonas). Die Kacheln sind
flache Felder mit Haarlinie. */
#MatchTactics #Body .grid-element--Block .grid-element--Block,
#TacticalPlannerTool #Body .grid-element--Block .grid-element--Block,
#FullScreenTeamSelection #Body .grid-element--Block .grid-element--Block,
#MatchTactics #Body .grid-element--Block .layout-block-base-container,
#TacticalPlannerTool #Body .grid-element--Block .layout-block-base-container,
#FullScreenTeamSelection #Body .grid-element--Block .layout-block-base-container,
#MatchTactics #Body .grid-element--Block .siblock-border,
#TacticalPlannerTool #Body .grid-element--Block .siblock-border,
#FullScreenTeamSelection #Body .grid-element--Block .siblock-border {
    background-image: var(--bild-leer);
    background-color: #00000000;
}

#MatchTactics .layout-tile-interaction-button.layout-tile-interaction-button-background,
#TacticalPlannerTool .layout-tile-interaction-button.layout-tile-interaction-button-background,
#FullScreenTeamSelection .layout-tile-interaction-button.layout-tile-interaction-button-background,
#MatchTactics .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#TacticalPlannerTool .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#FullScreenTeamSelection .layout-tile-interaction-button.layout-tile-interaction-button-background:hover {
    background-image: var(--bild-leer);
    background-color: #1C1A1608;
    border-width: 1px;
    border-color: #1C1A1626;
    border-radius: 3px;
    translate: 0 0;
    rotate: 0deg;
}

#MatchTactics .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#TacticalPlannerTool .layout-tile-interaction-button.layout-tile-interaction-button-background:hover,
#FullScreenTeamSelection .layout-tile-interaction-button.layout-tile-interaction-button-background:hover {
    background-color: #1C1A1614;
}

#TopBarTacticsButtonGroup #ButtonGroup {
    background-color: #E6E3DA; /* fest */
    border-width: 1px;
    border-color: #1C1A1640;
    border-radius: 3px;
}

#TopBarTacticsButtonGroup SIText {
    color: #1C1A16; /* fest */
}

#team-instruction-header .sink_containment,
#TacticalPlannerTool #Body .sink_containment,
#FullScreenTeamSelection #Body .sink_containment,
#MatchTactics #Body .sink_containment {
    background-color: #00000000;
    border-width: 0;
}

/* Die drei Spalten der Taktikkarte (Tafel, Anweisungen, Übersicht) liegen ohne Rahmen und Fläche auf dem Blatt
(Jonas: einheitlich,
„die Begrenzungen der Innenkästen braucht es nicht“). */
#MatchTactics #Body .grid-element--Block .grid-element--Block,
#TacticalPlannerTool #Body .grid-element--Block .grid-element--Block,
#FullScreenTeamSelection #Body .grid-element--Block .grid-element--Block {
    background-color: #00000000;
    border-width: 0;
}

#MatchTactics #Body .grid-element--Block .grid-element--Block .border-color-layout-modules-block-border-colour,
#TacticalPlannerTool #Body .grid-element--Block .grid-element--Block .border-color-layout-modules-block-border-colour,
#FullScreenTeamSelection #Body .grid-element--Block .grid-element--Block .border-color-layout-modules-block-border-colour {
    border-width: 0;
}

/* Taktik im Spiel, ruhiger (Jonas 01.11.2026): Tafel, Ersatzbank und Aufstellungstabelle sind außerhalb des Spiels
eigene Blätter auf dem Tisch; auf dem großen Blatt der Spieltaktik gaben sie Risskanten auf Papier. Hier flache
   Felder ohne Rahmen wie die Anweisungsspalten. */
#MatchTactics .tactics-collapsable-pitch-container,
#TacticalPlannerTool .tactics-collapsable-pitch-container,
#FullScreenTeamSelection .tactics-collapsable-pitch-container,
#MatchTactics .tactics-collapsable-pitch-container-with-darker-header,
#TacticalPlannerTool .tactics-collapsable-pitch-container-with-darker-header,
#FullScreenTeamSelection .tactics-collapsable-pitch-container-with-darker-header,
#MatchTactics .tactics-subs-block,
#TacticalPlannerTool .tactics-subs-block,
#FullScreenTeamSelection .tactics-subs-block,
#MatchTactics .components-frames-team-selection-table,
#TacticalPlannerTool .components-frames-team-selection-table,
#FullScreenTeamSelection .components-frames-team-selection-table {
    background-image: var(--bild-leer);
    background-color: #00000000;
    border-width: 0;
}

/* Das Blatt hat einen Rand aus Schnittkante und Schatten; die Knöpfe unten rechts (Bestätigen) ragten darüber
hinaus (Jonas). Innenabstand bis zur Papierkante. */
#MatchTactics #Body > BindingRemapper > .grid-element--Block,
#TacticalPlannerTool #Body > BindingRemapper > .grid-element--Block,
#FullScreenTeamSelection #Body > BindingRemapper > .grid-element--Block {
    padding-left: 6px;
    padding-right: 8px;
    padding-bottom: 8px;
    -unity-slice-scale: 0.5; /* schmalere Schnittkante, wie die Blätter der Taktiktafel */
}

/* Teamanweisungen der Taktikübersicht: FM rechnet die drei Spalten 27 px höher als den Platz auf der Karte, sie
   ragten unten über die Risskante (Jonas). Begrenzt auf die Kartenhöhe; die Spalten scrollen selbst. */
#TacticalPlannerTool #TeamInstructionsTabGrid .si-tile {
    max-height: 688px;
}

/* Die Übersichtsspalte rechts ist ein eigener Blockrahmen mit Blatt: heller als die beiden anderen Spalten. */
#MatchTactics #Body .grid-element--Block .border-color-layout-modules-block-border-colour,
#TacticalPlannerTool #Body .grid-element--Block .border-color-layout-modules-block-border-colour,
#FullScreenTeamSelection #Body .grid-element--Block .border-color-layout-modules-block-border-colour {
    background-image: var(--bild-leer);
    background-color: #00000000;
}

/* Spielerkärtchen auf der Taktiktafel: der weiße Namensteil trägt links, rechts und unten einen dunklen Rand, die
   Rollenleiste darüber nicht; das sah nach Versatz aus (Jonas). Kein Rand am Namensteil, dafür eine Haarlinie um
   das ganze Kärtchen. */
.tactics-visualiser-player-bottom-border {
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
}

.layout-tile-interaction_border_tactics {
    border-width: 1px;
    border-color: #1C1A1659;
}

/* Aktive taktische Anpassungen: die Symbole auf den dunklen Plaketten waren teils Tinte, teils weiß (Jonas). */
.tactical-tweak-row__icon-badge, .tactical-tweak-row__icon-badge * {
    -unity-background-image-tint-color: #FFFFFF; /* fest */
    --unity-image-tint-color: #FFFFFF; /* fest */
}

/* Der Ring um das Spielerkärtchen beim Ziehen: dicker, damit die Eignung auf den ersten Blick auffällt (Jonas). */
.frame-330-tactics-visualiser-player-indicator {
    border-width: 3px;
}

/* Beim Ziehen markiert FM die passenden Spieler in der Aufstellungstabelle; gespiegelt war das Grau (Jonas: bläulich). */
.tactics-row-highlight-highlighted {
    background-color: #5B9BD54D; /* fest */
}

/* Taktikseiten (vor dem Spiel, Übersicht, im Spiel): die drei Spalten sind höher als der Platz auf dem Blatt und
   ragten unten über die Kante (Jonas 02.11.2026). Begrenzt; die Anweisungen scrollen, die Tafel wird kürzer. */
#FullScreenTeamSelection #TeamInstructionsTabGrid BlockElement.grid-element--Block,
#TacticalPlannerTool #TeamInstructionsTabGrid BlockElement.grid-element--Block,
#MatchTactics #TeamInstructionsTabGrid BlockElement.grid-element--Block {
    max-height: 688px;
    overflow: hidden;
}

#FullScreenTeamSelection #TeamInstructionsTabGrid BindingRemapper#pitch-remapper,
#TacticalPlannerTool #TeamInstructionsTabGrid BindingRemapper#pitch-remapper,
#MatchTactics #TeamInstructionsTabGrid BindingRemapper#pitch-remapper {
    max-height: 676px;
}

/* Taktik (Mannschaftsauswahl vor dem Spiel, Taktikübersicht): die beiden Kopfzeilen (Taktikwahl, Formationen/
   Teamanweisungen) trugen eigenes randloses Papier über dem großen Blatt, ein hellerer Kasten mit geraden Kanten, der
   über die Blattkante ragte (Jonas 02.11.2026). Ohne eigene Fläche: das Blatt trägt alles. */
SIGradient.sigradient.frame-tactics-nav-menu,
.frame-tactics-nav-menu .tactics-nav-primary-actions-property-1-base,
.frame-tactics-nav-menu .tactics-nav-secondary-actions-property-1-team-shape {
    background-image: none;
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
}

/* SIs Verlauf setzt seine Farben per Code (grün): das Verlaufselement unsichtbar, sein Inhalt sichtbar. */
SIGradient.sigradient.frame-tactics-nav-menu {
    visibility: hidden;
}

SIGradient.sigradient.frame-tactics-nav-menu > * {
    visibility: visible;
}

.frame-tactics-nav-menu .tactics-nav-secondary-actions-property-1-team-shape {
    border-bottom-width: 1px;
    border-bottom-color: #1C1A1626; /* fest */
}

/* Zurufe/Anpassungen im Spiel (Jonas 02.11.2026): sie öffnen wieder richtig, aber hinter unserem Zettel lag der flache
   Papierbehälter aller Aufklappmenüs als zweiter Kasten (er schien durch den durchsichtigen Blattrand). Der Behälter
   lässt sich nicht nur hier ausblenden (kein Elternwähler in USS); der Zettel ragt deshalb um seinen Rand über den
   Behälter hinaus und deckt ihn. Das Info-Symbol rechts in Tinte statt fast weiß. */
.floating-element .tactical-tweaks-panel {
    margin: -10px;
    padding: 10px 10px 24px 10px; /* gleicht den Überstand aus, Symbole und Reiter lagen sonst an der Kante */
}

/* Das Info-Symbol trägt SIs helle Tönung im Inline-Stil der Vorlage (info-widget-small-transparent), keine Farbregel
   erreicht es. Es liegt deshalb auf einem kleinen Tintenpunkt (sein Rahmenelement): hell auf dunkel, wie ein Info-Knopf. */
.tactical-tweaks-panel VisualElement.ui-concepts-size-small {
    background-color: #2A2722; /* fest */
    border-radius: 8px;
}

/* Reiter im Taktik-Bildschirm des Spiels (Taktik, Standards, Elfmeter, Gegneranweisungen; Jonas 02.11.2026): SIs
   Reitergruppe lief als heller Streifen über die ganze Breite. Jetzt ein hängender Zettel, so breit wie die Reiter. */
#BindingExpect_TopBarTacticsButtonGroup ButtonGroup#ButtonGroup.buttongroup.largetabs {
    align-self: flex-start;
    background-color: rgba(0, 0, 0, 0); /* fest */
    border-width: 0;
    border-radius: 0;
    background-image: var(--bild-haengeblatt);
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.5;
    -unity-background-image-tint-color: #DCD7CB;
    margin-top: -14px;
    padding-top: 12px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 12px;
}

/* Weiße Symbole auf Papier: Kopfsymbole der Taktischen Effektivität, das weiße Verletzten-Plus (Kopf der
   Medizinischen Abteilung, Mitarbeiter-Kachel der Kaderplanung, Jonas 03.11.2026). In Tinte. */
.tactical-effectiveness-breakdown .tactic_icons-match, .tactical-effectiveness-breakdown .tactic_icons-buy-in-level,
.scaling-icons-condition-level-injured---white-size-small-16px, .scaling-icons-condition-level-injured---white-size-medium-24px,
.scaling-icons-condition-level-injured---white-size-large-32px {
    -unity-background-image-tint-color: #1C1A16;
}

/* Positionssymbol in der Kaderliste (Aufgestellt): weiß, auf grauen Feldern unsichtbar. Tinte. */
FMPitchPositionIcon#PositionIcon.pitch-position-icon-picked {
    -unity-background-image-tint-color: #1C1A16;
}
