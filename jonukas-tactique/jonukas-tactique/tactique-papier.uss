    --colours-tactics-base-60: #DAD7D0;
    --colours-tactics-base-80: #E8E6E1;
    --colours-feature-tactics-base-20: #837B67;
    --colours-feature-tactics-base-20-a16: #7D7C7829;
    --colours-feature-tactics-base-40: #A29A88;
    --colours-feature-tactics-base-50: #BFBAAE;
    --colours-feature-tactics-base-60: #DAD7D0;
    --colours-feature-tactics-base-80: #E8E6E1;
    --colours-tactics-teaminstruction-background: #BFBAAE;
    --visualiser-pitch-thematic-background: #BFBAAE;
    --interaction-tactics-surface-default: #A29A88;
    --interaction-tactics-surface-hover: #837B67;
}

