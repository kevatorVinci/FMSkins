/* OPTIONNEL - aspect "papier" des écrans tactiques (panneaux clairs, texte encre).
   Pas activé par défaut : sur l'interface de base, une partie des textes du jeu reste blanche
   et peut devenir illisible sur le papier. Pour l'essayer, ajoute "tactique-papier.uss" à la fin de "Sheets" dans skin.json. */

:root {
    --colours-tactics-defender-foreground: #039B8E;
    --colours-tactics-defensive-midfield-foreground: #12A359;
    --colours-tactics-midfield-foreground: #92BDF8;
    --colours-tactics-attacking-midfield-foreground: #DBA6F4;
    --colours-tactics-striker-foreground: #EF87CB;
    --colours-tactics-goalkeeper-foreground: #B5B5CD;
    --colours-tactics-phase-highlight-background: #1C1A161A;
    --colours-tactics-base-00: #147464;
    --colours-tactics-base-20: #188B78;
    --colours-tactics-base-40: #1FAD96;
    --colours-tactics-base-50: #25D1B5;
    --colours-tactics-base-60: #82E9D9;
    --colours-tactics-base-80: #B6F1E6;
    --colours-tactics-green-20: #1D5217;
    --colours-tactics-green-40: #1D5217;
    --colours-tactics-green-50: #46C638;
    --colours-tactics-green-60: #A7E4A0;
    --colours-tactics-green-80: #A7E4A0;
    --pitch-tile-default-background: #06B493;
    --colours-feature-tactics-base-20: #188B78;
    --colours-feature-tactics-base-20-a16: #188B7829;
    --colours-feature-tactics-base-40: #1FAD96;
    --colours-feature-tactics-base-50: #25D1B5;
    --colours-feature-tactics-base-60: #82E9D9;
    --colours-feature-tactics-base-80: #B6F1E6;
    --colours-tactics-defender-background: #009F92;
    --colours-tactics-defensive-midfield-background: #11AB00;
    --colours-tactics-midfield-background: #65A8FF;
    --colours-tactics-attacking-midfield-background: #D479FF;
    --colours-tactics-striker-background: #FF46BF;
    --colours-tactics-goalkeeper-background: #9C9481;
    --colours-tactics-tweak-pending: #0262E0;
    --colours-tactics-tweak-pending-background: #1874EC29;
    --colours-tactics-teaminstruction-background: #25D1B5;
    --tactics-visualiser-player-suitability-natural: #0D4507;
    --tactics-visualiser-player-suitability-accomplished: #283605;
    --tactics-visualiser-player-suitability-competent: #292F03;
    --tactics-visualiser-player-suitability-unconvincing: #403501;
    --tactics-visualiser-player-suitability-awkward: #8E4B04;
    --tactics-visualiser-player-suitability-makeshift: #B73905;
    --tactics-visualiser-player-suitability-poor: #D70303;
    --visualiser-pitch-accent-background: #1C1A1614;
    --visualiser-pitch-accent-border: #1C1A1659;
    --visualiser-pitch-accent-pitch-lines: #1C1A1629;
    --visualiser-pitch-default-border: #1C1A1659;
    --visualiser-pitch-default-background: #1C1A1600;
    --visualiser-pitch-default-pitch-lines: #1C1A1614;
    --visualiser-pitch-thematic-background: #25D1B5;
    --visualiser-pitch-thematic-pitch-lines: #1C1A1659;
    --visualiser-pitch-thematic-border: #1C1A16;
    --interaction-tactics-border-default: #1C1A1659;
    --interaction-tactics-surface-default: #1FAD96;
    --interaction-tactics-surface-disabled: #0D0E11A6;
    --interaction-tactics-surface-hover: #188B78;
}

